##
    global bool darkmode; darkmode = false;

    global string background_color = "rgb(225, 225, 225)";
    if(darkmode) {background_color = "rgb(28, 28, 28)";}

##
inlined background_theme {
    if(darkmode) {
        "background-color" : "rgb(28, 28, 28)";
    } else {
        "background-color" : "rgb(225, 225, 225)";
    }
}
inlined card_theme {
    if(darkmode) {
        "background-color" : "rgb(43, 43, 43)";
    } else {
        "background-color" : "rgb(247, 244, 244)";
    }
}
inlined banner_theme {
    "background-color" : "rgb(211, 211, 211)";
}
inlined component_theme {
    if(darkmode) {
        "background-color" : "rgb(52, 52, 52)";
    } else {
        "background-color" : "rgb(255, 249, 249)";
    }
}
inlined text_theme {
    "font-size" : "0.76rem";
    "font-weight" : "600";
    if(darkmode) {
        "color" : "rgb(247, 244, 244)";
    } else {
        "color" : "rgb(80,80,80)";
    }
    "font-family" : "system-ui, sans-serif";
}
inlined h1_theme {
    "font-size" : "1rem";
    "font-weight" : "700";
    if(darkmode) {
        "color" : "rgb(247, 244, 244)";
    } else {
        "color" : "rgb(80,80,80)";
    }
    "font-family" : "system-ui, sans-serif";
}

inlined input_theme {
    component_theme;
    "border-left" : "1px solid rgb(200,200,200)";
    "border-top" : "1px solid rgb(200,200,200)";
    "border-right" : "1px solid rgb(200,200,200)";
    "border-bottom" : "1px solid rgb(200,200,200)";
    "border-radius" : "8px";
    "padding" : "10px 14px";
    "width" : "100%";
    "font-size" : "15px";
    "font-family" : "system-ui, sans-serif";
}
inlined air_input_theme {
    "border" : "none";
    "border-bottom" : "2px solid rgb(200,200,200)";
    "border-radius" : "0px";
    "background-color" : "transparent";
    "padding" : "8px 0px";
    input_theme;
}
inlined form_input_theme {
    air_input_theme;
}
inlined form_sub_input_theme {
    "border" : "2px solid rgb(200,200,200)";
    air_input_theme;
}
inlined form_select_theme {
    component_theme;
    "border" : "1px solid rgb(200,200,200)";
    "border-radius" : "8px";
    "padding" : "8px 12px";
    "width" : "100%";
    "font-size" : "14px";
    "font-family" : "system-ui, sans-serif";
    "cursor" : "pointer";
    "appearance" : "none";
    "-webkit-appearance" : "none";
}


inlined hoverable_theme {
    "background-color" : transparent;
    "transition" : "background-color 0.15s ease";
    "onmouseenter" : "if(this.style.backgroundColor==='transparent')this.style.backgroundColor='rgba(0,0,0,0.04)'";
    "onmouseleave" : "if(this.style.backgroundColor==='rgba(0, 0, 0, 0.04)')this.style.backgroundColor='transparent'";
}
inlined skeleton_pulse {
    "background" : "linear-gradient(90deg, rgb(60,60,60) 25%, rgb(80,80,80) 50%, rgb(60,60,60) 75%)";
    "background-size" : "200% 100%";
    "animation" : "skeleton_pulse 1.5s infinite";
}

##
    Ptr Ptr votes;
    Ptr int tally_by_state;
    global bool votes_locked;
    global string guestid;

    global void sync_with_database() {
        if(!has_state) {
            guestid = get_cookie(current_request,"guestid");
            if(guestid.length==0) {
                guestid = generate_token;
                response.append("HTTP/1.1 200 OK\r\n");
                response.append("Content-Type: text/html\r\n");
                response.append("Set-Cookie: guestid="+guestid+"; path=/; SameSite=Lax\r\n");
            }
            Header& users = database["Users"];
            if(users.try_read_forever) {
                if(users.has(guestid)) {
                    Ptr& rbn = users[guestid];
                    votes = rbn["votes"];
                    Ptr locked_ptr = rbn["locked"];
                    votes_locked = *locked_ptr;
                } else {
                    votes = deadptr;
                }
                users.unlock;
            }
            if(!is_live(votes)) {
                if(users.try_lock_forever) {
                    Ptr& rbn = users.ribbonT(guestid) {
                        "votes", [Ptr] ;
                        "locked", [false] ;
                    };
                    votes = rbn["votes"];
                    Ptr locked_ptr = rbn["locked"];
                    votes_locked = *locked_ptr;
                    users.unlock;
                }
            }
            tally_by_state.clear;
            Ptr& bystate = database[0]["bystate"];
            for(int i=0;i<bystate.length;i++) {
                setsidx(bystate,i);
                Ptr& states = bystate[i];
                string state_label = bystate.celllabel;
                tally_by_state.put(state_label,states.length);
            }
            if(users.try_read_forever) {
                for(int i=0;i<votes.length;i++) {
                    ColCol& votepool = votes[i];
                    string race_label = votepool.label; 
                    string state_label = race_label.slice(0,race_label.find("-"));
                    if(tally_by_state.has(state_label)) {
                        int t = tally_by_state[state_label];
                        tally_by_state[state_label]=t-1;
                    }
                }
                users.unlock;
            }
        }
    }
    global string sync_with_client() {
        string js = "
            var vote_tally = {};
            var voted_for = {};
            var votes_locked = "+to_string(votes_locked)+";
        ";
        for(int i=0;i<votes.length;i++) {
            setsidx(votes,i);
            Ptr& vote = votes[i];
            js+="voted_for["+js_lit(votes.celllabel)+"] = "+js_lit(vote.label)+"; ";
        }
        for(int i=0;i<tally_by_state.length;i++) {
            setsidx(tally_by_state,i);
            string state_label = tally_by_state.celllabel;
            js+="vote_tally["+js_lit(state_label)+"] = "+to_string(tally_by_state[i])+"; ";
        }
        return js;
    }
    global int get_tally(string stateid) {
        if(tally_by_state.has(stateid)) {
            return tally_by_state[stateid];
        } else {
            return 0;
        }
    }
    global bool voted_in(string raceid) {
        return votes.has(raceid);
    }
    global Ptr get_vote(string raceid) {
        if(votes.has(raceid)) {
            return votes[raceid];
        } else {
            return deadptr;
        }
    }
    global void set_vote(string raceid, Ptr newvote) {
        if(votes.has(raceid)) {
            votes[raceid] = newvote;
        }
    }
    global string check_votes {
        sync_with_database;
        string to_return = "";
        for(int i=0;i<votes.length;i++){
            setsidx(votes,i);
            Ptr& v = votes[i];
            string ovlabel = v.label;
            string vlabel = votes.celllabel;
            to_return+=vlabel;
            to_return+=":";
            to_return+=ovlabel;
            if(i+1<votes.length) {
                to_return+="\n";
            }
        }
        return to_return;
    }

    global void cast_vote(Ptr candidate) {
        sync_with_database;
        if(!votes_locked) {
            ColCol& users = votes;
            Header& race = candidate;
            string rl = race.label;
            print("RL: ",rl);
            if(users.try_read_forever) {
                if(votes.has(rl)) {
                    votes[rl] = candidate;
                } else {
                    votes.put(rl,candidate);
                }
                users.unlock;
                database.save;
            }
        }
    }   

    global void lock_in_votes() {
        sync_with_database;
        if(guestid.length>0) {
            for(int i=0;i<votes.length;i++) {
                setsidx(votes,i);
                ColCol& race = votes[i];
                Ptr& candidate = votes[i];
                Ptr& tally = candidate["votes"];
                if(race.try_lock_forever) {
                    if(tally.has(guestid)) {} 
                    else {
                        tally.put(guestid,'T');
                    }
                    race.unlock;
                }
            }
            Header& users = database["Users"];
            if(users.try_read_forever) {
                Ptr rbn = users.ribbon(guestid);
                Ptr locked_ptr = rbn["locked"];
                votes_locked = !votes_locked;
                *locked_ptr = votes_locked;
                users.unlock;
            }
        }
    }

    global string color_of_party(string party_str) {
        if(party_str=="Republican") {
            return "rgb(210,60,60)";
        } else if(party_str=="Democrat") {
            return "rgb(60,100,200)";
        } else {
            return "gray";
        }
    }       
##

stateless template div render_race(Header& race, bool is_visible) { 
    div {
        "class" : "race_display";
        "id" : race.label;           
        Ptr rbns = race.ribbons;
        "display" : (is_visible?"flex":"none");
        "flex-direction" : "row";
        "gap" : "12px";
        "padding" : "12px";
        for(int i=0;i<rbns.length;i++) {
            setsidx(rbns,i);
            string candidate = rbns.celllabel;
            Ptr& rbn = rbns[i];
            Ptr& party = rbn["party"];
            string party_str = value_as_string(party);
            Ptr& image_t = rbn["image"];
            string image_str = value_as_string(image_t);
            string party_color = color_of_party(party_str);
            Ptr& outervotes = rbn["votes"];

            div {
                "data-candidate" : candidate;
                "data-mycolor" : party_color;
                "flex" : "1";
                "display" : "flex";
                "flex-direction" : "column";
                "align-items" : "center";
                "gap" : "8px";
                "padding" : "16px 12px";
                "border-radius" : "10px";
                "border-top" : "4px solid "+party_color;
                component_theme;
                "box-shadow" : "0 2px 8px rgba(0,0,0,0.08)";

                if(true) {
                    img {
                        "width" : "100px";
                        "height" : "150px";
                        "border-radius" : "4px";
                        "display" : "flex";
                        "align-items" : "center";
                        "justify-content" : "center";
                        "src" : image_str;
                    }
                } else {
                    div {
                        "width" : "56px";
                        "height" : "56px";
                        "border-radius" : "50%";
                        "background-color" : party_color;
                        "display" : "flex";
                        "align-items" : "center";
                        "justify-content" : "center";
                        text candidate.substr(0,1) {
                            "color" : "white";
                            "font-size" : "22px";
                            "font-weight" : "800";
                            "font-family" : "system-ui, sans-serif";
                        }
                    }
                }
                string points_str = value_as_string(rbn["points"])
                text candidate+" ("+points_str+")" {
                    "font-size" : "13px";
                    "font-weight" : "800";
                    "text-align" : "center";
                    "white-space" : "nowrap";
                    "overflow" : "hidden";
                    "text-overflow" : "ellipsis";
                    "width" : "100%";
                    text_theme;
                }
                div {
                    "padding" : "2px 10px";
                    "border-radius" : "12px";
                    "background-color" : party_color;
                    text party_str {
                        "color" : "white";
                        "font-size" : "11px";
                        "font-weight" : "600";
                        "font-family" : "system-ui, sans-serif";
                    }
                }

                button {
                    "border" : "none";
                    "border-radius" : "20px";
                    "padding" : "8px 20px";
                    "cursor" : "pointer";
                    "data-btncandidate" : candidate;

                    string racelabel = race.label;
                    Ptr myvote = get_vote(race.label);
                    if(is_live(myvote)) {
                        if(getidx(myvote)==getidx(rbn)) {
                            "background-color" : "gray";
                        } 
                    }
                    "background-color" : party_color;
                    "transition" : "opacity 0.15s ease";
                    "onmouseenter" : "this.style.opacity='0.85'";
                    "onmouseleave" : "this.style.opacity='1'";
                    text "VOTE" {
                        "id" : candidate+"_text";
                        "color" : "white";
                        "font-size" : "12px";
                        "font-weight" : "700";
                        "font-family" : "system-ui, sans-serif";
                    }

                    "onclick" : capture(
                        js_do("
                            event.stopPropagation();
                            if(votes_locked) return;
                            document.querySelectorAll('.race_display').forEach(race => {
                                const racelabel = "+js_lit(racelabel)+";
                                const candidate = "+js_lit(candidate)+";
                                if(race.id===racelabel) {
                                    const candidates = race.children;
                                    for(let i=0;i<candidates.length;i++) {
                                        const candidate_btn = candidates[i].children[3];
                                        if(candidates[i].dataset.candidate===candidate) {
                                            candidate_btn.style.backgroundColor = 'gray';
                                        } else {
                                            candidate_btn.style.backgroundColor = candidates[i].dataset.mycolor;
                                        }
                                    }

                                    const tally = getel("+js_lit(racelabel+"_tally")+");
                                    if(tally) {
                                        tally.style.backgroundColor = this.parentElement.dataset.mycolor;
                                        tally.children[1].innerText = candidate;
                                        tally.children[2].innerText = "+js_lit(points_str)+";
                                    }

                                    const race_state = racelabel.split('-')[0];
                                    if(!(racelabel in voted_for)) {
                                        t = vote_tally[race_state]-1;
                                        vote_tally[race_state] = t;
                                        if(t<=0) {
                                            getel(race_state).style.fill = 'white';
                                        }
                                        const mybadge = race.closest('.badge_expanded_view');
                                        if(mybadge) {
                                            mybadge.parentElement.children[1].children[0].innerText = t;
                                        } else {
                                            getel(race_state+'_badge').parentElement.children[1].children[0].innerText = t;
                                        }
                                        
                                        const races = race.closest('.races_display');
                                        if(races) {
                                            const tabs = races.children[0].children;
                                            var next_race_idx = -1;
                                            for(let i=0; i<tabs.length; i++) {
                                                var rlabel = tabs[i].dataset.racelabel;
                                                if(rlabel in voted_for) {
                                                    tabs[i].style.backgroundColor = 'gray';
                                                    tabs[i].style.borderBottomColor = 'transparent';
                                                } else if(rlabel==="+js_lit(racelabel)+") { 
                                                    tabs[i].style.backgroundColor = 'gray';
                                                    tabs[i].style.borderBottomColor = 'transparent';
                                                } else if(next_race_idx===-1) { //switch to the next active tab
                                                    tabs[i].style.borderBottomColor = 'rgb(172,57,147)';
                                                    next_race_idx = i;
                                                }
                                            }
                                            if(next_race_idx!==-1) { //then this switches to the next active race
                                                const race_displays = races.children[1].children;
                                                for(let i=0; i<race_displays.length; i++) {
                                                    race_displays[i].style.display = (i===next_race_idx) ? 'flex' : 'none';
                                                }
                                            }
                                        }
                                    }
                                    voted_for[racelabel] = candidate;
                                }
                            });
                        "),
                        string frbn ; js_lit(capture_ptr(rbn))
                    ){
                        cast_vote(retrive_ptr(frbn));
                    }
                }
            }
        }
    }
}

stateless template div render_races(Ptr& races) {
    div {
        "class" : "races_display";
        "border-radius" : "12px";
        "overflow" : "hidden";
        "box-shadow" : "0 4px 16px rgba(0,0,0,0.12)";
        card_theme;

        int first_viable_race = 0; first_viable_race = first_viable_race-1; //Because just -1 is broken for some reason
        div {
            "display" : "flex";
            "flex-direction" : "row";
            "border-bottom" : "1px solid rgba(0,0,0,0.08)";

            for(int s=0;s<races.length;s++) {
                setsidx(races,s);
                Header& race = races[s];
                if(!voted_in(race.label)&&first_viable_race<0) {
                    first_viable_race = s;
                }
            }

            for(int s=0;s<races.length;s++) {
                setsidx(races,s);
                string race_kind = races.celllabel; 
                Header& race = races[s];
                button {
                    "class" : "race_tab";
                    "border-left" : "none";
                    "border-top" : "none";
                    "border-right" : "none";
                    "border-bottom" : (s==first_viable_race?"2px solid rgb(172,57,147)":"2px solid transparent");
                    "border-radius" : "0";
                    "padding" : "10px 16px";
                    "cursor" : "pointer";
                    "data-racelabel" : race.label;

                    text race_kind {
                        "font-size" : "13px";
                        "font-weight" : "700";
                        text_theme;
                    }

                    if(voted_in(race.label)) {
                        "background-color" : "gray";
                    } else {
                        "background-color" : "transparent";
                    }
                    "transition" : "border-color 0.15s ease";
                    "onmouseenter" : "
                        if(!("+js_lit(race.label)+" in voted_for)) {
                            this.style.borderBottomColor = 'rgb(172,57,147)';
                        }
                    ";
                    "onmouseleave" : "
                        if(this.parentElement.parentElement.children[1].children["+to_string(s)+"].style.display==='none') {
                            this.style.borderBottomColor='transparent';
                        }
                    ";
                    "onclick" : "
                        event.stopPropagation();
                        const tabs = this.parentElement.children;
                        const displays = this.parentElement.parentElement.children[1].children;
                        for(let i=0; i<tabs.length; i++) {
                            var rlabel = tabs[i].dataset.racelabel;
                            if(rlabel==="+js_lit(race.label)+") {
                                displays[i].style.display = 'flex';
                            } else {
                                displays[i].style.display = 'none';
                                if(rlabel in voted_for) {
                                    tabs[i].style.backgroundColor = 'gray';
                                }
                                tabs[i].style.borderBottomColor = 'transparent';
                            }
                        }
                        this.style.borderBottomColor = 'rgb(172,57,147)';
                    ";
                }
            }
        }
        div {
            for(int s=0;s<races.length;s++) {
                Header& race = races[s];
                render_race(race,s==first_viable_race);
            }
        }
    }
}

div top_bar(string on_route) {
    div main_bar {
        "display" : "flex";
        "flex-direction" : "row";
        "align-items" : "center";
        "justify-content" : "space-between";
        "padding" : "16px 32px";
        "background-color" : "white";
        "border-bottom" : "1px solid rgb(197,197,197)";
        "width" : "100%";

        div {
            "display" : "flex";
            "flex-direction" : "column";
            "gap" : "2px";
            text "election madness" {
                "id" : "title_text";
                "font-size" : "2.2rem";
                "font-weight" : "700";
                "color" : "rgb(48,48,48)";
                "cursor" : "pointer";
                "onclick" : "window.location.href='/'";
                text_theme;
            }
            text "predict elections, beat your friends and beat the experts" {
                "font-size" : "1rem";
                "color" : "rgb(117,117,117)";
                text_theme;
            }
        }

        div navlinks {
            "display" : "flex";
            "flex-direction" : "row";
            "gap" : "24px";
            "align-items" : "center";
            "overflow-y" : "hidden";
            "transition" : "height 0.6s ease";

            stateless template div nav_link(string label, string route) {
                text label {
                    "font-size" : "1rem";
                    "font-weight" : (on_route==route?"700":"500");
                    "color" : (on_route==route?"rgb(18,121,190)":"rgb(48,48,48)");
                    "cursor" : "pointer";
                    "text-decoration" : (on_route==route?"underline":"none");
                    "onclick" : "window.location.href="+js_lit(route);
                    text_theme;
                }
            }

            nav_link("faqs","/faqs");
            nav_link("student resources","/student_resources");
            nav_link("instructor resources","/instructor_resources");
            nav_link("contact","/contacts");
        }

        button {
            "display" : "none";
            "border" : "none";
            "background-color" : "light gray";
            "border-radius" : "12px";
            "width" : "20%";
            text "v" {"margin" : "5px"; text_theme;}
            "onclick" : "
                const nav = this.parentElement.children[1];
                if(nav.style.height === '0px') {
                    nav.style.height = nav.scrollHeight + 'px';
                    this.children[0].innerText = '^';
                } else {
                    nav.style.height = '0px';
                    this.children[0].innerText = 'v';
                }
            ";
        }
    }
    script "
        function update_nav() {
            const bar = getel("+js_lit(capture_node(main_bar))+");
            if(window.innerWidth <= 980) {
                bar.style.flexDirection = 'column';
                bar.children[1].style.flexDirection = 'column';
                bar.children[1].style.height = '0px';
                bar.children[2].style.display = 'block';
            } else {
                bar.style.flexDirection = 'row';
                bar.children[1].style.flexDirection = 'row';
                bar.children[1].style.height = 'auto';
                bar.children[2].style.display = 'none';
            }
        }
        window.addEventListener('resize', update_nav);
        update_nav();
    ";
}

##
    register root_path;
    "root_path" {
        in htmlemiting {
            subemit("body",false,"","");
        }
    }
##

void standard_header {
    html '<meta name="viewport" content="width=device-width, initial-scale=1">';
    style "
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        html { font-size: 17px; }
        @media (min-width: 560px) {
            html { font-size: 20px; }
        }
        @keyframes skeleton_pulse { 0% { background-position: 200% 0; } 100% { background-position: -200% 0; } }
    ";
    script read_file("web/webcorn.js");
}

root_path {
    standard_header;
    sync_with_database;
    script sync_with_client();
    top_bar("/root");
    div {
        "display" : "flex";
        "justify-content" : "center";
        div {
            "display" : "flex";
            "flex-direction" : "column";
            "gap" : "10px";
            "width" : "95%";

            text "you found it. make your picks." {
                "margin" : "4px";
                "margin-top" : "24px";
                "margin-bottom" : "12px";
                "font-weight" : "600";
                "font-size" : "1.8rem";
                "text-align" : "center";
                text_theme;
            }

            div {
                "display" : "flex";
                "flex-direction" : "row";
                text "instructions:" {
                    "margin" : "4px";
                    "font-weight" : "900";
                    "font-size" : "1rem";
                    text_theme;
                }
                text "pick the winners of 24 elections. that's it." {
                    "margin" : "4px";
                    "font-size" : "1rem";
                    text_theme;
                }
            }
            text "players will earn the # of points next to each winning candidate they pick. Candidate points are based on candidate odds. Upset picks are worth more points than favorites. Players earn no points for picking a losing candidate. Whoever gets the most points wins. It's that easy. Can you beat your friends and our experts?" {
                "margin" : "4px";
                text_theme;
            }
            text "players will submit their official picks here between 10/23-10/30 by 5PM EST." {
                "color" : "red";
                "margin" : "4px";
                text_theme;
            }
        }
    }

    div {
        "height" : "60vh";
        "overflow-y" : "scroll";
        "scroll-snap-type" : "y mandatory";
        "display" : "flex";
        "justify-content" : "center";
        div map_viewport {
            "display" : "flex";
            "width" : "85%";
            "border-radius" : "12px";
            "min-height" : "60vh";
            "background-color" : "rgb(40, 40, 40)";
            "overflow" : "hidden";
            "position" : "relative";
            "cursor" : "grab";
            
            stateless template div clickable_state(string myid) {
                if(get_tally(myid)>0) {
                    "fill" : "rgb(190, 109, 236)";
                } else {
                    "fill" : "white";
                }
            }

            svg {
                "viewBox" : "0 0 1000 589";
                "id" : "mapsvg";
                "style" : "position:absolute;top:0;left:0;width:100%;height:100%;stroke-linejoin:round;stroke:#000;fill:none;";

                ColCol& map_data = database["Map"];
                for(int i=0;i<map_data.length;i++) {
                    string mapel = map_data[i];
                    g {
                        clickable_state(mapel.label);
                        path {
                            "id" : mapel.label;
                            "d" : mapel;
                            "stroke-width" : "0.97063118000000004";
                        }
                    }
                }
            }

            script "
                const svg = getel("+js_lit(capture_node(map_viewport))+").children[0];
                let isPanning = false;
                let startX, startY, offsetX = 0, offsetY = 0;

                let scale = 1.0;
                const BASE_W = 1000, BASE_H = 589;

                function updateViewBox() {
                    const w = BASE_W / scale;
                    const h = BASE_H / scale;
                    svg.setAttribute('viewBox', `${-offsetX} ${-offsetY} ${w} ${h}`);
                    update_all_transforms();
                }
                
                (function() {
                    const el = getel("+js_lit(capture_node(map_viewport))+");

                    el.addEventListener('mouseleave', () => { isPanning = false; el.style.cursor = 'grab'; });


                    let isZooming = false;
                    let zoomStartY;

                    el.addEventListener('mousedown', e => {
                        if(e.button === 0) {
                            isPanning = true;
                            el.style.cursor = 'grabbing';
                            startX = e.clientX - offsetX;
                            startY = e.clientY - offsetY;
                        } else if(e.button === 1) {
                            e.preventDefault();
                            isZooming = true;
                            zoomStartY = e.clientY;
                        }
                    });
                    el.addEventListener('mouseup', e => { 
                        isPanning = false; 
                        isZooming = false;
                        el.style.cursor = 'grab'; 
                    });
                    el.addEventListener('mousemove', e => {
                        if(isPanning) {
                            offsetX = e.clientX - startX;
                            offsetY = e.clientY - startY;
                            updateViewBox();
                        } else if(isZooming) {
                            const dy = zoomStartY - e.clientY;
                            zoomStartY = e.clientY;
                            const delta = dy > 0 ? 1.02 : 0.98;
                            const newScale = Math.max(1.0, Math.min(8.0, scale * delta));
                            const oldW = BASE_W / scale;
                            const oldH = BASE_H / scale;
                            const newW = BASE_W / newScale;
                            const newH = BASE_H / newScale;
                            const centerX = -offsetX + oldW / 2;
                            const centerY = -offsetY + oldH / 2;
                            offsetX = -(centerX - newW / 2);
                            offsetY = -(centerY - newH / 2);
                            scale = newScale;
                            updateViewBox();
                        }
                    });

                    let lastTouchDist = null;
                    let touchStartX, touchStartY;

                    el.addEventListener('touchstart', e => {
                        if(e.touches.length === 1) {
                            isPanning = true;
                            startX = e.touches[0].clientX - offsetX;
                            startY = e.touches[0].clientY - offsetY;
                        } else if(e.touches.length === 2) {
                            isPanning = false;
                            lastTouchDist = Math.hypot(
                                e.touches[0].clientX - e.touches[1].clientX,
                                e.touches[0].clientY - e.touches[1].clientY
                            );
                        }
                    });
                    el.addEventListener('touchmove', e => {
                        e.preventDefault();
                        if(e.touches.length === 1 && isPanning) {
                            offsetX = e.touches[0].clientX - startX;
                            offsetY = e.touches[0].clientY - startY;
                            updateViewBox();
                        } else if(e.touches.length === 2) {
                            const dist = Math.hypot(
                                e.touches[0].clientX - e.touches[1].clientX,
                                e.touches[0].clientY - e.touches[1].clientY
                            );
                            if(lastTouchDist) {
                                scale = Math.max(1.0, Math.min(8.0, scale * (dist / lastTouchDist)));
                            }
                            lastTouchDist = dist;
                            updateViewBox();
                        }
                    }, { passive: false });
                    el.addEventListener('touchend', () => { isPanning = false; lastTouchDist = null; });
                })();
            ";

            stateless template div make_badge(string stateid, Ptr races) {
                div {
                    string badgeid = stateid+"_badge";
                    "id" : badgeid;
                    "position" : "fixed";
                    "z-index" : "1";
                    div expanded_view {
                        "display" : "none";
                        "class" : "badge_expanded_view";
                        render_races(races);
                        "transition" : "opacity 0.3s ease, transform 0.5s ease";
                        "onclick" : "
                            this.style.display = 'none';
                            const badgeview = this.parentElement.children[1];
                            badgeview.style.display = 'flex';
                            badgeview.style.transform = 'scale(4)';
                            badgeview.style.opacity = '1';
                            this.parentElement.style.zIndex = '1';
                            setTimeout(() => {
                                badgeview.style.transform = 'scale(1)';
                                badgeview.style.opacity = '1';
                            }, 10);
                            update_all_transforms();
                        ";
                    } 
                    
                    div badge_view {
                        "display" : "flex";
                        "width" : "40px";
                        "height" : "40px";
                        "border-radius" : "8px";
                        "background" : "rgb(255, 255, 255)";
                        "align-items" : "center";
                        "justify-content" : "center";
                        "transition" : "opacity 0.3s ease, transform 0.5s ease";
                        string tally = to_string(get_tally(stateid));
                        text tally {
                            "id" : badgeid+"_text";
                            "color" : "black";
                            "font-size" : "11px";
                            "font-weight" : "700";
                            text_theme;
                        }
                        "onclick" : "
                            close_open_badge();
                            this.style.display = 'none';

                            const expandedview = this.parentElement.children[0];
                            expandedview.style.display = 'flex';
                            expandedview.style.transform = 'scale(0)';
                            expandedview.style.opacity = '0';
                            this.parentElement.style.zIndex = '100';
                            setTimeout(() => {
                                expandedview.style.transform = 'scale(1)';
                                expandedview.style.opacity = '1';
                            }, 10);
                            const nudge_interval = setInterval(() => {
                                const mrect = getel("+js_lit(capture_node(map_viewport))+").getBoundingClientRect();
                                const erect = expandedview.getBoundingClientRect();
                                let dx = 0, dy = 0;
                                if(erect.right > mrect.right) dx = -(erect.right - mrect.right + 16);
                                if(erect.bottom > mrect.bottom) dy = -(erect.bottom - mrect.bottom + 16);
                                if(erect.left < mrect.left) dx = -(erect.left - mrect.left - 16);
                                if(erect.top < mrect.top) dy = -(erect.top - mrect.top - 16);
                                if(dx !== 0 || dy !== 0) {
                                    offsetX += dx / scale;
                                    offsetY += dy / scale;
                                    updateViewBox();
                                }
                            }, 1);
                            setTimeout(() => clearInterval(nudge_interval), 500);
                            update_all_transforms();
                        ";
                    }
                    string badgescript = "
                        make_snap_root(getel("+js_lit(stateid)+"));
                        getel("+js_lit(stateid)+").addSnapChild(getel("+js_lit(badgeid)+"));
                        getel("+js_lit(badgeid)+").joint = function() {
                            const prect = this.snap_parent.getBoundingClientRect();
                            const badge = getel("+js_lit(badgeid)+");
                            getel("+js_lit(badgeid)+").style.left = (prect.left + prect.width/2 - badge.offsetWidth/2) + 'px';
                            getel("+js_lit(badgeid)+").style.top  = (prect.top  + prect.height/2 - badge.offsetHeight/2) + 'px';
                            return true;
                        };
                        update_all_transforms();
                        setTimeout(() => {
                            getel("+js_lit(badgeid)+").style.opacity = '1';
                            getel("+js_lit(badgeid)+").style.transform = 'scale(1)';
                        }, 80);
                    ";
                    script badgescript;
                }
            }

            div {
                "id" : "badges";
                Ptr& bystate = database[0]["bystate"];                 
                bystate = database[0]["bystate"];
                for(int i=0;i<bystate.length;i++) {
                    setsidx(bystate,i);
                    string stateid = bystate.celllabel;
                    if(get_tally(stateid)>0) {
                        make_badge(stateid,bystate[i]);
                    }
                }
            }
            script "
                function close_open_badge() {
                    const root = getel('badges');
                    Array.from(root.children).forEach(holder => {
                        const h_expanded = holder.children[0];
                        const h_badge = holder.children[1];
                        if(h_expanded.style.display==='flex') {
                            h_expanded.style.display='none';

                            h_badge.style.display='flex';
                            h_badge.style.transform = 'scale(4)';
                            h_badge.style.opacity = '1';
                            setTimeout(() => {
                                h_badge.style.transform = 'scale(1)';
                                h_badge.style.opacity = '1';
                            }, 10);
                        }
                    });
                }
            ";
        }


        div {
            "id" : "all_races_view";
            "background-color" : "rgb(40, 40, 40)";
            "position" : "fixed";
            "bottom" : "0";
            "left" : "0";
            "width" : "100%";
            "z-index" : "50";
            "display" : "flex";
            "flex-direction" : "column";

            div {
                "display" : "flex";
                "justify-content" : "center";
                "align-items" : "center";
                "height" : "5vh";
                "flex-shrink" : "0";
                "background-color" : "rgb(60,100,200)";
                "border-radius" : "12px 12px 0 0";
                "cursor" : "pointer";
                text "All Races ^" {"color" : "white"; "font-size" : "26px"; text_theme;}
                "onclick" : "
                    const drawer = this.parentElement.children[1];
                    if(drawer.style.height === '0px') {
                        drawer.style.height = '90vh';
                        this.children[0].innerText = 'All Races v';
                    } else {
                        drawer.style.height = '0px';
                        this.children[0].innerText = 'All Races ^';
                    }
                ";
            }

            div {
                "height" : "0px";
                "overflow-y" : "auto";
                "transition" : "height 0.5s ease";
                "background-color" : "rgb(40, 40, 40)";
                Ptr& all_races = database[0]["races"];
                div scrollable_races {
                    for(int i=0;i<all_races.length;i++) {
                        Header& race = all_races[i];
                        text race.label {
                            "color" : "white";
                            "font-size" : "18px";
                            "font-weight" : "800";
                            "text-align" : "center";
                            "width" : "100%";
                            "padding" : "16px 0px 8px 0px";
                            text_theme;
                        }
                        render_race(race,true);
                    }
                }
            }
        }
    }

    div {
        "height" : "100vh";
        "scroll-snap-align" : "start";
        "display" : "flex";
        "justify-content" : "center";
        "align-items" : "center";
        "padding" : "24px";

        div {
            "id" : "tally_board";
            "width" : "100%";
            "max-width" : "600px";
            "height" : "100%";
            "max-height" : "90vh";
            "display" : "flex";
            "flex-direction" : "column";
            "align-items" : "center";
            "gap" : "5px";
            "background-color" : "black";
            "border-radius" : "16px";
            "overflow-y" : "auto";
            "padding" : "24px";

            text "Votes" {
                "color" : "white";
                "font-size" : "32x";
                "font-weight" : "800";
                "text-align" : "center";
                "width" : "100%";
                "padding" : "16px 0px 8px 0px";
                text_theme; 
            }
            div tally_display {
                "width" : "100%";
                "height" : "100%";
                "display" : "flex";
                "flex-direction" : "column";
                "align-items" : "center";
                "gap" : "5px";
                "overflow-y" : "auto";
                Ptr& all_races = database[0]["races"];
                for(int s=0;s<all_races.length;s++) {
                    Header& race = all_races[s];
                    div {
                        "id" : race.label+"_tally";
                        "height" : "30px";
                        "width" : "75%";
                        "border-radius" : "10px";
                        "display" : "flex";
                        "align-items" : "center";
                        "justify-content" : "center";
                        "overflow" : "hidden";

                        script "votes_locked = "+to_string(votes_locked)+";";

                        if(votes_locked) {
                            Ptr& candidates = race.ribbons;
                            int vote_total = 0;
                            for(int i=0;i<candidates.length;i++) {
                                Ptr& vote = candidates[i];
                                Ptr& candidate_votes = vote["votes"];
                                int vote_count = candidate_votes.length;
                                vote_total=vote_total+vote_count;
                            }
                            for(int i=0;i<candidates.length;i++) {
                                div {
                                    "display" : "flex";
                                    "align-items" : "center";
                                    "justify-content" : "center";
                                    "height" : "100%";
                                    Ptr& vote = candidates[i];
                                    Ptr& party = vote["party"];
                                    Ptr& candidate_votes = vote["votes"];
                                    int vote_count = candidate_votes.length;
                                    if(vote_count>0) {
                                        "width" : to_string(compute_percent(vote_total,vote_count))+"%";
                                        string party_str = value_as_string(party);
                                        string party_color = color_of_party(party_str);
                                        "background-color" : party_color;
                                        "transition" : "transform 1.3s ease";
                                        if(i==0) {
                                            "transform" : "translateX(-100%)";
                                        } else {
                                            "transform" : "translateX(100%)";
                                        }

                                        string candidate = vote.label;
                                        text candidate {
                                            "flex" : "1";
                                            "color" : "white";
                                            "font-size" : "14px";
                                            "font-weight" : "600";
                                            "padding-left" : (i==0?"12px":"0px");
                                            "padding-right" : (i==1?"12px":"0px");
                                            "text-align" : (i==1?"right":"left");
                                            text_theme;
                                        }
                                    } else {
                                        "width" : "0%";
                                    }
                                }
                            }       
                        } else {
                            Ptr& vote = get_vote(race.label);
                            string candidate = "";
                            string points = " ";
                            if(is_live(vote)) {
                                Ptr& party = vote["party"];
                                string party_str = value_as_string(party);
                                string party_color = color_of_party(party_str);
                                "background-color" : party_color;
                                candidate = vote.label;
                                points = value_as_string(vote["points"]);
                            } else {
                                "background-color" : "gray";
                            }

                            text candidate {
                                "flex" : "1";
                                "color" : "white";
                                "font-size" : "14px";
                                "font-weight" : "600";
                                "padding-left" : "12px";
                                text_theme;
                            }

                            text points {
                                "color" : "white";
                                "font-size" : "14px";
                                "font-weight" : "700";
                                "background-color" : "rgba(0,0,0,0.25)";
                                "height" : "100%";
                                "display" : "flex";
                                "align-items" : "center";
                                "padding" : "0 16px";
                                text_theme;
                            }
                        }
                    }
                }
                if(votes_locked) {
                    string animate_tallies_script = "
                        if(true) {
                            const tallies = getel("+js_lit(capture_node(tally_display))+");
                            Array.from(tallies.children).forEach((tally, i) => {
                                Array.from(tally.children).forEach((candidate, s) => {
                                    setTimeout(() => {
                                        candidate.style.transform = 'translateX(0%)';
                                    }, (i+1)*80);
                                });
                            });
                        }
                    ";
                    script animate_tallies_script;
                }
            }
            button {
                text "Lock in" {"color" : "white"; text_theme};
                "id" : "vote_lock_btn";
                "border" : "none";
                "background-color" : "gray";
                "padding" : "12px";
                "border-radius" : "8px";
                "onclick" : capture(
                    js_do("
                        const tallies = getel("+js_lit(capture_node(tally_display))+");
                        Array.from(tallies.children).forEach(tally => {
                            apply_theme(tally,"+js_lit(skeleton_pulse.emit)+");
                        });
                    ");
                ) {
                    lock_in_votes;
                    tally_display.reload;
                }
            }
        }
    }


    string capstr = capture{
        if(usubunits.length==1) {
            print("Snapshotting");
            snapshot_subunit(0,"savetest.gsu");
        }
        print(unit_time_precise,":");
        print(unit_info);
        ColColCol diffable = load_subunit("savetest.gsu");
        correct_loaded_ptrs(diffable);
        print("Diffable: ",capture_ptr(diffable));
        print(utypes[4].length," / ",diffable[4].length);
        diff_types(diffable);
    };
    string checkvotes = capture(
        string jsvotes ; js_do("
            let to_return = '';
            const entries = Object.entries(voted_for);
            for(let i=0; i<entries.length; i++) {
                const key = entries[i][0];
                const val = entries[i][1];
                to_return += key + ':' + val + (i+1<entries.length?'\\n':'');
            }
            return to_return;
        ");
    ){
        print("==Server Votes==\n",check_votes(),"\n==Client Votes==\n",jsvotes);
    };
    script "
        document.addEventListener('keydown', (e) => {
            if(e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA') return;
            if(e.key === 'm') {
                "+capstr+";
            }
            if(e.key === 'v') {
                "+checkvotes+";
            }
        });

        const personalities = {
            map_user: {
                think_time: () => 300 + Math.random() * 700,
                tab_delay: () => 400 + Math.random() * 300,
                vote_delay: () => 300 + Math.random() * 400,
                use_drawer: false,
            },
            mobile_user: {
                think_time: () => 500 + Math.random() * 1000,
                tab_delay: () => 600 + Math.random() * 500,
                vote_delay: () => 400 + Math.random() * 600,
                use_drawer: true,
            },
            speedrunner: {
                think_time: () => 50 + Math.random() * 50,
                tab_delay: () => 80 + Math.random() * 50,
                vote_delay: () => 60 + Math.random() * 40,
                use_drawer: true,
            },
            map_speedrunner: {
                think_time: () => 50 + Math.random() * 400,
                tab_delay: () => 80 + Math.random() * 100,
                vote_delay: () => 60 + Math.random() * 200,
                scroll_speed: () => 50 + Math.random() * 50,
                use_drawer: false,
            },
        };
        const keys = Object.keys(personalities);
        const my_personality = personalities[keys[Math.floor(Math.random() * keys.length)]];

        function simulate_user() {
            const states = Object.keys(vote_tally).filter(s => vote_tally[s] > 0);
            if(states.length === 0) {
                setTimeout(() => {
                    getel('tally_board').scrollIntoView({ behavior: 'smooth', block: 'end' });
                    getel('vote_lock_btn').click();
                    setTimeout(() => window.bot_done && window.bot_done(), 1000);
                }, 500);
                return;
            }

            if(my_personality.use_drawer) {
                const drawer_btn = getel('all_races_view').children[0];
                const drawer = getel('all_races_view').children[1];
                if(drawer.style.height === '0px') {
                    drawer_btn.click();
                }
                setTimeout(() => {
                    const all_displays = drawer.querySelectorAll('.race_display');
                    let display_idx = 0;
                    function do_drawer_race() {
                        if(display_idx < all_displays.length) {
                            const display = all_displays[display_idx];
                            display.scrollIntoView({ behavior: 'smooth', block: 'center' });
                            if(display.style.display !== 'none') {
                                const buttons = display.querySelectorAll('button[data-btncandidate]');
                                if(buttons.length > 0) {
                                    setTimeout(() => {
                                        buttons[Math.floor(Math.random() * buttons.length)].click();
                                    }, my_personality.vote_delay());
                                }
                            }
                            display_idx++;
                            setTimeout(do_drawer_race, my_personality.tab_delay());
                        } else {
                            drawer_btn.click();
                            setTimeout(simulate_user, my_personality.think_time());
                        }
                    }
                    do_drawer_race();
                }, my_personality.think_time());
            } else {
                const state = states[Math.floor(Math.random() * states.length)];
                const badge = getel(state+'_badge');
                const races = badge.querySelector('.races_display');
                const displays = races.children[1].children;
                if(badge) {
                    if(badge.children[0].style.display==='none') {
                        badge.children[1].click();
                    }
                    setTimeout(() => {
                        const tabs = badge.querySelectorAll('.race_tab');
                        let tab_idx = 0;
                        function do_tab() {
                            if(tab_idx < tabs.length) {
                                const tab = tabs[tab_idx];
                                tab.click();
                                const active_display = displays[tab_idx];
                                setTimeout(() => {
                                    const buttons = active_display.querySelectorAll('button[data-btncandidate]');
                                    if(buttons.length > 0) {
                                        buttons[Math.floor(Math.random() * buttons.length)].click();
                                    }
                                    tab_idx++;
                                    setTimeout(do_tab, my_personality.tab_delay());
                                }, my_personality.vote_delay());
                            } else {
                                badge.children[0].click();
                                setTimeout(simulate_user, my_personality.think_time());
                            }
                        }
                        do_tab();
                    }, my_personality.think_time());
                }
            }
        }
        //simulate_user();
    ";
}


