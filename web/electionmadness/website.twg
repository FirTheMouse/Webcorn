##
    global bool darkmode; darkmode = false;

    global string background_color = "rgb(225, 225, 225)";
    if(darkmode) {background_color = "rgb(28, 28, 28)";}

##
inlined background_theme {
    if(darkmode) {
        "background-color" : "rgb(28, 28, 28)";
    } else {
        "background-color" : "rgb(225, 225, 225)";
    }
}
inlined card_theme {
    if(darkmode) {
        "background-color" : "rgb(43, 43, 43)";
    } else {
        "background-color" : "rgb(247, 244, 244)";
    }
}
inlined banner_theme {
    "background-color" : "rgb(211, 211, 211)";
}
inlined component_theme {
    if(darkmode) {
        "background-color" : "rgb(52, 52, 52)";
    } else {
        "background-color" : "rgb(255, 249, 249)";
    }
}
inlined text_theme {
    "font-size" : "0.76rem";
    "font-weight" : "600";
    if(darkmode) {
        "color" : "rgb(247, 244, 244)";
    } else {
        "color" : "rgb(80,80,80)";
    }
    "font-family" : "system-ui, sans-serif";
}
inlined h1_theme {
    "font-size" : "1rem";
    "font-weight" : "700";
    if(darkmode) {
        "color" : "rgb(247, 244, 244)";
    } else {
        "color" : "rgb(80,80,80)";
    }
    "font-family" : "system-ui, sans-serif";
}

inlined input_theme {
    component_theme;
    "border-left" : "1px solid rgb(200,200,200)";
    "border-top" : "1px solid rgb(200,200,200)";
    "border-right" : "1px solid rgb(200,200,200)";
    "border-bottom" : "1px solid rgb(200,200,200)";
    "border-radius" : "8px";
    "padding" : "10px 14px";
    "width" : "100%";
    "font-size" : "15px";
    "font-family" : "system-ui, sans-serif";
}
inlined air_input_theme {
    "border" : "none";
    "border-bottom" : "2px solid rgb(200,200,200)";
    "border-radius" : "0px";
    "background-color" : "transparent";
    "padding" : "8px 0px";
    input_theme;
}
inlined form_input_theme {
    air_input_theme;
}
inlined form_sub_input_theme {
    "border" : "2px solid rgb(200,200,200)";
    air_input_theme;
}
inlined form_select_theme {
    component_theme;
    "border" : "1px solid rgb(200,200,200)";
    "border-radius" : "8px";
    "padding" : "8px 12px";
    "width" : "100%";
    "font-size" : "14px";
    "font-family" : "system-ui, sans-serif";
    "cursor" : "pointer";
    "appearance" : "none";
    "-webkit-appearance" : "none";
}


inlined hoverable_theme {
    "background-color" : transparent;
    "transition" : "background-color 0.15s ease";
    "onmouseenter" : "if(this.style.backgroundColor==='transparent')this.style.backgroundColor='rgba(0,0,0,0.04)'";
    "onmouseleave" : "if(this.style.backgroundColor==='rgba(0, 0, 0, 0.04)')this.style.backgroundColor='transparent'";
}
inlined skeleton_pulse {
    "background" : "linear-gradient(90deg, rgb(60,60,60) 25%, rgb(80,80,80) 50%, rgb(60,60,60) 75%)";
    "background-size" : "200% 100%";
    "animation" : "skeleton_pulse 1.5s infinite";
}

##
    Ptr int tally_by_state;
    global string guestid;
    global Object user;

    global void sync_user() {
        guestid = get_cookie(current_request,"guestid");
        ColCol users = database["Users"];
        users.try_read_forever_then {
            if(users.has(guestid)) {
                user = users[guestid];
            } else {
                user = deadptr;
            }
        }
    }

    global void sync_with_database() {
        if(!has_state) {
            guestid = get_cookie(current_request,"guestid");
            if(guestid.length==0) {
                guestid = generate_token;
                response.append("HTTP/1.1 200 OK\r\n");
                response.append("Content-Type: text/html\r\n");
                response.append("Set-Cookie: guestid="+guestid+"; path=/; SameSite=Lax\r\n");
            }
            ColCol users = database["Users"];
            users.try_read_forever_then {
                if(users.has(guestid)) {
                    user = users[guestid];
                } else {
                    user = deadptr;
                }
            }
            if(!is_live(user)) {
                users.try_lock_forever_then {
                    user = users.Object(
                        "votes": [Ptr];
                        "locked": false;
                    ).register(guestid);
                }
            }
            tally_by_state.clear;
            Ptr bystate = database[0]["bystate"];
            bystate.cells((state_label,states) => {
                tally_by_state.put(state_label,states.length);
            });
            users.try_read_forever_then {
                user.votes.cells((race_label,val) => {
                    string state_label = race_label.slice(0,race_label.find("-"));
                    if(tally_by_state.has(state_label)) {
                        int t = tally_by_state[state_label];
                        tally_by_state[state_label]=t-1;
                    }
                });
            }
        }
    }
    global string sync_with_client() {
        string js = "
            var vote_tally = {};
            var voted_for = {};
            var votes_locked = "+to_string(user.locked)+";
            var tb1 = "+to_string(user.?tb1)+";
            var tb2 = "+to_string(user.?tb2)+";

            function check_vote_finished() {
                if(tb1&&tb2) {
                    if(Object.values(vote_tally).every(t => t <= 0)) {
                        getel('lock_pane').style.display = 'none';
                    }
                }
            }
        ";
        user.votes.cells((race_label,candidate) => {
            js+="voted_for['"+js_lit(race_label)+"'] = "+js_lit(candidate.label)+"; ";
        });
        tally_by_state.cells((state_label,tally) => {
            js+="vote_tally['"+js_lit(state_label)+"'] = "+to_string(tally)+"; ";
        });
        return js;
    }
    global bool is_voting_finished() {
        if(!user.?tb1) {
            return false;
        }
        if(!user.?tb2) {
            return false;
        }
        for(int n=0;n<tally_by_state.length;n++) {
            if(tally_by_state[n]>0) {return false;}
        }   
        return true;
    }

    global int get_tally(string stateid) {
        if(tally_by_state.has(stateid)) {
            return tally_by_state[stateid];
        } else {
            return 0;
        }
    }
    global bool voted_in(string raceid) {
        return user.votes.has(raceid);
    }
    global Ptr get_vote(string raceid) {
        if(user.votes.has(raceid)) {
            return user.votes.get(raceid);
        } else {
            return deadptr;
        }
    }
    global string check_votes {
        sync_with_database;
        string to_return = "";
        user.votes.cells((race_label,candidate) => {
            to_return+=race_label;
            to_return+=":";
            string candidate_name = candidate.label;
            to_return+=candidate_name;
            to_return+="\n";
        });
        return to_return;
    }

    global void cast_vote(Ptr candidate) {
        sync_with_database;
        if(!user.locked) {
            ColCol users = user;
            ColCol race = candidate;
            string rl = race.label;
            if(users.try_read_forever) {
                user.votes.getOrPut(rl) = candidate;
                users.unlock;
                database.save;
            }
        }
    }   

    global void lock_in_votes() {
        sync_with_database;
        if(guestid.length>0) {
            user.votes.cells((race_label,candidate) => {
                ColCol race = candidate;
                Ptr tally = candidate.votes;
                race.try_lock_forever_then {
                    if(!(tally.has(guestid))) {
                        tally.put(guestid,'T');
                    }
                }
            });
            ColCol users = user;
            users.try_read_forever_then {
                user.locked = !(user.locked);
            }
        }
    }

    global string color_of_party(string party_str) {
        if(party_str=="Republican") {
            return "rgb(210,60,60)";
        } else if(party_str=="Democrat") {
            return "rgb(60,100,200)";
        } else {
            return "gray";
        }
    }       
##




##
    register login;
    "login" {
        in htmlemiting {
            subemit("body",false,"","");
        }
    }
##

login {
    div {
        style "
            td:hover {
                background-color:rgb(234, 234, 234);
            }
            input:focus {
                outline: none;
            }
            textarea:focus {
                outline: none;
            }

            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }
        ";

        script read_file("web/webcorn.js");
        background_theme;

        response.append("HTTP/1.1 200 OK\r\n");
        response.append("Content-Type: text/html\r\n");
        response.append("Cache-Control: no-store\r\n");
        sync_user;
        bool user_registered = false;
        if(is_live(user)) {
            user.as(ColCol).try_read_forever_then {
                user_registered = user.?password;
            }   
        }
        
        div {
            "display" : "flex";
            "min-height" : "100vh";
                div {
                    "flex" : "1";
                    "display" : "flex";
                    "flex-direction" : "column";
                    "justify-content" : "center";
                    "align-items" : "center";
                        if(!is_live(user)) {
                            div {
                                "id" : "login_title";
                                "opacity" : "1";
                                "transition" : "opacity 0.6s ease, transform 0.8s ease";
                                "transform-origin" : "center bottom";
                                text "Election Madness" {"font-size" : "80px"; "font-weight" : "800"; text_theme;}
                                text "Made with TwigSnap" {"text-align" : "center"; "font-size" : "12px"; "font-weight" : "600"; text_theme;}
                                script "
                                    setTimeout(() => {
                                        const title = getel('login_title');
                                        const body = getel('login_body');
                                        title.style.opacity = '0';
                                        title.style.transform = 'scale(4)';
                                        setTimeout(() => {
                                            title.style.display = 'none';
                                            body.style.opacity = '1';
                                        }, 400);
                                        body.style.transition = 'opacity 0.4s ease';
                                    }, 800);
                                ";
                            }
                        }
                        div {
                            "id" : "login_body";
                            "opacity" : (is_live(user)?"100":"0");
                            "transition" : "opacity 0.4s ease";
                            "display" : "flex";
                            "justify-content" : "center";
                            "align-items" : "center";
                            "flex-direction" : "column";
                            "width" : "min(480px, 90vw)";
                            "height" : "auto";
                            "min-height" : "120px";
                            "padding" : "40px";
                            "gap" : "12px";
                            card_theme;
                            "border-radius" : "12px";
                            "box-shadow" : "0 4px 24px rgba(0,0,0,0.08)";

                            div login_buttons {
                                "display" : "flex";
                                "justify-content" : "center";
                                "align-items" : "center";
                                "flex-direction" : "column";
                                "width" : "100%";
                                "height" : "100%";
                                
                                
                                div {
                                    "display" : "flex";
                                    "width" : "100%";
                                    "padding" : "10px";
                                    "gap" : "12px";

                                    if(!user_registered) {
                                        string login_behaviour = capture(
                                            string given_username ; "getel('username').value",
                                            string given_password ; "getel('password').value"
                                        ) {
                                            Ptr sessions = database[0]["sessions"];
                                            string result = "";
                                            sessions.try_read_forever_then {
                                                if(sessions.has(given_username)) {
                                                    user = sessions[given_username];
                                                    if(user.password==secure_hash(given_password)) {
                                                        response.append("HTTP/1.1 200 OK\r\n");
                                                        response.append("Content-Type: text/html\r\n");
                                                        response.append("Set-Cookie: guestid="+(user.label)+"; path=/; SameSite=Lax\r\n");
                                                        emit_js("
                                                            window.location.href = "+(redirected_from.length==0?"'/'":js_lit(redirected_from))+";
                                                        ");
                                                    } else {
                                                        result = "Wrong password";
                                                    }
                                                } else {
                                                    result = "Username not found";
                                                }
                                            }
                                            if(result.length>0) {
                                                emit_js("
                                                    const btn = getel('login');
                                                    btn.children[0].innerText='"+result+"';
                                                    setTimeout(() => {
                                                        btn.children[0].innerText = 'Login';
                                                    }, 600);
                                                "); 
                                            }
                                        };

                                        string register_behaviour = capture(
                                            string given_username ; "getel('username').value",
                                            string given_password ; "getel('password').value"
                                        ) {
                                            Ptr sessions = database[0]["sessions"];
                                            bool username_avaliable = true;
                                            string result = "";
                                            sessions.try_read_forever_then {
                                                if(sessions.has(given_username)) {
                                                    username_avaliable = false;
                                                    result = "Username not avaliable";
                                                }
                                            }
                                            if(username_avaliable) {
                                                sync_with_database;
                                                ColCol userlock = user;
                                                string hashed_password = secure_hash(given_password);
                                                sessions.try_lock_forever_then {
                                                    if(sessions.has(given_username)) {
                                                        result = "Username not avaliable";
                                                    } else {
                                                        userlock.try_lock_forever_then {
                                                            if(user.?password) {
                                                                result = "Already registered";
                                                            } else {
                                                                user.password = hashed_password;
                                                                sessions.put(given_username, user);
                                                                result = "Registered";
                                                                emit_js("
                                                                    window.location.href = "+(redirected_from.length==0?"'/'":js_lit(redirected_from))+";
                                                                ");
                                                                database.save;
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                            emit_js("
                                                const btn = getel('login');
                                                btn.children[0].innerText='"+result+"';
                                                setTimeout(() => {
                                                    btn.children[0].innerText = 'Register';
                                                }, 600);
                                            "); 
                                        };
                                        
                                        script "
                                            function expand_login_card(card) {
                                                if(card.style.height === '0px') {
                                                    card.style.height = 'auto';
                                                    const h = card.scrollHeight;
                                                    card.style.height = '0px';
                                                    requestAnimationFrame(() => {
                                                        card.style.height = h + 'px';
                                                    });
                                                }
                                            }
                                            function toggle_login_card(new_label, is_login) {
                                                const card = getel('login_card');
                                                const btn = getel('login');
                                                btn.onclick = is_login ? function() { "+login_behaviour+" } : function() { "+register_behaviour+" };
                                                if(btn.children[0].innerText !== new_label) {
                                                    btn.children[0].innerText = new_label;
                                                    expand_login_card(card);
                                                } else {
                                                    if(card.style.height === '0px') {
                                                        expand_login_card(card);
                                                    } else {
                                                        card.style.height = '0px';
                                                    }
                                                }
                                            }
                                        ";
                                    }

                                    stateless template div loginbtn(string label, string behaviour) {
                                        button {
                                            "border" : "none";
                                            "border-radius" : "8px";
                                            "width" : "50%";
                                            "height" : "35px";
                                            "background-color" : "rgb(60,100,200)";
                                            text label {"margin" : "5px"; "color" : "white"; text_theme;}
                                            "onclick" : behaviour;
                                        }
                                    }
                                    
                                    if(user_registered) {
                                        loginbtn("Back",capture{
                                            emit_js("
                                                window.location.href = "+(redirected_from.length==0?"'/'":js_lit(redirected_from))+";
                                            ");
                                        });
                                        loginbtn("Logout",capture{
                                            response.append("HTTP/1.1 200 OK\r\n");
                                            response.append("Content-Type: text/html\r\n");
                                            response.append("Set-Cookie: guestid=; path=/; SameSite=Lax; Max-Age=0\r\n");
                                            user_registered = false;
                                            login_buttons.reload;
                                        });
                                    } else {
                                        loginbtn("Guest",capture{
                                            emit_js("
                                                window.location.href = "+(redirected_from.length==0?"'/'":js_lit(redirected_from))+";
                                            ");
                                        });
                                        loginbtn("Log In","toggle_login_card('Login',true);");
                                        loginbtn("Register","toggle_login_card('Register',false);");
                                    }
                                }
                                div {
                                    "width" : "100%";
                                    "display" : "flex";
                                    "flex-direction" : "column";
                                    "align-items" : "center";
                                    "gap" : "8px";
                                    div {
                                        "id" : "login_card";
                                        "display" : "flex";
                                        "justify-content" : "center";
                                        "align-items" : "end";
                                        "flex-direction" : "column";
                                        "height" : "0px";
                                        "overflow" : "hidden";
                                        "transition" : "height 0.5s ease";
                                        "gap" : "12px";
                                        
                                        inlined login_input_theme {
                                            "border-top" : "none";
                                            "border-left" : "none";
                                            "border-right" : "none";
                                            "border-bottom" : "2px solid rgb(200,200,200)";
                                            "border-radius" : "0px";
                                            "background-color" : "transparent";
                                            "padding" : "8px 0px";
                                            input_theme;
                                        }
        
                                        div {
                                            "display" : "flex";
                                            "align-items" : "center";
                                            "width" : "100%";
                                            "gap" : "7px";
                                                text "Username:" {
                                                    "width" : "70px";
                                                    "font-size" : "14px";
                                                    "flex-shrink" : "0";
                                                    text_theme;
                                                }
                                                input {
                                                    "id" : "username";
                                                    "flex" : "1";
                                                    login_input_theme;
                                                }
                                        }

                                        div {
                                            "display" : "flex";
                                            "align-items" : "center";
                                            "width" : "100%";
                                            "gap" : "8px";
                                                text "Password:" {
                                                    "width" : "70px";
                                                    "font-size" : "14px";
                                                    "flex-shrink" : "0";
                                                    text_theme;
                                                }
                                                input {
                                                    "id" : "password";
                                                    "type" : "password";
                                                    "flex" : "1";
                                                    login_input_theme;
                                                }
                                        }

                                        button {
                                            "id" : "login";
                                            text "Login" {
                                                "margin" : "5px";
                                                "font-size" : "14px";
                                                text_theme;
                                            }
                                            "width" : "75%";
                                            "border" : "none";
                                            "border-radius" : "4px";
                                            "background-color" : "rgb(230, 230, 230)";
                                        }
                                    }
                                }
                                if(!user_registered) {
                                    if(is_live(user)) {
                                        script "toggle_login_card('Register',false)";
                                    }
                                }
                            }
                        }
                }
        }
    }
    script "

        function type_into(el, text, callback) {
            let i = 0;
            function type_next() {
                if(i < text.length) {
                    el.value += text[i];
                    i++;
                    setTimeout(type_next, 40 + Math.random() * 80);
                } else {
                    callback && callback();
                }
            }
            type_next();
        }

        function simulate_user() {
            const buttons = getel('login_body').querySelectorAll('button');
            const logout_btn = Array.from(buttons).find(b => b.innerText.trim() === 'Logout');
            if(logout_btn) {
                setTimeout(() => {
                    logout_btn.click();
                    simulate_user();
                }, 600);
            } else {
                const username = 'bot_' + Math.random().toString(36).substr(2, 9);
                const password = Math.random().toString(36).substr(2, 12);
                setTimeout(() => {
                    if(getel('login_card').style.height === '0px') {
                        toggle_login_card('Register', false);
                    }
                    type_into(getel('username'), username, () => {
                        setTimeout(() => {
                            type_into(getel('password'), password, () => {
                                setTimeout(() => {
                                    getel('login').click();
                                }, 300);
                            });
                        }, 200);
                    });
                }, 600);
            }
        }
    ";
}

stateless template div render_race(Header& race, bool is_visible) { 
    div {
        "class" : "race_display";
        "id" : race.label;     
        Ptr rbns = race.ribbons;
        "display" : (is_visible?"flex":"none");
        "flex-direction" : "row";
        "gap" : "12px";
        "padding" : "12px";
        for(int i=0;i<rbns.length;i++) {
            setsidx(rbns,i);
            string candidate = rbns.celllabel;
            Ptr& rbn = rbns[i];
            Ptr& party = rbn["party"];
            string party_str = value_as_string(party);
            Ptr& image_t = rbn["image"];
            string image_str = value_as_string(image_t);
            string party_color = color_of_party(party_str);
            Ptr& outervotes = rbn["votes"];

            div {
                "data-candidate" : candidate;
                "data-mycolor" : party_color;
                "flex" : "1";
                "display" : "flex";
                "flex-direction" : "column";
                "align-items" : "center";
                "gap" : "8px";
                "padding" : "16px 12px";
                "border-radius" : "10px";
                "border-top" : "4px solid "+party_color;
                component_theme;
                "box-shadow" : "0 2px 8px rgba(0,0,0,0.08)";

                if(true) {
                    img {
                        "width" : "100px";
                        "height" : "150px";
                        "border-radius" : "4px";
                        "object-fit" : "cover";
                        "object-position" : "top";
                        "display" : "flex";
                        "align-items" : "center";
                        "justify-content" : "center";
                        "src" : image_str;
                    }
                } else {
                    div {
                        "width" : "56px";
                        "height" : "56px";
                        "border-radius" : "50%";
                        "background-color" : party_color;
                        "display" : "flex";
                        "align-items" : "center";
                        "justify-content" : "center";
                        text candidate.substr(0,1) {
                            "color" : "white";
                            "font-size" : "22px";
                            "font-weight" : "800";
                            "font-family" : "system-ui, sans-serif";
                        }
                    }
                }
                string points_str = value_as_string(rbn["points"])
                link candidate+" ("+points_str+")" {
                    "font-size" : "13px";
                    "font-weight" : "800";
                    "text-align" : "center";
                    "white-space" : "nowrap";
                    "overflow" : "hidden";
                    "text-overflow" : "ellipsis";
                    "width" : "100%";
                    "cursour" : "pointer";
                    "href" : value_as_string(rbn["link"]);
                    "target" : "_blank";
                    text_theme;
                }
                div {
                    "padding" : "2px 10px";
                    "border-radius" : "12px";
                    "background-color" : party_color;
                    text party_str {
                        "color" : "white";
                        "font-size" : "11px";
                        "font-weight" : "600";
                        "font-family" : "system-ui, sans-serif";
                    }
                }

                button {
                    "border" : "none";
                    "border-radius" : "20px";
                    "padding" : "8px 20px";
                    "cursor" : "pointer";
                    "data-btncandidate" : candidate;

                    string racelabel = race.label;
                    Ptr myvote = get_vote(race.label);
                    if(is_live(myvote)) {
                        if(getidx(myvote)==getidx(rbn)) {
                            "background-color" : "gray";
                        } 
                    }
                    "background-color" : party_color;
                    "transition" : "opacity 0.15s ease";
                    "onmouseenter" : "this.style.opacity='0.85'";
                    "onmouseleave" : "this.style.opacity='1'";
                    text "VOTE" {
                        "id" : candidate+"_text";
                        "color" : "white";
                        "font-size" : "12px";
                        "font-weight" : "700";
                        "font-family" : "system-ui, sans-serif";
                    }

                    "onclick" : capture(
                        js_do("
                            event.stopPropagation();
                            if(votes_locked) return;
                            document.querySelectorAll('.race_display').forEach(race => {
                                const racelabel = "+js_lit(racelabel)+";
                                const candidate = "+js_lit(candidate)+";
                                if(race.id===racelabel) {
                                    const candidates = race.children;
                                    for(let i=0;i<candidates.length;i++) {
                                        const candidate_btn = candidates[i].children[3];
                                        if(candidates[i].dataset.candidate===candidate) {
                                            candidate_btn.style.backgroundColor = 'gray';
                                        } else {
                                            candidate_btn.style.backgroundColor = candidates[i].dataset.mycolor;
                                        }
                                    }

                                    const tally = getel("+js_lit(racelabel+"_tally")+");
                                    if(tally) {
                                        tally.style.backgroundColor = this.parentElement.dataset.mycolor;
                                        tally.children[1].innerText = candidate;
                                        tally.children[2].innerText = "+js_lit(points_str)+";
                                    }

                                    const race_state = racelabel.split('-')[0];
                                    if(!(racelabel in voted_for)) {
                                        t = vote_tally[race_state]-1;
                                        vote_tally[race_state] = t;
                                        if(t<=0) {
                                            getel(race_state).style.fill = 'white';
                                            check_vote_finished();
                                        }
                                        const mybadge = race.closest('.badge_expanded_view');
                                        if(mybadge) {
                                            if(t==0) {
                                                close_open_badge();
                                                mybadge.parentElement.style.display = 'none';
                                            } else {
                                                mybadge.parentElement.children[1].children[0].innerText = t;
                                            }
                                        } else {
                                            getel(race_state+'_badge').parentElement.children[1].children[0].innerText = t;
                                        }
                                        
                                        const races = race.closest('.races_display');
                                        if(races) {
                                            const tabs = races.children[0].children;
                                            var next_race_idx = -1;
                                            for(let i=0; i<tabs.length; i++) {
                                                var rlabel = tabs[i].dataset.racelabel;
                                                if(rlabel in voted_for) {
                                                    tabs[i].style.backgroundColor = 'gray';
                                                    tabs[i].style.borderBottomColor = 'transparent';
                                                } else if(rlabel==="+js_lit(racelabel)+") { 
                                                    tabs[i].style.backgroundColor = 'gray';
                                                    tabs[i].style.borderBottomColor = 'transparent';
                                                } else if(next_race_idx===-1) { //switch to the next active tab
                                                    tabs[i].style.borderBottomColor = 'rgb(172,57,147)';
                                                    next_race_idx = i;
                                                }
                                            }
                                            console.log('Next active race ',next_race_idx);
                                            if(next_race_idx!==-1) { //then this switches to the next active race
                                                const race_displays = races.children[1].children;
                                                for(let i=0; i<race_displays.length; i++) {
                                                    race_displays[i].style.display = (i===next_race_idx) ? 'flex' : 'none';
                                                }
                                            }
                                        } else {
                                            console.log('No races found');
                                        }
                                    }
                                    voted_for[racelabel] = candidate;
                                }
                            });
                        "),
                        string frbn ; js_lit(capture_ptr(rbn))
                    ){
                        Ptr candidate_ptr = retrive_ptr(frbn);
                        database.adopt(candidate_ptr);
                        cast_vote(candidate_ptr);
                    }
                }
            }
        }
    }
}

stateless template div render_races(Ptr& races) {
    div {
        "class" : "races_display";
        "border-radius" : "12px";
        "overflow" : "hidden";
        "box-shadow" : "0 4px 16px rgba(0,0,0,0.12)";
        card_theme;

        int first_viable_race = -1;
        div {
            "display" : "flex";
            "flex-direction" : "row";
            "border-bottom" : "1px solid rgba(0,0,0,0.08)";

            for(int s=0;s<races.length;s++) {
                setsidx(races,s);
                Header& race = races[s];
                if((!voted_in(race.label))&&first_viable_race<0) {
                    first_viable_race = s;
                }
            }

            for(int s=0;s<races.length;s++) {
                setsidx(races,s);
                string race_kind = races.celllabel; 
                Header& race = races[s];
                button {
                    "class" : "race_tab";
                    "border-left" : "none";
                    "border-top" : "none";
                    "border-right" : "none";
                    "border-bottom" : (s==first_viable_race?"2px solid rgb(172,57,147)":"2px solid transparent");
                    "border-radius" : "0";
                    "padding" : "10px 16px";
                    "cursor" : "pointer";
                    "data-racelabel" : race.label;

                    text race_kind {
                        "font-size" : "13px";
                        "font-weight" : "700";
                        text_theme;
                    }

                    if(voted_in(race.label)) {
                        "background-color" : "gray";
                    } else {
                        "background-color" : "transparent";
                    }
                    "transition" : "border-color 0.15s ease";
                    "onmouseenter" : "
                        if(!("+js_lit(race.label)+" in voted_for)) {
                            this.style.borderBottomColor = 'rgb(172,57,147)';
                        }
                    ";
                    "onmouseleave" : "
                        if(this.parentElement.parentElement.children[1].children["+to_string(s)+"].style.display==='none') {
                            this.style.borderBottomColor='transparent';
                        }
                    ";
                    "onclick" : "
                        event.stopPropagation();
                        const tabs = this.parentElement.children;
                        const displays = this.parentElement.parentElement.children[1].children;
                        for(let i=0; i<tabs.length; i++) {
                            var rlabel = tabs[i].dataset.racelabel;
                            if(rlabel==="+js_lit(race.label)+") {
                                displays[i].style.display = 'flex';
                            } else {
                                displays[i].style.display = 'none';
                                if(rlabel in voted_for) {
                                    tabs[i].style.backgroundColor = 'gray';
                                }
                                tabs[i].style.borderBottomColor = 'transparent';
                            }
                        }
                        this.style.borderBottomColor = 'rgb(172,57,147)';
                    ";
                }
            }
        }
        div {
            for(int s=0;s<races.length;s++) {
                Header& race = races[s];
                render_race(race,s==first_viable_race);
            }
        }
    }
}

div top_bar(string on_route) {
    div main_bar {
        "display" : "flex";
        "flex-direction" : "row";
        "align-items" : "center";
        "justify-content" : "space-between";
        "padding" : "16px 32px";
        "background-color" : "white";
        "border-bottom" : "1px solid rgb(197,197,197)";
        "width" : "100%";

        div {
            "display" : "flex";
            "flex-direction" : "column";
            "gap" : "2px";
            text "election madness" {
                "id" : "title_text";
                "font-size" : "2.2rem";
                "font-weight" : "700";
                "color" : "rgb(48,48,48)";
                "cursor" : "pointer";
                "onclick" : "window.location.href='/'";
                text_theme;
            }
            text "predict elections, beat your friends and beat the experts" {
                "font-size" : "1rem";
                "color" : "rgb(117,117,117)";
                text_theme;
            }
        }

        div navlinks {
            "display" : "flex";
            "flex-direction" : "row";
            "gap" : "24px";
            "align-items" : "center";
            "overflow-y" : "hidden";
            "transition" : "height 0.6s ease";

            stateless template div nav_link(string label, string route) {
                link label {
                    "font-size" : "1rem";
                    "font-weight" : (on_route==route?"700":"500");
                    "color" : (on_route==route?"rgb(18,121,190)":"rgb(48,48,48)");
                    "cursor" : "pointer";
                    "text-decoration" : (on_route==route?"underline":"none");
                    "href" : route;
                    text_theme;
                }
            }

            nav_link("home","/");
            nav_link("faqs","/faqs");
            nav_link("student resources","/student_resources");
            nav_link("instructor resources","/instructor_resources");
            nav_link("contact","/contacts");
            nav_link("login","/login");
        }

        button {
            "display" : "none";
            "border" : "none";
            "background-color" : "light gray";
            "border-radius" : "12px";
            "width" : "20%";
            text "v" {"margin" : "5px"; text_theme;}
            "onclick" : "
                const nav = this.parentElement.children[1];
                if(nav.style.height === '0px') {
                    nav.style.height = nav.scrollHeight + 'px';
                    this.children[0].innerText = '^';
                } else {
                    nav.style.height = '0px';
                    this.children[0].innerText = 'v';
                }
            ";
        }
    }
    script "
        function update_nav() {
            const bar = getel("+js_lit(capture_node(main_bar))+");
            if(window.innerWidth <= 980) {
                bar.style.flexDirection = 'column';
                bar.children[1].style.flexDirection = 'column';
                bar.children[1].style.height = '0px';
                bar.children[2].style.display = 'block';
            } else {
                bar.style.flexDirection = 'row';
                bar.children[1].style.flexDirection = 'row';
                bar.children[1].style.height = 'auto';
                bar.children[2].style.display = 'none';
            }
        }
        window.addEventListener('resize', update_nav);
        update_nav();
    ";
}

##
    register root_path;
    "root_path" {
        in htmlemiting {
            subemit("body",false,"","");
        }
    }
##

void standard_header {
    html '<meta name="viewport" content="width=device-width, initial-scale=1">';
    style "
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        html { font-size: 17px; }
        @media (min-width: 560px) {
            html { font-size: 20px; }
        }
        @keyframes skeleton_pulse { 0% { background-position: 200% 0; } 100% { background-position: -200% 0; } }
    ";
    script read_file("web/webcorn.js");
}

root_path {
    standard_header;
    sync_with_database;
    script sync_with_client();
    top_bar("/");
    div {
        "display" : "flex";
        "justify-content" : "center";
        "id" : "instructions";
        div {
            "display" : "flex";
            "flex-direction" : "column";
            "gap" : "10px";
            "width" : "95%";

            text "you found it. make your picks." {
                "margin" : "4px";
                "margin-top" : "24px";
                "margin-bottom" : "12px";
                "font-weight" : "600";
                "font-size" : "1.8rem";
                "text-align" : "center";
                text_theme;
            }

            div {
                "display" : "flex";
                "flex-direction" : "row";
                text "instructions:" {
                    "margin" : "4px";
                    "font-weight" : "900";
                    "font-size" : "1rem";
                    text_theme;
                }
                text "pick the winners of 24 elections. that's it." {
                    "margin" : "4px";
                    "font-size" : "1rem";
                    text_theme;
                }
            }
            text "players will earn the # of points next to each winning candidate they pick. Candidate points are based on candidate odds. Upset picks are worth more points than favorites. Players earn no points for picking a losing candidate. Whoever gets the most points wins. It's that easy. Can you beat your friends and our experts?" {
                "margin" : "4px";
                text_theme;
            }
            text "players will submit their official picks here between 10/23-10/30 by 5PM EST." {
                "color" : "red";
                "margin" : "4px";
                text_theme;
            }
        }
    }


    div {
        "id" : "all_races_view";
        "background-color" : "rgb(40, 40, 40)";
        "position" : "fixed";
        "bottom" : "0";
        "left" : "0";
        "width" : "100%";
        "z-index" : "50";
        "display" : "flex";
        "flex-direction" : "column";

        div {
            "display" : "flex";
            "justify-content" : "center";
            "align-items" : "center";
            "height" : "5vh";
            "flex-shrink" : "0";
            "background-color" : "rgb(60,100,200)";
            "cursor" : "pointer";
            text "Map ^" {"color" : "white"; "font-size" : "26px"; text_theme;}
            "onclick" : "
                const drawer = this.parentElement.children[1];
                if(drawer.style.height === '0px') {
                    drawer.style.height = '90vh';
                    this.children[0].innerText = 'Map v';
                } else {
                    drawer.style.height = '0px';
                    this.children[0].innerText = 'Map ^';
                }

                drawer_interval = setInterval(() => {
                    update_all_transforms();
                }, 1);
                setTimeout(() => { clearInterval(drawer_interval);}, 500);
            ";
        }

        div {
            "height" : "0px";
            "width" : "100%";
            "overflow-y" : "auto";
            "transition" : "height 0.5s ease";
            "background-color" : "rgb(40, 40, 40)";
            div map_viewport {
                "display" : "flex";
                "width" : "100%";
                "height" : "100%";
                "overflow" : "hidden";
                "position" : "relative";
                "cursor" : "grab";
                
                stateless template div clickable_state(string myid) {
                    if(get_tally(myid)>0) {
                        "fill" : "rgb(190, 109, 236)";
                    } else {
                        "fill" : "white";
                    }
                }

                svg {
                    "viewBox" : "0 0 1000 589";
                    "id" : "mapsvg";
                    "style" : "position:absolute;top:0;left:0;width:100%;height:100%;stroke-linejoin:round;stroke:#000;fill:none;";

                    ColCol& map_data = database["Map"];
                    for(int i=0;i<map_data.length;i++) {
                        string mapel = map_data[i];
                        g {
                            clickable_state(mapel.label);
                            path {
                                "id" : mapel.label;
                                "d" : mapel;
                                "stroke-width" : "0.97063118000000004";
                            }
                        }
                    }
                }

                script "
                    const svg = getel("+js_lit(capture_node(map_viewport))+").children[0];
                    let isPanning = false;
                    let isExpanding = false;
                    let nudge_interval = null;
                    let startX, startY, offsetX = 0, offsetY = 0;

                    let scale = 1.0;
                    const BASE_W = 1000, BASE_H = 589;

                    function updateViewBox() {
                        const w = BASE_W / scale;
                        const h = BASE_H / scale;
                        svg.setAttribute('viewBox', `${-offsetX} ${-offsetY} ${w} ${h}`);
                        update_all_transforms();
                    }
                    
                    (function() {
                        const el = getel("+js_lit(capture_node(map_viewport))+");

                        el.addEventListener('mouseleave', () => { isPanning = false; el.style.cursor = 'grab'; });


                        let isZooming = false;
                        let zoomStartY;

                        el.addEventListener('mousedown', e => {
                            if(e.button === 0 && !isExpanding) {
                                isPanning = true;
                                el.style.cursor = 'grabbing';
                                startX = e.clientX - offsetX;
                                startY = e.clientY - offsetY;
                            } else if(e.button === 1 && !isExpanding) {
                                e.preventDefault();
                                isZooming = true;
                                zoomStartY = e.clientY;
                            }
                        });
                        el.addEventListener('mouseup', e => { 
                            isPanning = false; 
                            isZooming = false;
                            el.style.cursor = 'grab'; 
                        });
                        el.addEventListener('mousemove', e => {
                            if(isPanning && !isExpanding) {
                                offsetX = e.clientX - startX;
                                offsetY = e.clientY - startY;
                                updateViewBox();
                            } else if(isZooming && !isExpanding) {
                                const dy = zoomStartY - e.clientY;
                                zoomStartY = e.clientY;
                                const delta = dy > 0 ? 1.02 : 0.98;
                                const newScale = Math.max(1.0, Math.min(8.0, scale * delta));
                                const oldW = BASE_W / scale;
                                const oldH = BASE_H / scale;
                                const newW = BASE_W / newScale;
                                const newH = BASE_H / newScale;
                                const centerX = -offsetX + oldW / 2;
                                const centerY = -offsetY + oldH / 2;
                                offsetX = -(centerX - newW / 2);
                                offsetY = -(centerY - newH / 2);
                                scale = newScale;
                                updateViewBox();
                            }
                        });

                        let lastTouchDist = null;
                        let touchStartX, touchStartY;

                        el.addEventListener('touchstart', e => {
                            if(e.touches.length === 1 && !isExpanding) {
                                isPanning = true;
                                startX = e.touches[0].clientX - offsetX;
                                startY = e.touches[0].clientY - offsetY;
                            } else if(e.touches.length === 2 && !isExpanding) {
                                isPanning = false;
                                lastTouchDist = Math.hypot(
                                    e.touches[0].clientX - e.touches[1].clientX,
                                    e.touches[0].clientY - e.touches[1].clientY
                                );
                            }
                        });
                        el.addEventListener('touchmove', e => {
                            e.preventDefault();
                            if(e.touches.length === 1 && isPanning && !isExpanding) {
                                offsetX = e.touches[0].clientX - startX;
                                offsetY = e.touches[0].clientY - startY;
                                updateViewBox();
                            } else if(e.touches.length === 2 && !isExpanding) {
                                const dist = Math.hypot(
                                    e.touches[0].clientX - e.touches[1].clientX,
                                    e.touches[0].clientY - e.touches[1].clientY
                                );
                                if(lastTouchDist) {
                                    scale = Math.max(1.0, Math.min(8.0, scale * (dist / lastTouchDist)));
                                }
                                lastTouchDist = dist;
                                updateViewBox();
                            }
                        }, { passive: false });
                        el.addEventListener('touchend', () => { isPanning = false; lastTouchDist = null; });
                    })();
                ";

                stateless template div make_badge(string stateid, Ptr races) {
                    div {
                        string badgeid = stateid+"_badge";
                        "id" : badgeid;
                        "position" : "fixed";
                        "z-index" : "1";
                        div expanded_view {
                            "display" : "none";
                            "class" : "badge_expanded_view";
                            render_races(races);
                            "transition" : "opacity 0.3s ease, transform 0.5s ease";
                            "position" : "relative";
                            button {
                                "position" : "absolute";
                                "top" : "8px";
                                "right" : "8px";
                                "border" : "none";
                                "background" : "none";
                                "cursor" : "pointer";
                                text "x" {
                                    "font-size" : "0.8rem";
                                    "font-weight" : "500";
                                    "color" : "rgb(80,80,80)";
                                    text_theme;
                                }
                                "onclick" : "
                                    event.stopPropagation();
                                    const expanded = this.parentElement;
                                    expanded.style.display = 'none';
                                    const badgeview = expanded.parentElement.children[1];
                                    badgeview.style.display = 'flex';
                                    badgeview.style.transform = 'scale(4)';
                                    badgeview.style.opacity = '1';
                                    if(nudge_interval) { clearInterval(nudge_interval); nudge_interval = null; isExpanding = false; }
                                    expanded.parentElement.style.zIndex = '1';
                                    setTimeout(() => {
                                        badgeview.style.transform = 'scale(1)';
                                        badgeview.style.opacity = '1';
                                    }, 10);
                                    update_all_transforms();
                                ";
                            }
                        } 
                        
                        div badge_view {
                            "display" : "flex";
                            "width" : "40px";
                            "height" : "40px";
                            "border-radius" : "8px";
                            "background" : "rgb(255, 255, 255)";
                            "border" : "2px solid black";
                            "align-items" : "center";
                            "justify-content" : "center";
                            "transition" : "opacity 0.3s ease, transform 0.5s ease";
                            string tally = to_string(get_tally(stateid));
                            text tally {
                                "id" : badgeid+"_text";
                                "color" : "black";
                                "font-size" : "11px";
                                "font-weight" : "700";
                                text_theme;
                            }
                            "onclick" : "
                                close_open_badge();
                                this.style.display = 'none';

                                const expandedview = this.parentElement.children[0];
                                expandedview.style.display = 'flex';
                                expandedview.style.transform = 'scale(0)';
                                expandedview.style.opacity = '0';
                                this.parentElement.style.zIndex = '100';
                                setTimeout(() => {
                                    expandedview.style.transform = 'scale(1)';
                                    expandedview.style.opacity = '1';
                                }, 10);
                                isExpanding = true;
                                nudge_interval = setInterval(() => {
                                    const mrect = getel("+js_lit(capture_node(map_viewport))+").getBoundingClientRect();
                                    const erect = expandedview.getBoundingClientRect();
                                    let dx = 0, dy = 0;
                                    if(erect.right > mrect.right) dx = -(erect.right - mrect.right + 16);
                                    if(erect.bottom > mrect.bottom) dy = -(erect.bottom - mrect.bottom + 16);
                                    if(erect.left < mrect.left) dx = -(erect.left - mrect.left - 16);
                                    if(erect.top < mrect.top) dy = -(erect.top - mrect.top - 16);
                                    if(dx !== 0 || dy !== 0) {
                                        offsetX += dx / scale;
                                        offsetY += dy / scale;
                                        updateViewBox();
                                    }
                                }, 1);
                                setTimeout(() => { clearInterval(nudge_interval); isExpanding = false; }, 300);
                                update_all_transforms();
                            ";
                        }
                        string badgescript = "
                            make_snap_root(getel("+js_lit(stateid)+"));
                            getel("+js_lit(stateid)+").addSnapChild(getel("+js_lit(badgeid)+"));                        
                            getel("+js_lit(badgeid)+").joint = function() {
                                const prect = this.snap_parent.getBoundingClientRect();
                                const badge = getel("+js_lit(badgeid)+");
                                badge.style.left = (prect.left + prect.width/2 - badge.offsetWidth/2) + 'px';
                                badge.style.top  = (prect.top  + prect.height/2 - badge.offsetHeight/2) + 'px';
                                const mrect = getel("+js_lit(capture_node(map_viewport))+").getBoundingClientRect();
                                const cx = prect.left + prect.width/2;
                                const cy = prect.top + prect.height/2;
                                const inside = cx >= mrect.left && cx <= mrect.right && cy >= mrect.top && cy <= mrect.bottom;
                                badge.style.visibility = inside ? 'visible' : 'hidden';
                                return true;
                            };       
                            update_all_transforms();
                            setTimeout(() => {
                                getel("+js_lit(badgeid)+").style.opacity = '1';
                                getel("+js_lit(badgeid)+").style.transform = 'scale(1)';
                            }, 80);
                        ";
                        script badgescript;
                    }
                }

                div {
                    "id" : "badges";
                    Ptr& bystate = database[0]["bystate"];                 
                    bystate = database[0]["bystate"];
                    for(int i=0;i<bystate.length;i++) {
                        setsidx(bystate,i);
                        string stateid = bystate.celllabel;
                        if(get_tally(stateid)>0) {
                            make_badge(stateid,bystate[i]);
                        }
                    }
                }
                script "
                    function close_open_badge() {
                        const root = getel('badges');
                        Array.from(root.children).forEach(holder => {
                            const h_expanded = holder.children[0];
                            const h_badge = holder.children[1];
                            if(nudge_interval) { clearInterval(nudge_interval); nudge_interval = null; isExpanding = false; }
                            if(h_expanded.style.display==='flex') {
                                h_expanded.style.display='none';
                                holder.style.zIndex = '1';
                                h_badge.style.display='flex';
                                h_badge.style.transform = 'scale(4)';
                                h_badge.style.opacity = '1';
                                setTimeout(() => {
                                    h_badge.style.transform = 'scale(1)';
                                    h_badge.style.opacity = '1';
                                }, 10);
                            }
                        });
                    }
                ";
            }
        }
    }



    div {
        "display" : "flex";
        "flex-direction" : "column";
        "align-items" : "center";
        "justify-content" : "center";
        "width" : "100%";
        button {
            text " v " {"font-size" : "1rem"; text_theme;}
            "border" : "none";
            "background-color" : "light gray";
            "border-radius" : "12px";
            "width" : "20%";
            "height" : "30px";
            "cursor" : "pointer";
            "onclick" : "getel('tally_board').scrollIntoView({ behavior: 'smooth', block: 'center' });";
        }
        Ptr& all_races = database[0]["races"];
        div {
            inlined race_header_theme {
                "color" : "rgb(52, 52, 52)";
                "font-size" : "1rem";
                "font-weight" : "800";
                "text-align" : "center";
                "width" : "100%";
                "padding" : "16px 0px 8px 0px";
                text_theme;
            }

            "id" : "scrollable_races";
            //"background-color" : "rgb(40, 40, 40)";
            "width" : "100%";
            "max-width" : "900px";
            for(int i=0;i<all_races.length;i++) {
                Header race = all_races[i];
                text race.label {
                    "id" : (race.label)+"_scroll_label";
                    "onclick" : "
                        const el = getel("+js_lit(race.label+"_tally")+");
                        if(el) el.scrollIntoView({ behavior: 'smooth', block: 'center' });
                    ";
                    "cursor" : "pointer";
                    race_header_theme;
                }
                render_race(race,true);
            }

            text "Tiebreaker 1" {
                race_header_theme;
            }
            div {
                "display" : "flex";
                "flex-direction" : "column";
                "justify-content" : "center";
                "align-items" : "center";
                "border-radius" : "12px";
                "box-shadow" : "0 2px 8px rgba(0,0,0,0.08)";
                "padding" : "12px";
                component_theme;
                text "Pick the election with the LARGEST margin between the 1st and 2nd place finishers from the 24 contests in the game." {text_theme;}
                select {
                    "width" : "80%";
                    "margin" : "8px";
                    "background-color" : "white";
                    "text-align" : "center";
                    form_select_theme;
                    string current = "";
                    database["Users"].try_read_forever_then {
                        if(user.?tb1) {
                            current = user.tb1;
                        }
                    }
                    for(int i=0;i<all_races.length;i++) {
                        Header race = all_races[i];
                        option race.label {
                            "value" : race.label;
                            if((race.label)==current) {
                                "selected" : "true";
                            }
                        }
                    }
                    "onchange" : capture(js_do("tb1 = true; check_vote_finished();"), string myval ; "this.value") {
                        sync_with_database;
                        database["Users"].try_lock_forever_then {
                            user.tb1 = myval;
                        }
                        database.save;
                    }
                }
            }

            text "Tiebreaker 2" {
                race_header_theme;
            }
            div {
                "display" : "flex";
                "flex-direction" : "column";
                "justify-content" : "center";
                "align-items" : "center";
                "border-radius" : "12px";
                "box-shadow" : "0 2px 8px rgba(0,0,0,0.08)";
                "padding" : "12px";
                component_theme;
                string current = "50";
                database["Users"].try_read_forever_then {
                    if(user.?tb2) {
                        current = user.tb2;
                    }
                }
                div {
                    "display" : "flex";
                    "align-items" : "center";
                    "gap" : "8px";
                    text "What % will the Republican candidate in the Texas Senate race receive?" {text_theme;}
                    div {
                        "background-color" : "rgb(220,220,220)";
                        "border-radius" : "6px";
                        "padding" : "2px 8px";
                        text current+"%" {
                            "id" : "tb2_display";
                            "font-size" : "13px";
                            "font-weight" : "700";
                            text_theme;
                        }
                    }
                }
                input {
                    "margin" : "8px";
                    "type" : "range";
                    "min" : "0";
                    "max" : "100";
                    "step" : "1";
                    "value" : current;
                    "onchange" : capture(js_do("tb2 = true; check_vote_finished();"), string myval ; "this.value") {
                        sync_with_database;
                        database["Users"].try_lock_forever_then {
                            user.tb2 = myval;
                        }
                        database.save;
                    }
                    "oninput" : "getel('tb2_display').innerText = this.value + '%'";
                }
            }
        }
    }


    div tally_board_holder {
        "min-height" : "100vh";
        "scroll-snap-align" : "start";
        "display" : "flex";
        "flex-direction" : "column";
        "justify-content" : "center";
        "align-items" : "center";
        "padding" : "24px";

        button {
            text " ^ " {"font-size" : "1rem"; text_theme;}
            "border" : "none";
            "background-color" : "light gray";
            "border-radius" : "12px 12px 0 0";
            "width" : "20%";
            "height" : "30px";
            "cursor" : "pointer";
            "onclick" : "getel('instructions').scrollIntoView({ behavior: 'smooth', block: 'center' });";
        }
        

        div {
            "id" : "tally_board";
            "position" : "relative"
            "width" : "100%";
            "max-width" : "800px";
            "height" : "100%";
            "max-height" : "120vh";
            "display" : "flex";
            "flex-direction" : "column";
            "align-items" : "center";
            "gap" : "5px";
            "background-color" : "black";
            "border-radius" : "16px";
            "overflow-y" : "auto";
            "padding" : "24px";
            text "Votes" {
                "color" : "white";
                "font-size" : "32px";
                "font-weight" : "800";
                "text-align" : "center";
                "width" : "100%";
                "padding" : "16px 0px 8px 0px";
                text_theme; 
            }
            div tally_display {
                "width" : "100%";
                "height" : "100%";
                "display" : "flex";
                "flex-direction" : "column";
                "align-items" : "center";
                "gap" : "5px";
                "overflow-y" : "auto";
                Ptr& all_races = database[0]["races"];
                for(int s=0;s<all_races.length;s++) {
                    Header& race = all_races[s];
                    div {
                        "id" : race.label+"_tally";
                        "height" : "55px";
                        "width" : "90%";
                        "border-radius" : "10px";
                        "display" : "flex";
                        "align-items" : "center";
                        "justify-content" : "center";
                        "overflow" : "hidden";

                        "cursor" : "pointer";
                        "onclick" : "
                            const el = getel("+js_lit(race.label)+"+'_scroll_label');
                            if(el) {el.scrollIntoView({ behavior: 'smooth', block: 'start' });}
                        ";

                        script "votes_locked = "+to_string(user.locked)+";";

                        if(user.locked) {
                            Ptr& candidates = race.ribbons;
                            int vote_total = 0;
                            for(int i=0;i<candidates.length;i++) {
                                Ptr& vote = candidates[i];
                                Ptr& candidate_votes = vote["votes"];
                                int vote_count = candidate_votes.length;
                                vote_total=vote_total+vote_count;
                            }
                            for(int i=0;i<candidates.length;i++) {
                                div {
                                    "display" : "flex";
                                    "align-items" : "center";
                                    "justify-content" : "center";
                                    "height" : "100%";
                                    Ptr& vote = candidates[i];
                                    Ptr& party = vote["party"];
                                    Ptr& candidate_votes = vote["votes"];
                                    int vote_count = candidate_votes.length;
                                    if(vote_count>0) {
                                        "width" : to_string(compute_percent(vote_total,vote_count))+"%";
                                        string party_str = value_as_string(party);
                                        string party_color = color_of_party(party_str);
                                        "background-color" : party_color;
                                        "transition" : "transform 1.3s ease";
                                        if(i==0) {
                                            "transform" : "translateX(-100%)";
                                        } else {
                                            "transform" : "translateX(100%)";
                                        }

                                        string candidate = vote.label;
                                        text candidate {
                                            "flex" : "1";
                                            "color" : "white";
                                            "font-size" : "0.6rem";
                                            "whitespace" : "nowrap";
                                            "font-weight" : "600";
                                            "padding-left" : (i==0?"12px":"0px");
                                            "padding-right" : (i==1?"12px":"0px");
                                            "text-align" : (i==1?"right":"left");
                                            text_theme;
                                        }
                                    } else {
                                        "width" : "0%";
                                    }
                                }
                            }       
                        } else {
                            Ptr& vote = get_vote(race.label);
                            string candidate = "";
                            string points = " ";
                            if(is_live(vote)) {
                                Ptr& party = vote["party"];
                                string party_str = value_as_string(party);
                                string party_color = color_of_party(party_str);
                                "background-color" : party_color;
                                candidate = vote.label;
                                points = value_as_string(vote["points"]);
                            } else {
                                "background-color" : "gray";
                            }

                            text candidate {
                                "flex" : "1";
                                "color" : "white";
                                "font-size" : "0.6rem";

                                "font-weight" : "600";
                                "padding-left" : "12px";
                                text_theme;
                            }

                            text points {
                                "color" : "white";
                                "font-size" : "0.6rem";
                                "font-weight" : "700";
                                "background-color" : "rgba(0,0,0,0.25)";
                                "height" : "100%";
                                "display" : "flex";
                                "align-items" : "center";
                                "padding" : "0 16px";
                                text_theme;
                            }
                        }
                    }
                }
                if(user.locked) {
                    string animate_tallies_script = "
                        if(true) {
                            const tallies = getel("+js_lit(capture_node(tally_display))+");
                            Array.from(tallies.children).forEach((tally, i) => {
                                Array.from(tally.children).forEach((candidate, s) => {
                                    setTimeout(() => {
                                        candidate.style.transform = 'translateX(0%)';
                                    }, (i+1)*80);
                                });
                            });
                        }
                    ";
                    script animate_tallies_script;
                }
            }

            bool user_registered = false;
            if(is_live(user)) {
                user.as(ColCol).try_read_forever_then {
                    user_registered = user.?password;
                }   
            }

            div {
                "id" : "lock_button_panel";
                "display" : (user.locked?"none":"flex");
                "position" : "relative";
                "width" : "100%";
                "max-width" : "400px";
                "justify-content" : "center";
                button {
                    text "Lock in" {"color" : "white"; text_theme};
                    "id" : "vote_lock_btn";
                    "border" : "none";
                    "background-color" : "gray";
                    "padding" : "12px";
                    "border-radius" : "8px";
                    "width" : "50%";
                    "onclick" : "
                        const tallies = getel("+js_lit(capture_node(tally_display))+");
                        Array.from(tallies.children).forEach(tally => {
                            apply_theme(tally,"+js_lit(skeleton_pulse.emit)+");
                        });
                        getel('register_prompt').style.display = 'flex';
                    ";
                }
                div {
                    "id" : "lock_pane";
                    "position" : "absolute";
                    "inset" : "0";
                    "background" : "rgba(0,0,0,0.6)";
                    "border-radius" : "8px";

                    bool voting_finished = is_voting_finished;

                    "display" : (voting_finished?"none":"flex");
                    "align-items" : "center";
                    "justify-content" : "center";
                    text "vote in all races to unlock" {
                        "color" : "white";
                        "font-size" : "0.7rem";
                        "font-weight" : "700";
                        text_theme;
                    }
                }
            }


            div {
                "id" : "register_prompt";
                "display" : "none";
                "position" : "absolute";
                "inset" : "0";
                "background" : "rgba(0,0,0,0.7)";
                "border-radius" : "16px";
                "display" : "flex";
                "flex-direction" : "column";
                "align-items" : "center";
                "justify-content" : "center";
                "gap" : "16px";
                "z-index" : "10";

                if(user_registered) {
                   text "Are you sure?" {
                        "color" : "white";
                        "font-size" : "18px";
                        "font-weight" : "700";
                        "text-align" : "center";
                        "padding" : "0 24px";
                        text_theme;
                    }
                    text "Locking in your votes is permanent. This action can not be undone." {
                        "color" : "rgb(180,180,180)";
                        "font-size" : "14px";
                        "text-align" : "center";
                        "padding" : "0 24px";
                        text_theme;
                    }
                    div {
                        "display" : "flex";
                        "gap" : "12px";
                        button {
                            text "I'm Sure" {"color" : "white"; "font-weight" : "700"; text_theme;}
                            "border" : "none";
                            "border-radius" : "8px";
                            "padding" : "10px 20px";
                            "background-color" : "rgb(80,80,80)";
                            "cursor" : "pointer";
                            "onclick" : capture(
                                js_do("
                                    getel('lock_button_panel').style.display = 'none';
                                    const tallies = getel("+js_lit(capture_node(tally_display))+");
                                    Array.from(tallies.children).forEach(tally => {
                                        apply_theme(tally,"+js_lit(skeleton_pulse.emit)+");
                                    });
                                ");
                            ) {
                                lock_in_votes;
                                tally_board_holder.reload;
                            }
                        }
                        button {
                            text "No" {"color" : "white"; "font-weight" : "700"; text_theme;}
                            "border" : "none";
                            "border-radius" : "8px";
                            "padding" : "10px 20px";
                            "background-color" : "rgb(115, 115, 115)";
                            "cursor" : "pointer";
                            "onclick" : capture {
                                sync_with_database;
                                tally_board_holder.reload;
                            }
                        }
                    }
                } else {
                    text "Want to save your picks?" {
                        "color" : "white";
                        "font-size" : "18px";
                        "font-weight" : "700";
                        "text-align" : "center";
                        "padding" : "0 24px";
                        text_theme;
                    }
                    text "Create an account to lock in your votes and compete on the leaderboard." {
                        "color" : "rgb(180,180,180)";
                        "font-size" : "14px";
                        "text-align" : "center";
                        "padding" : "0 24px";
                        text_theme;
                    }
                    div {
                        "display" : "flex";
                        "gap" : "12px";
                        button {
                            "border" : "none";
                            "border-radius" : "8px";
                            "padding" : "10px 20px";
                            "background-color" : "rgb(60,100,200)";
                            "cursor" : "pointer";
                            "onclick" : "window.location.href='/login';";
                            text "Sign Up" {"color" : "white"; "font-weight" : "700"; text_theme;}
                        }
                        button {
                            "border" : "none";
                            "border-radius" : "8px";
                            "padding" : "10px 20px";
                            "background-color" : "rgb(80,80,80)";
                            "cursor" : "pointer";
                            "onclick" : capture {
                                sync_with_database;
                                tally_board_holder.reload;
                            }
                            text "Maybe Later" {"color" : "white"; "font-weight" : "700"; text_theme;}
                        }
                    }
                }
            }
        }
    }



    string capstr = capture{
        if(usubunits.length==1) {
            print("Snapshotting");
            snapshot_subunit(0,"savetest.gsu");
        }
        print(unit_time_precise,":");
        print(unit_info);
        ColColCol diffable = load_subunit("savetest.gsu");
        correct_loaded_ptrs(diffable);
        print("Diffable: ",capture_ptr(diffable));
        print(utypes[4].length," / ",diffable[4].length);
        diff_types(diffable);
    };
    string checkvotes = capture(
        string jsvotes ; js_do("
            let to_return = '';
            const entries = Object.entries(voted_for);
            for(let i=0; i<entries.length; i++) {
                const key = entries[i][0];
                const val = entries[i][1];
                to_return += key + ':' + val + (i+1<entries.length?'\\n':'');
            }
            return to_return;
        ");
    ){
        print("==Server Votes==\n",check_votes(),"\n==Client Votes==\n",jsvotes);
    };
    script "
        document.addEventListener('keydown', (e) => {
            if(e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA') return;
            if(e.key === 'm') {
                "+capstr+";
            }
            if(e.key === 'v') {
                "+checkvotes+";
            }
        });

        const personalities = {
            map_user: {
                think_time: () => 300 + Math.random() * 700,
                tab_delay: () => 400 + Math.random() * 300,
                vote_delay: () => 300 + Math.random() * 400,
                use_drawer: false,
            },
            mobile_user: {
                think_time: () => 500 + Math.random() * 1000,
                tab_delay: () => 600 + Math.random() * 500,
                vote_delay: () => 400 + Math.random() * 600,
                use_drawer: true,
            },
            speedrunner: {
                think_time: () => 50 + Math.random() * 50,
                tab_delay: () => 80 + Math.random() * 50,
                vote_delay: () => 60 + Math.random() * 40,
                use_drawer: true,
            },
            map_speedrunner: {
                think_time: () => 50 + Math.random() * 400,
                tab_delay: () => 80 + Math.random() * 100,
                vote_delay: () => 60 + Math.random() * 200,
                scroll_speed: () => 50 + Math.random() * 50,
                use_drawer: false,
            },
        };
        const keys = Object.keys(personalities);
        const my_personality = personalities[keys[Math.floor(Math.random() * keys.length)]];

        function simulate_user() {
            const states = Object.keys(vote_tally).filter(s => vote_tally[s] > 0);
            if(states.length === 0) {
                getel('tally_board').scrollIntoView({ behavior: 'smooth', block: 'end' });
                setTimeout(() => {
                    getel('vote_lock_btn').click();
                    if(getel('register_prompt').style.display==='flex') {
                        setTimeout(() => {
                            window.location.href = '/login';
                        },600);
                    } else {
                        setTimeout(() => {
                            window.location.href = '/login';
                        },1200);
                    }
                }, 500);
                return;
            }

            if(my_personality.use_drawer) {
                const drawer_btn = getel('all_races_view').children[0];
                const drawer = getel('all_races_view').children[1];
                if(drawer.style.height === '0px') {
                    drawer_btn.click();
                }
                setTimeout(() => {
                    const all_displays = drawer.querySelectorAll('.race_display');
                    let display_idx = 0;
                    function do_drawer_race() {
                        if(display_idx < all_displays.length) {
                            const display = all_displays[display_idx];
                            display.scrollIntoView({ behavior: 'smooth', block: 'center' });
                            if(display.style.display !== 'none') {
                                const buttons = display.querySelectorAll('button[data-btncandidate]');
                                if(buttons.length > 0) {
                                    setTimeout(() => {
                                        buttons[Math.floor(Math.random() * buttons.length)].click();
                                    }, my_personality.vote_delay());
                                }
                            }
                            display_idx++;
                            setTimeout(do_drawer_race, my_personality.tab_delay());
                        } else {
                            drawer_btn.click();
                            setTimeout(simulate_user, my_personality.think_time());
                        }
                    }
                    do_drawer_race();
                }, my_personality.think_time());
            } else {
                const state = states[Math.floor(Math.random() * states.length)];
                const badge = getel(state+'_badge');
                const races = badge.querySelector('.races_display');
                const displays = races.children[1].children;
                if(badge) {
                    if(badge.children[0].style.display==='none') {
                        badge.children[1].click();
                    }
                    setTimeout(() => {
                        const tabs = badge.querySelectorAll('.race_tab');
                        let tab_idx = 0;
                        function do_tab() {
                            if(tab_idx < tabs.length) {
                                const tab = tabs[tab_idx];
                                tab.click();
                                const active_display = displays[tab_idx];
                                setTimeout(() => {
                                    const buttons = active_display.querySelectorAll('button[data-btncandidate]');
                                    if(buttons.length > 0) {
                                        buttons[Math.floor(Math.random() * buttons.length)].click();
                                    }
                                    tab_idx++;
                                    setTimeout(do_tab, my_personality.tab_delay());
                                }, my_personality.vote_delay());
                            } else {
                                badge.children[0].click();
                                setTimeout(simulate_user, my_personality.think_time());
                            }
                        }
                        do_tab();
                    }, my_personality.think_time());
                }
            }
        }
        //simulate_user();
    ";
}


##
    register faqs;
    "faqs" {
        in htmlemiting {
            subemit("body",false,"","");
        }
    }
##

faqs {
    standard_header;
    top_bar("/faqs");
    div {
        "display" : "flex";
        "justify-content" : "center";
        "padding" : "32px 16px";
        div {
            "display" : "flex";
            "flex-direction" : "column";
            "gap" : "24px";
            "width" : "min(720px, 95%)";

            text "frequently asked questions" {
                "font-size" : "2rem";
                "font-weight" : "800";
                text_theme;
            }

            stateless template div faq(string q, string a) {
                div {
                    "display" : "flex";
                    "flex-direction" : "column";
                    "gap" : "6px";
                    text q {
                        "font-weight" : "800";
                        "font-size" : "1rem";
                        text_theme;
                    }
                    text a {
                        "font-size" : "0.9rem";
                        text_theme;
                    }
                }
            }

            faq("how do I play this game and use this website?",
                "Watch the short video below to understand the game and this website.");
            iframe {
                "src" : "https://www.youtube.com/embed/wIyYvk0Ltvo";
                "width" : "100%";
                "height" : "360px";
                "frameborder" : "0";
                "allowfullscreen" : "true";
            }
            faq("who chose the elections and points?",
                "We did! We picked some of the most competitive elections in the country and assigned points based off of how a number of political experts see the candidates' odds of winning and losing. Candidates with fewer points are slight to moderate favorites. For example, a 4/6 point spread translates roughly to a 40%/60% race, where the favored candidate (40% chance of LOSING) is assigned 4 points and the underdog candidate (60% chance of LOSING) is assigned 6 points. A 7/3 spread translates roughly to a 70%/30% race, respectively. But political forecasters (both quantitative and qualitative) disagree about these odds, which is why players get more points for correctly picking upsets. We also picked elections with interesting candidate and district dynamics that make the selections more difficult than they first appear.");
            faq("why did you make this site?",
                "We made this site for our students but thought it would be fun to share. People want to learn when they are interested in a topic. We hope people will learn more about elections if it's a little more fun.");
            faq("who are you?",
                "Eric Gonzalez Juenke is an Associate Professor of Political Science at Michigan State University. He made this game during the COVID pandemic because it made him happy. He had help and support from his incredibly patient wife Emily Katz (MSU). Matt Grossmann is a Professor of Political Science at MSU and he was crucial to outreach and development. Eric also received invaluable feedback from the following colleagues, although all mistakes and errors are his own: Kjerstin Thorsen (MSU), Ezra Brooks (MSU), Danielle Barnes (MSU), Ryan Black (MSU), David Peterson (Iowa State), Nate Birkhead (Kansas State), Josh McCrain (University of Utah), Ana Bracic (MSU), Jennifer Wolak (MSU), Robert Lupton (UConn), and Andrew Katz (Dawson College).");
            faq("wait, are you studying us?",
                "No, this is a teaching site. We are not collecting anything from you without express consent (some students may take a short survey to see if the game makes them more interested in politics). We are serious about getting people interested in elections. We are not making any money from this site or you.");
            faq("does this game make light of real world politics?",
                "No. Politics is serious business. People's lives and livelihoods are at stake. However, many people are not interested in, or do not have the time to follow, politics and elections. We do not think a little fun should prevent more civic education. FDR wrote: 'Democracy cannot succeed unless those who express their choice are prepared to choose wisely. The real safeguard of democracy, therefore, is education.' We believe that when you like something, you will make time for it. We hope you like playing this political game.");
            faq("are there prizes for the winning players?",
                "No, but outsmarting other students is a kind of prize. Will you beat our experts? Your friends? Your co-workers? Nothing is stopping you from making your own prizes and your own pools! We are using runyourpool.com (not an endorsement) in our classes to manage our student picks, but you can use any outlet you like.");
            faq("can I use these scoresheets to make an office or friendly pool with others?",
                "Heck yeah. Millions of people play March Madness every year. That game forces you to choose 63 (or 67) contests. This game only asks you to pick 24 winners. That's 39 fewer choices to make! We encourage you to have fun.");
            faq("who decides the winners?",
                "We do. We will base our choices on the official declared winner within a state. For the presidential race we will go off of electoral college vote. If there are any weird legal discrepancies, we make the final call on this website.");
            faq("i am a teacher or instructor and I want my students to participate. how do I do that?",
                "See our instructor resources page.");
        }
    }
}

##
    register student_resources;
    "student_resources" {
        in htmlemiting {
            subemit("body",false,"","");
        }
    }
##

student_resources {
    standard_header;
    top_bar("/student_resources");
    div {
        "display" : "flex";
        "justify-content" : "center";
        "padding" : "32px 16px";
        div {
            "display" : "flex";
            "flex-direction" : "column";
            "gap" : "20px";
            "width" : "min(720px, 95%)";

            text "resources and help sheets" {
                "font-size" : "2rem";
                "font-weight" : "800";
                text_theme;
            }
            text "election resources, models, and forecasts" {
                "font-weight" : "800";
                "font-size" : "1rem";
                text_theme;
            }

            stateless template div reslink(string label, string url) {
                link label {
                    "font-weight" : "700";
                    "font-size" : "0.95rem";
                    "cursor" : "pointer";
                    "color" : "rgb(18,121,190)";
                    "href" : url;
                    text_theme;
                }
            }

            div {
                "display" : "flex";
                "flex-direction" : "column";
                "gap" : "10px";
                text "forecasters and models" {
                    "font-weight" : "700";
                    text_theme;
                }
                reslink("Ballotpedia","https://ballotpedia.org/Main_Page");
                reslink("Cook Political Report","https://cookpolitical.com/ratings");
                reslink("Decision Desk HQ","https://decisiondeskhq.com/");
                reslink("The Economist election model","https://www.economist.com/interactive/us-2024-election/trump-harris-polls/");
                reslink("Split Ticket","https://split-ticket.org");
                reslink("JHK Forecasts","https://jhkforecasts.com/");
                reslink("NYT Election Needle","https://www.nytimes.com/news-event/2024-election");
                reslink("RealClearPolitics","http://realclearpolitics.com");
                reslink("Sabato's Crystal Ball","http://centerforpolitics.org/crystalball/");
                reslink("270toWin","https://www.270towin.com/news/");
                reslink("Inside Elections","https://insideelections.com/ratings/");
                reslink("Nate Silver","https://www.natesilver.net");
                reslink("VoteHub","https://votehub.com");
                reslink("G. Elliott Morris","https://www.gelliottmorris.com");
                reslink("StateNavigate","https://statenavigate.org");
            }

            div {
                "display" : "flex";
                "flex-direction" : "column";
                "gap" : "10px";
                text "essential reading" {
                    "font-weight" : "700";
                    text_theme;
                }
                reslink("The basics of reading polls - essential reading for understanding polling basics","https://www.pewresearch.org/course/public-opinion-polling-basics/");
                reslink("Statistical roundup from Andrew Gelman (modeling consultant for the Economist)","https://statmodeling.stat.columbia.edu/2024/09/19/instability-of-win-probability-in-election-forecasts-with-a-little-bit-of-r/");
                reslink("Is there a way to evaluate forecasts BEFORE the election? Maybe!","https://rajivsethi.substack.com/p/a-forecasting-competition");
                reslink("Are presidential forecasts any good?","https://www.politico.com/news/magazine/2024/09/03/election-forecasts-data-00176905");
                reslink("You Be the Campaign Manager (Split-Ticket and Politico)","https://www.politico.com/interactives/2023/2024-election-campaign-manager-game/");
                reslink("You Be the Campaign Manager (Financial Times)","https://ig.ft.com/us-election-game/");
            }
        }
    }
}

##
    register instructor_resources;
    "instructor_resources" {
        in htmlemiting {
            subemit("body",false,"","");
        }
    }
##

instructor_resources {
    standard_header;
    top_bar("/instructor_resources");
    div {
        "display" : "flex";
        "justify-content" : "center";
        "padding" : "32px 16px";
        div {
            "display" : "flex";
            "flex-direction" : "column";
            "gap" : "20px";
            "width" : "min(720px, 95%)";

            text "instructor resources" {
                "font-size" : "2rem";
                "font-weight" : "800";
                text_theme;
            }
            text "How can you use this game in your class? The website and game can be used minimally or maximally. Some instructors are using it as a point of discussion for the election or for extra credit. Other instructors are using it as a shared experience for their class. Their students are working in groups to research the elections (3-4 races each) with each student making their own picks in October based on the group's research. Others have students doing an in-depth background on particularly interesting candidates, making campaign ads to highlight their biography, or producing fact-sheets for the class to reference. See example assignments and worksheets below for more detailed ideas. Regardless of how instructors use the site, student players are able to compete against others from around the country. That is fun. Fun can lead to interest and learning." {
                "font-size" : "0.9rem";
                text_theme;
            }

            stateless template div doclink(string label, string url) {
                text label {
                    "font-weight" : "700";
                    "font-size" : "0.95rem";
                    "cursor" : "pointer";
                    "color" : "rgb(18,121,190)";
                    "text-decoration" : "underline";
                    "onclick" : "window.open("+js_lit(url)+",'_blank')";
                    text_theme;
                }
            }

            div {
                "display" : "flex";
                "flex-direction" : "column";
                "gap" : "10px";
                doclink("instructions and ideas","https://election-madness.org/wp-content/uploads/2024/08/instructions-and-ideas.pdf");
                doclink("example assignments","https://election-madness.org/wp-content/uploads/2024/08/example-assignments-for-high-school-or-college-teachers.pdf");
                doclink("example student worksheets","https://election-madness.org/wp-content/uploads/2024/08/student-worksheets.docx");
                doclink("example lecture slides (ppt)","https://election-madness.org/wp-content/uploads/2024/08/slides-for-instructors-to-use.pptx");
                doclink("example lecture slides (pdf)","https://election-madness.org/wp-content/uploads/2024/08/slides-for-instructors-to-use.pdf");
            }

            text "goals for student engagement" {
                "font-weight" : "800";
                "font-size" : "1rem";
                text_theme;
            }

            div {
                "display" : "flex";
                "flex-direction" : "column";
                "gap" : "12px";

                stateless template div goal(string label) {
                    div {
                        "display" : "flex";
                        "flex-direction" : "row";
                        "gap" : "10px";
                        text "-" { "flex-shrink" : "0"; text_theme; }
                        text label { "font-size" : "0.9rem"; text_theme; }
                    }
                }

                goal("Students will hopefully have fun with something they do not consider fun. In doing so, they will get acquainted with how experts think and talk about elections in the United States. Students will learn ways in which elections in different states are tied to one another, and how they are independent of one another.");
                goal("Students will learn how to consume higher-order information about elections. Not simply the quantitative forecasts and models, which can sometimes feed into a horse-race understanding of American politics, but also with the qualitative information students will get by reading about the different elections in the news. The goal is to get students to want to be surrounded by higher quality information about elections, and give them the tools to understand this information.");
                goal("Students will learn about candidates they may have never heard of. They will focus on places they never think about. They will see how our system of government comes together geographically, and how different places produce different candidates and officeholders and, hopefully, they will see how all of these different people will come together to serve in congress in the coming years.");
                goal("We want students to understand why we (political scientists and government teachers) love elections. We want to give them a little taste of what it's like to study our electoral system.");
            }

            text "coming soon: expert picks, student breakdowns of individual elections, and more." {
                "font-size" : "0.9rem";
                "font-style" : "italic";
                text_theme;
            }
        }
    }
}

