##
    register contacts;
    "contacts" {
        in htmlemiting {
            subemit("body",false,"","");
        }
    }
##

contacts {
    style "
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        @keyframes skeleton_pulse { 0% { background-position: 200% 0; } 100% { background-position: -200% 0; } }
    ";
    script read_file("web/webcorn.js");
    top_bar("/contacts");
    text "The contacts";
}

##
    register login;
    "login" {
        in htmlemiting {
            subemit("body",false,"","");
        }
    }
##

login {
    div {
        style "
            td:hover {
                background-color:rgb(234, 234, 234);
            }
            input:focus {
                outline: none;
            }
            textarea:focus {
                outline: none;
            }

            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }
        ";

        script read_file("web/webcorn.js");
        background_theme;
        div {
            "display" : "flex";
            "min-height" : "100vh";
                div {
                    "flex" : "1";
                    "display" : "flex";
                    "flex-direction" : "column";
                    "justify-content" : "center";
                    "align-items" : "center";
                        div {
                            "id" : "login_title";
                            "opacity" : "1";
                            "transition" : "opacity 0.6s ease, transform 0.8s ease";
                            "transform-origin" : "center bottom";
                            text "Election Madness" {"font-size" : "80px"; "font-weight" : "800"; text_theme;}
                            text "Made with TwigSnap" {"text-align" : "center"; "font-size" : "12px"; "font-weight" : "600"; text_theme;}
                            script "
                                setTimeout(() => {
                                    const title = getel('login_title');
                                    const body = getel('login_body');
                                    title.style.opacity = '0';
                                    title.style.transform = 'scale(4)';
                                    setTimeout(() => {
                                        title.style.display = 'none';
                                        body.style.opacity = '1';
                                    }, 400);
                                    body.style.transition = 'opacity 0.4s ease';
                                }, 800);
                            ";
                        }
                        div {
                            "id" : "login_body";
                            "opacity" : "0";
                            "transition" : "opacity 0.4s ease";
                            "display" : "flex";
                            "justify-content" : "center";
                            "align-items" : "center";
                            "flex-direction" : "column";
                            "width" : "min(480px, 90vw)";
                            "height" : "auto";
                            "min-height" : "120px";
                            "padding" : "40px";
                            "gap" : "12px";
                            card_theme;
                            "border-radius" : "12px";
                            "box-shadow" : "0 4px 24px rgba(0,0,0,0.08)";

                            string login_behaviour = capture(
                                string given_username ; "getel('username').value",
                                string given_password ; "getel('password').value"
                            ) {
                                string new_path = project_path+"users/"+given_username;
                                if(file_exists(new_path)) {
                                    string userinfo = read_file(new_path+"/userinfo");
                                    string userpass = userinfo.substr(userinfo.find("\n",0,2)+1);
                                    if(secure_hash(given_password)==userpass) {
                                        cry("SESSION:"+given_username);
                                        string session_token = unit_label;
                                        session.role = userinfo.slice(0,userinfo.find("\n"));
                                        session.org = userinfo.slice("\n",1,2);
                                        emit_js("
                                            document.cookie = 'session="+session_token+"; path=/';
                                            window.location.href = "+(redirected_from.length==0?"'/'":js_lit(redirected_from))+";
                                        ");
                                    } else {
                                        emit_js(" 
                                            const btn = getel('login');
                                            btn.children[0].innerText='Wrong password';
                                            setTimeout(() => {
                                                btn.children[0].innerText = 'Login';
                                            }, 600);
                                        ");
                                    }
                                } else {
                                    emit_js(" 
                                        const btn = getel('login');
                                        btn.children[0].innerText='Username not found';
                                        setTimeout(() => {
                                            btn.children[0].innerText = 'Login';
                                        }, 600);
                                    ");
                                }
                            };
                            string register_behaviour =  capture(
                                string given_username ; "getel('username').value",
                                string given_password ; "getel('password').value"
                            ) {
                                string new_path = project_path+"users/"+given_username;
                                if(given_username.length>0) {
                                    if(file_exists(new_path)) {
                                        emit_js(" 
                                            const btn = getel('login');
                                            btn.children[0].innerText='Username taken';
                                            setTimeout(() => {
                                                btn.children[0].innerText = 'Register';
                                            }, 600);
                                        ");
                                    } else {
                                        create_directory(new_path);
                                        if(given_password.length>0) {
                                            write_file(new_path+"/userinfo","guest\npublic\n"+secure_hash(given_password));
                                        }
                                        cry("SESSION:"+given_username);
                                        string session_token = unit_label;
                                        session.role = "guest";
                                        session.org = "public";
                                        emit_js("
                                            document.cookie = 'session="+session_token+"; path=/';
                                            window.location.href = "+(redirected_from.length==0?"'/'":js_lit(redirected_from))+";
                                        ");
                                    }
                                }
                            };

                            div {
                                "display" : "flex";
                                "width" : "100%";
                                "padding" : "10px";
                                "gap" : "12px";

                                script "
                                    function expand_login_card(card) {
                                        if(card.style.height === '0px') {
                                            card.style.height = 'auto';
                                            const h = card.scrollHeight;
                                            card.style.height = '0px';
                                            requestAnimationFrame(() => {
                                                card.style.height = h + 'px';
                                            });
                                        }
                                    }
                                    function toggle_login_card(new_label, is_login) {
                                        const card = getel('login_card');
                                        const btn = getel('login');
                                        btn.onclick = is_login ? function() { "+login_behaviour+" } : function() { "+register_behaviour+" };
                                        if(btn.children[0].innerText !== new_label) {
                                            btn.children[0].innerText = new_label;
                                            expand_login_card(card);
                                        } else {
                                            if(card.style.height === '0px') {
                                                expand_login_card(card);
                                            } else {
                                                card.style.height = '0px';
                                            }
                                        }
                                    }
                                ";

                                stateless template div loginbtn(string label, string behaviour) {
                                    button {
                                        "border" : "none";
                                        "border-radius" : "8px";
                                        "width" : "50%";
                                        "height" : "35px";
                                        "background-color" : "rgb(60,100,200)";
                                        text label {"margin" : "5px"; "color" : "white"; text_theme;}
                                        "onclick" : behaviour;
                                    }
                                }
                                
                                loginbtn("Guest",capture{
                                    string new_guest_id = "guest_"+to_string(unit_uid)+"-"+to_string(guest_counter++);
                                    cry("SESSION:"+new_guest_id);
                                    string session_token = unit_label;

                                    response.append("HTTP/1.1 200 OK\r\n");
                                    response.append("Content-Type: text/html\r\n");
                                    response.append("Set-Cookie: session="+session_token+"; path=/; SameSite=Lax\r\n");
                                    print("Response: ",response);

                                    emit_js("
                                        window.location.href = "+(redirected_from.length==0?"'/'":js_lit(redirected_from))+";
                                    ");

                                    print("Response: ",response);
                                });
                                loginbtn("Log In","toggle_login_card('Login',true);");
                                loginbtn("Register","toggle_login_card('Register',false);");
                            }
                            div {
                                "width" : "100%";
                                "display" : "flex";
                                "flex-direction" : "column";
                                "align-items" : "center";
                                "gap" : "8px";
                                div {
                                    "id" : "login_card";
                                    "display" : "flex";
                                    "justify-content" : "center";
                                    "align-items" : "end";
                                    "flex-direction" : "column";
                                    "height" : "0px";
                                    "overflow" : "hidden";
                                    "transition" : "height 0.5s ease";
                                    "gap" : "12px";
                                    
                                    inlined login_input_theme {
                                        "border-top" : "none";
                                        "border-left" : "none";
                                        "border-right" : "none";
                                        "border-bottom" : "2px solid rgb(200,200,200)";
                                        "border-radius" : "0px";
                                        "background-color" : "transparent";
                                        "padding" : "8px 0px";
                                        input_theme;
                                    }
    
                                    div {
                                        "display" : "flex";
                                        "align-items" : "center";
                                        "width" : "100%";
                                        "gap" : "7px";
                                            text "Username:" {
                                                "width" : "70px";
                                                "font-size" : "14px";
                                                "flex-shrink" : "0";
                                                text_theme;
                                            }
                                            input {
                                                "id" : "username";
                                                "flex" : "1";
                                                login_input_theme;
                                            }
                                    }

                                    div {
                                        "display" : "flex";
                                        "align-items" : "center";
                                        "width" : "100%";
                                        "gap" : "8px";
                                            text "Password:" {
                                                "width" : "70px";
                                                "font-size" : "14px";
                                                "flex-shrink" : "0";
                                                text_theme;
                                            }
                                            input {
                                                "id" : "password";
                                                "type" : "password";
                                                "flex" : "1";
                                                login_input_theme;
                                            }
                                    }

                                    button {
                                        "id" : "login";
                                        "onclick" : login_behaviour;
                                        text "Login" {
                                            "margin" : "5px";
                                            "font-size" : "14px";
                                            text_theme;
                                        }
                                        "width" : "75%";
                                        "border" : "none";
                                        "border-radius" : "4px";
                                        "background-color" : "rgb(230, 230, 230)";
                                    }
                                }
                            }
                        }
                }
        }
    }
}
