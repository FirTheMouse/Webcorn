                                        "cursor" : "pointer";
                                        text "CSV" {
                                            "font-size" : "14px";
                                            text_theme;
                                        }
                                        "onclick" : capture {
                                            emit_js("
                                                const csv = " + js_lit(sheets_to_CSV(sheetpool)) + ";
                                                const blob = new Blob([csv], {type: 'text/csv'});
                                                const url = URL.createObjectURL(blob);
                                                const a = document.createElement('a');
                                                a.href = url;
                                                a.download = '" + sheetname + ".csv';
                                                a.click();
                                                URL.revokeObjectURL(url);
                                            ");
                                        }
                                    }
                                    button {
                                        "display" : "flex";
                                        "justify-content" : "center";
                                        "align-items" : "center";
                                        "height" : "36px";
                                        "width" : "120px";
                                        "border" : "none";
                                        "border-radius" : "6px";
                                        "cursor" : "pointer";
                                        text "JSON" {
                                            "font-size" : "14px";
                                            text_theme;
                                        }
                                        "onclick" : capture {
                                            emit_js("
                                                const json = " + js_lit(sheets_to_JSON(sheetpool)) + ";
                                                const blob = new Blob([json], {type: 'application/json'});
                                                const url = URL.createObjectURL(blob);
                                                const a = document.createElement('a');
                                                a.href = url;
                                                a.download = '" + sheetname + ".json';
                                                a.click();
                                                URL.revokeObjectURL(url);
                                            ");
                                        }
                                    }
                            }
                            div {
                                "display" : "flex";
                                "justify-content" : "center";
                                "width" : "100%";
                                "overflow-x" : "auto";
                                if(sheetpool!=0) {   
                                    audit_render_sheet(sheetpool);
                                }
                            }                            
                        }
                }
        }
    }
}

##
    register admin;
    "admin" {
        in htmlemiting {
            ctx.source.append("<!DOCTYPE html><html><body>");
            emit_contents;
            ctx.source.append("</body></html>");
        }
    }
    global string admin_selected_user;  admin_selected_user = "";
##


admin {
    div {
        style "
            td:hover {
                background-color:rgb(234, 234, 234);
            }
            input:focus {
                outline: none;
            }
            textarea:focus {
                outline: none;
            }

            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }
            @keyframes fadeIn {
                from { opacity: 0; }
                to { opacity: 1; }
            }
        ";
        script read_file("web/webcorn.js");

        "display" : "flex";
        "min-height" : "100vh";
            side_bar("admin");
            background_theme;

            div user_display {
                "display" : "flex";
                "flex-direction" : "row";
                "width" : "100%";
                "height" : "100%";
                "gap" : "1%";

                static string admin_custom_user;
                
                stateless template div user_card(string username) {
                    div {
                        "flex" : "1";
                        "padding" : "8px";
                        "border-radius" : "10px";
                        card_theme;
                        "display" : "flex";
                        "flex-direction" : "row";
                        "gap" : "1%";
                        div {
                            "flex" : "2";
                            text username {
                                "font-size" : "16px";
                                text_theme;
                            }
                            "onclick" : capture(string userstr ; js_lit(username)) {
                                if(admin_selected_user==userstr) {
                                    admin_selected_user = "";
                                } else {
                                    admin_selected_user = userstr;
                                }
                                user_display.reload;
                            }
                        }
                        div {
                            "flex" : "1";
                            "display" : "flex";
                            "justify-content" : "center";
                            "align-items" : "center";
                            text "C" {
                                "font-size" : "16px";
                                text_theme;
                            }
                            "onclick" : capture(string userstr ; js_lit(username)) {
                                admin_custom_user = userstr;
                                user_display.reload;
                            }
                        }
                        div {
                            "flex" : "1";
                            "display" : "flex";
                            "justify-content" : "center";
                            "align-items" : "center";
                            text "X" {
                                "font-size" : "16px";
                                text_theme;
                            }
                            static string popup_confirm_delete_target;
                            if(popup_confirm_delete_target==username) {
                                div {
                                    "onclick" : capture {
                                        popup_confirm_delete_target = "";
                                        user_display.reload;
                                    }
                                    popup_background_theme;
                                    div {
                                        popup_panel_theme;
                                        text "Are you sure you want to delete "+username+"?" {
                                            "font-size" : "15px";
                                            text_theme;
                                        }
                                        div {
                                            "display" : "flex";
                                            "gap" : "12px";
                                            button {
                                                text "Yes";
                                                "onclick" : capture(
                                                    js_do("event.stopPropagation();"),
                                                    string ptarget ; js_lit(popup_confirm_delete_target)
                                                ){
                                                    remove_directory("web/thistle/users/"+ptarget);
                                                    popup_confirm_delete_target = "";
                                                    user_display.reload;
                                                }
                                            }
                                            button {
                                                text "No";
                                                "onclick" : capture(
                                                    js_do("event.stopPropagation();")
                                                ){
                                                    popup_confirm_delete_target = "";
                                                    user_display.reload;
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                            "onclick" : capture(string userstr ; js_lit(username)) {
                                popup_confirm_delete_target = userstr;
                                user_display.reload;
                            }
                        }
                    }
                }

                if(admin_custom_user.length!=0) {
                    div {
                        "onclick" : capture(js_do("event.stopPropagation();")) {
                            admin_custom_user = "";
                            user_display.reload;
                        }
                        popup_background_theme;
                        static string given_username;
                        static string given_password;

                        if(admin_custom_user.slice(0,1)=="[") {
                            given_username = "";
                            given_password = "";
                        } else {
                            string userinfo = read_file("web/thistle/users/"+admin_custom_user+"/userinfo");
                            given_username = admin_custom_user;
                            given_password = userinfo;
                        }

                        div create_user_display {
                            popup_panel_theme;
                            text "Username" {
                                "font-size" : "15px";
                                text_theme;
                            }
                            input {
                                if(given_username=="") {
                                    "border" : "none";
                                    "border-bottom" : "2px solid rgb(255, 0, 0)";
                                } else {
                                    "value" : given_username;
                                }
                                form_input_theme;
                                "onchange" : capture(string myval ; "this.value"){
                                    given_username = myval;
                                    create_user_display.reload;
                                }
                            }   

                            text "Password" {
                                "font-size" : "15px";
                                text_theme;
                            }
                            input {
                                if(given_password=="") {
                                    "border" : "none";
                                    "border-bottom" : "2px solid rgb(255, 0, 0)";
                                } else {
                                    "value" : given_password;
                                }
                                form_input_theme;
                                "onchange" : capture(string myval ; "this.value"){
                                    given_password = myval;
                                    create_user_display.reload;
                                }
                            }   

                            button {
                                text "Confirm";
                                if(admin_custom_user=="[NEW]") {
                                    "onclick" : capture(
                                        js_do("event.stopPropagation();")
                                    ){
                                        string new_path = "web/thistle/users/"+given_username;
                                        if(given_username.length>0) {
                                            create_directory(new_path);
                                            create_directory(new_path+"/sheets");
                                            create_directory(new_path+"/inbox");
                                            if(given_password.length>0) {
                                                write_file(new_path+"/userinfo",given_password);
                                            }
                                            admin_custom_user = "";
                                        }
                                        user_display.reload;
                                    }
                                } else {
                                     "onclick" : capture(
                                        js_do("event.stopPropagation();")
                                    ){
                                        print("Renaming ",admin_custom_user," to ",given_username);
                                        string new_path = "web/thistle/users/"+admin_custom_user;
                                        rename_file(new_path, "web/thistle/users/"+given_username);
                                        print("Changing password for ",admin_custom_user," to ",given_password);
                                        write_file(new_path+"/userinfo",given_password);
                                        admin_custom_user = "";
                                        user_display.reload;
                                    }
                                }
                            }
                        }
                    }
                }
                
                div {
                    "flex" : "1";
                    "display" : "flex";
                    "flex-direction" : "column";
                    "gap" : "1%";
                    Ptr string directories = list_directories_in_directory("web/thistle/users");
                    for(int i=0;i<directories.length;i++) {
                        user_card(directories.get(i));
                    }
                    div {
                        "flex" : "1";
                        "padding" : "8px";
                        "border-radius" : "10px";
                        card_theme;
                        "display" : "flex";
                        "flex-direction" : "row";
                        "justify-contents" : "center";
                        "align-items" : "center";
                        text "+" {
                            "font-size" : "16px";
                            text_theme;
                        }
                        "onclick" : capture {
                            admin_custom_user = "[NEW]";
                            user_display.reload;
                        }
                    }
                }

                if(admin_selected_user.length!=0) {
                    div {
                        "flex" : "2";
                        "border-radius" : "8px";
                        card_theme;

                        text admin_selected_user {
                            "font-size" : "18px";
                            "font-weight" : "800";
                            text_theme;
                        }

                        Ptr string usersheets = list_files_in_directory("web/thistle/users/"+admin_selected_user+"/sheets");
                        Ptr string userinbox = list_files_in_directory("web/thistle/users/"+admin_selected_user+"/inbox");
                        int lenr = usersheets.length;
                        if(userinbox.length>usersheets.length) {lenr = userinbox.length;}

                        table {
                            row {
                                column {text "Sheets" {text_theme;}}
                                column {text "Inbox" {text_theme;}}
                            }
                            for(int r=0;r<lenr;r++) {
                                row {
                                    if(r<usersheets.length) {column {text usersheets.get(r) {text_theme;}}}
                                    if(r<userinbox.length) {column {text userinbox.get(r) {text_theme;}}}
                                }
                            }
                        }
                    }
                }
            }
    }
}