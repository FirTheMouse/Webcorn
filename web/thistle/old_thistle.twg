    global ColCol thistle_ledger = utypes.add;
    global int append_to_thistle_ledger(int spool) {
        ColCol pool = utypes.get(spool);
        int index_to_return = 0;
        for(int i=0;i<pool.length;i++) {
            Ptr p = pool.get(i);
            bool found_col = false;
            for(int j=0;j<thistle_ledger.length;j++) {
                Ptr ledger_p = thistle_ledger.get(j);
                if(ledger_p.label==p.label) {
                    index_to_return = ledger_p.length;
                    for(int e=0;e<p.length;e++) {
                        Ptr element = p.get(e);
                        if(is_live(element)) {
                            ledger_p.push(*element);
                        } else {
                            ledger_p.push_default;
                        }
                    }
                    found_col = true;
                    break;
                }
            }
            if(!found_col) {
                string pstr = p.label;
                Ptr ledger_p = thistle_ledger.add(pstr);
                index_to_return = ledger_p.length;
                ledger_p.label(pstr);
                for(int e=0;e<p.length;e++) {
                    Ptr element = p.get(e);
                    if(is_live(element)) {
                        if(ledger_p.tag==0) {ledger_p.retype(*element);}
                        ledger_p.push(*element);
                    } else {
                        ledger_p.push_default;
                    }
                }
            }
        }
        return index_to_return;
    }
    global void header_append_to_thistle_ledger(int header_at) {
        ColCol pool = utypes.get(header_at);
        Ptr ribbon = deadptr;
        int i=pool.length-1;
        while(i>=0) {
            ribbon = makePtr3(header_at,i,0);
            if(ribbon.label=="Ribbon") {
                i=0;
            }
            i=i-1;
        }
        if(is_live(ribbon)) {
            for(int i=0;i<ribbon.length;i++) {
                Ptr field = (ribbon|S=i);
                Ptr element = *field;
                element; //I think the star unary is blocking in m stage, so just doing this for now
                bool found_col = false;
                for(int j=0;j<thistle_ledger.length;j++) {
                    Ptr ledger_p = thistle_ledger.get(j);
                    if(ledger_p.label==field.celllabel) {
                        ledger_p.push(*element);
                        found_col = true;
                        break;
                    }
                }
                if(!found_col) {
                    string pstr = field.celllabel;
                    Ptr ledger_p = thistle_ledger.add(pstr);
                    ledger_p.label(pstr);
                    ledger_p.retype(*element);
                    ledger_p.push(*element);
                }
            }   
        }
        //dump_pool(thistle_ledger,true);
    }
