##
    global string guestid;
    global Object user;
    global void sync_user() {
        guestid = get_cookie(current_request,"guestid");
        ColCol users = database["Users"];
        users.try_read_forever_then {
            if(users.has(guestid)) {
                user = users[guestid];
            } else {
                user = deadptr;
            }
        }
    }  
    global void sync_with_database() {
        if(!has_state) {
            if(guestid.length==0) {
                guestid = get_cookie(current_request,"guestid");
            }
            if(guestid.length==0) {
                guestid = generate_token;
                response.append("HTTP/1.1 200 OK\r\n");
                response.append("Content-Type: text/html\r\n");
                response.append("Set-Cookie: guestid="+guestid+"; path=/; SameSite=Lax\r\n");
            }
            ColCol users = database["Users"];
            users.try_read_forever_then {
                if(users.has(guestid)) {
                    user = users[guestid];
                } else {
                    user = deadptr;
                }
            }
            if(!is_live(user)) {
                users.try_lock_forever_then {
                    user = users.Object(
                        Assets: [string]
                    ).register(guestid);
                    string neuin_path = database["User_Assets"].add(char);
                        neuin_path = project_path+"files/Neuin1.png";
                    string fir_path = database["User_Assets"].add(char);
                        fir_path = project_path+"files/FirTheStudent.png";
                    user.Assets.push(neuin_path);
                    user.Assets.push(fir_path);
                }
            }
            guestid = "";
        }
    }
##

route login {
    div {
        standard_header;
        
        "background-color" : pebble_color_D1;
        response.append("HTTP/1.1 200 OK\r\n");
        response.append("Content-Type: text/html\r\n");
        response.append("Cache-Control: no-store\r\n");
        sync_user;
        bool user_registered = false;
        if(is_live(user)) {
            user.as(ColCol).try_read_forever_then {
                user_registered = user.?password;
            }   
        }
        
        div {
            "display" : "flex";
            "min-height" : "100vh";
                div {
                    "flex" : "1";
                    "display" : "flex";
                    "flex-direction" : "column";
                    "justify-content" : "center";
                    "align-items" : "center";
                        div {
                            "id" : "login_body";
                            "display" : "flex";
                            "justify-content" : "center";
                            "align-items" : "center";
                            "flex-direction" : "column";
                            "width" : "min(480px, 90vw)";
                            "height" : "auto";
                            "min-height" : "120px";
                            "padding" : "40px";
                            "gap" : "12px";
                            "background-color" : wood_color_L1;
                            "border-radius" : "12px";
                            "box-shadow" : "0 4px 24px rgba(0,0,0,0.08)";

                            div login_buttons {
                                "display" : "flex";
                                "justify-content" : "center";
                                "align-items" : "center";
                                "flex-direction" : "column";
                                "width" : "100%";
                                "height" : "100%";
                                
                                div {
                                    "display" : "flex";
                                    "width" : "100%";
                                    "padding" : "10px";
                                    "gap" : "12px";

                                    if(!user_registered) {
                                        string login_behaviour = capture(
                                            string given_username ; "getel('username').value",
                                            string given_password ; "getel('password').value"
                                        ) {
                                            Ptr sessions = database[0]["sessions"];
                                            string result = "";
                                            sessions.try_read_forever_then {
                                                if(sessions.has(given_username)) {
                                                    user = sessions[given_username];
                                                    if(user.password==secure_hash(given_password)) {
                                                        response.append("HTTP/1.1 200 OK\r\n");
                                                        response.append("Content-Type: text/html\r\n");
                                                        response.append("Set-Cookie: guestid="+(user.label)+"; path=/; SameSite=Lax\r\n");
                                                        emit_js("
                                                            window.location.href = "+(redirected_from.length==0?"'/'":js_lit(redirected_from))+";
                                                        ");
                                                    } else {
                                                        result = "Wrong password";
                                                    }
                                                } else {
                                                    result = "Username not found";
                                                }
                                            }
                                            if(result.length>0) {
                                                emit_js("
                                                    const btn = getel('login');
                                                    btn.children[0].innerText='"+result+"';
                                                    setTimeout(() => {
                                                        btn.children[0].innerText = 'Login';
                                                    }, 600);
                                                "); 
                                            }
                                        };

                                        string register_behaviour = capture(
                                            string given_username ; "getel('username').value",
                                            string given_password ; "getel('password').value"
                                        ) {
                                            Ptr sessions = database[0]["sessions"];
                                            bool username_avaliable = true;
                                            string result = "";
                                            sessions.try_read_forever_then {
                                                if(sessions.has(given_username)) {
                                                    username_avaliable = false;
                                                    result = "Username not avaliable";
                                                }
                                            }
                                            if(username_avaliable) {
                                                sync_with_database;
                                                ColCol userlock = user;
                                                string hashed_password = secure_hash(given_password);
                                                sessions.try_lock_forever_then {
                                                    if(sessions.has(given_username)) {
                                                        result = "Username not avaliable";
                                                    } else {
                                                        userlock.try_lock_forever_then {
                                                            if(user.?password) {
                                                                result = "Already registered";
                                                            } else {
                                                                user.password = hashed_password;
                                                                sessions.put(given_username, user);
                                                                result = "Registered";
                                                                emit_js("
                                                                    window.location.href = "+(redirected_from.length==0?"'/'":js_lit(redirected_from))+";
                                                                ");
                                                                database.save;
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                            emit_js("
                                                const btn = getel('login');
                                                btn.children[0].innerText='"+result+"';
                                                setTimeout(() => {
                                                    btn.children[0].innerText = 'Register';
                                                }, 600);
                                            "); 
                                        };
                                        
                                        script "
                                            function expand_login_card(card) {
                                                if(card.style.height === '0px') {
                                                    card.style.height = 'auto';
                                                    const h = card.scrollHeight;
                                                    card.style.height = '0px';
                                                    requestAnimationFrame(() => {
                                                        card.style.height = h + 'px';
                                                    });
                                                }
                                            }
                                            function toggle_login_card(new_label, is_login) {
                                                const card = getel('login_card');
                                                const btn = getel('login');
                                                btn.onclick = is_login ? function() { "+login_behaviour+" } : function() { "+register_behaviour+" };
                                                if(btn.children[0].innerText !== new_label) {
                                                    btn.children[0].innerText = new_label;
                                                    expand_login_card(card);
                                                } else {
                                                    if(card.style.height === '0px') {
                                                        expand_login_card(card);
                                                    } else {
                                                        card.style.height = '0px';
                                                    }
                                                }
                                            }
                                        ";
                                    }

                                    stateless template div loginbtn(string label, string behaviour) {
                                        button {
                                            "width" : "50%";
                                            "height" : "35px";
                                            wood_button_theme;
                                            text label {"color" : "white"; golden_font;}
                                            "onclick" : behaviour;
                                        }
                                    }
                                    
                                    if(user_registered) {
                                        loginbtn("Back",capture{
                                            emit_js("
                                                window.location.href = "+(redirected_from.length==0?"'/'":js_lit(redirected_from))+";
                                            ");
                                        });
                                        loginbtn("Logout",capture{
                                            response.append("HTTP/1.1 200 OK\r\n");
                                            response.append("Content-Type: text/html\r\n");
                                            response.append("Set-Cookie: guestid=; path=/; SameSite=Lax; Max-Age=0\r\n");
                                            user_registered = false;
                                            login_buttons.reload;
                                        });
                                    } else {
                                        loginbtn("Guest",capture{
                                            emit_js("
                                                window.location.href = "+(redirected_from.length==0?"'/'":js_lit(redirected_from))+";
                                            ");
                                        });
                                        loginbtn("Log In","toggle_login_card('Login',true);");
                                        loginbtn("Register","toggle_login_card('Register',false);");
                                    }
                                }
                                div {
                                    "width" : "100%";
                                    "display" : "flex";
                                    "flex-direction" : "column";
                                    "align-items" : "center";
                                    "gap" : "8px";
                                    div {
                                        "id" : "login_card";
                                        "display" : "flex";
                                        "justify-content" : "center";
                                        "align-items" : "end";
                                        "flex-direction" : "column";
                                        "height" : "0px";
                                        "overflow" : "hidden";
                                        "transition" : "height 0.5s ease";
                                        "gap" : "12px";
                                        
                                        inlined login_input_theme {
                                            "border-top" : "none";
                                            "border-left" : "none";
                                            "border-right" : "none";
                                            "border-bottom" : "2px solid rgb(200,200,200)";
                                            "border-radius" : "0px";
                                            "background-color" : "transparent";
                                            "padding" : "8px 0px";
                                            input_theme;
                                        }
        
                                        div {
                                            "display" : "flex";
                                            "align-items" : "center";
                                            "width" : "100%";
                                            "gap" : "7px";
                                                text "Username:" {
                                                    "width" : "70px";
                                                    "font-size" : "14px";
                                                    "flex-shrink" : "0";
                                                    text_theme;
                                                }
                                                input {
                                                    "id" : "username";
                                                    "flex" : "1";
                                                    login_input_theme;
                                                }
                                        }

                                        div {
                                            "display" : "flex";
                                            "align-items" : "center";
                                            "width" : "100%";
                                            "gap" : "8px";
                                                text "Password:" {
                                                    "width" : "70px";
                                                    "font-size" : "14px";
                                                    "flex-shrink" : "0";
                                                    text_theme;
                                                }
                                                input {
                                                    "id" : "password";
                                                    "type" : "password";
                                                    "flex" : "1";
                                                    login_input_theme;
                                                }
                                        }

                                        button {
                                            "id" : "login";
                                            text "Login" {
                                                "font-size" : "14px";
                                                "color" : "white";
                                                golden_font;
                                            }
                                            "width" : "75%";
                                            wood_button_theme;
                                        }
                                    }
                                }
                                if(!user_registered) {
                                    if(is_live(user)) {
                                        script "toggle_login_card('Register',false)";
                                    }
                                }
                            }
                        }
                }
        }
    }
}



##
    global ColColCol world = deadptr;
    global Node global_reload_target = deadnode;
##


route "" {
    standard_header;
    sync_with_database;
    div page_root {
        "width" : "100%";
        "min-height" : "100vh";
        if(is_live(world)) {
            print(green("User "),user," has entered world");
            Ptr cfds = world[0]["CFDs"];
            string basic_behaviour = capture(
                string js_part ; "[ANY]"
            ){
                js_part = unescape_html(js_part);            
                cfds.do(v => {
                    if(v!=cfd) {
                        websocket_write(v,js_part);
                    }
                });
            }
            script "
                const basicBehaviour = "+js_lit(basic_behaviour)+";
                function broadcast(js_part) {
                    if(
                        !window.ws ||
                        window.ws.readyState !== WebSocket.OPEN
                    ) {
                        return;
                    }
                    eval(fill_capture(
                        basicBehaviour,
                        JSON.stringify(js_part)
                    ));
                }
                var context_selected_thing = -1;
                var selected_asset = '';
            ";


            string world_init = "const world = {};";
            world.try_read_forever_then {
                world_init+="world.CFDs = [];";
                world[0]["CFDs"].do(c => {
                    world_init+="world.CFDs.push("+to_string(c)+");";
                });
            }

                ColCol geo = world["Geo"];
                Ptr e_handles = deadptr;
                Ptr e_assets = deadptr;

                Ptr e_x     = deadptr;
                Ptr e_y     = deadptr;
                Ptr e_z     = deadptr;
                Ptr e_rot   = deadptr;
                Ptr e_scale = deadptr;

            div viewport {
                "display" : "flex";
                "width" : "100%";
                "height" : "100%";
                "overflow" : "hidden";
                "position" : "relative";
                "cursor" : "grab";
                "touch-action" : "none";
                "background-color" : "black";
                "flex-direction" : "column";

                div {
                    "id" : "world_root";
                    "position" : "absolute";
                    "left" : "0";
                    "top" : "0";
                    "transform-origin" : "0 0";
                    "z-index" : "0";
                    "width" : "100%";
                    "height" : "100%";

                    world.try_read_forever_then {
                        e_handles = geo["E_Handles"];
                        e_assets = geo["E_Assets"];

                        e_x     = geo["E_X"];
                        e_y     = geo["E_Y"];
                        e_z     = geo["E_Z"];
                        e_rot   = geo["E_Rot"];
                        e_scale = geo["E_Scale"];

                        string transform_thing_behaviour = capture(
                            string s_eid       ; "[ANY]",
                            string s_new_x     ; "[ANY]",
                            string s_new_y     ; "[ANY]",
                            string s_new_z     ; "[ANY]",
                            string s_new_rot   ; "[ANY]",
                            string s_new_scale ; "[ANY]"
                        ){
                            int eid = stoi(s_eid);
                            if(s_new_x.find(".")<0) {s_new_x+=".0";}   
                            if(s_new_y.find(".")<0) {s_new_y+=".0";}   
                            if(s_new_scale.find(".")<0) {s_new_scale+=".0";}   
                            if(s_new_rot.find(".")<0) {s_new_rot+=".0";} 
                            float new_x = stof(s_new_x);
                            float new_y = stof(s_new_y);
                            int new_z = stoi(s_new_z);
                            float new_rot = stof(s_new_rot);
                            float new_scale = stof(s_new_scale);

                            world.try_read_forever_then {
                                geo.try_read_forever_then {
                                    e_x[eid] = new_x;
                                    e_y[eid] = new_y;
                                    e_z[eid] = new_z;
                                    e_rot[eid] = new_rot;
                                    e_scale[eid] = new_scale;
                                }
                            }
                        };
                        script "
                            const transformThingBehaviour = "+js_lit(transform_thing_behaviour)+";
                            function updateAcornTransform(thing) {
                                eval(fill_capture(
                                    transformThingBehaviour,
                                    JSON.stringify(thing.i),
                                    JSON.stringify(thing.x),
                                    JSON.stringify(thing.y),
                                    JSON.stringify(thing.z),
                                    JSON.stringify(thing.rot),
                                    JSON.stringify(thing.scale)
                                ));
                            }
                        ";

                
                        world_init+="world.Things = [];";
                        for(int i=0;i<e_handles.length;i++) {
                            geo.try_read_forever_then {
                                float x     = e_x[i];
                                float y     = e_y[i];
                                int   z     = e_z[i];
                                float rot   = e_rot[i];
                                float scale = e_scale[i];

                                string ptr = capture_ptr(e_handles[i]);

                                img {
                                    "class" : "ab_entity";
                                    "src" : (e_assets[i]);
                                    "data-eidx" : to_string(i);

                                    "position" : "absolute";
                                    "left" : (to_string(x)+"px");
                                    "top" : (to_string(y)+"px");
                                    "z-index" : to_string(z);

                                    "transform-origin" : "center center";
                                    "transform" : (
                                        "rotate("+to_string(rot)+"rad) scale("+to_string(scale)+")"
                                    );

                                    "draggable" : "false";
                                    "user-select" : "none";
                                }

                                world_init += "
                                    world.Things.push({
                                        i: "+to_string(i)+",
                                        ptr: "+js_lit(ptr)+",
                                        x: "+to_string(x)+",
                                        y: "+to_string(y)+",
                                        z: "+to_string(z)+",
                                        rot: "+to_string(rot)+",
                                        scale: "+to_string(scale)+"
                                    });
                                ";
                            }
                        }
                    }
                    div {
                        "id" : "scale_handle";
                        "position" : "absolute";
                        "width" : "14px";
                        "height" : "14px";
                        "background-color" : "white";
                        "border" : "2px solid black";
                        "cursor" : "nwse-resize";
                        "z-index" : "10000";
                        "display" : "none";
                    }

                    div {
                        "id" : "rotate_handle";
                        "position" : "absolute";
                        "width" : "14px";
                        "height" : "14px";
                        "border-radius" : "50%";
                        "background-color" : "white";
                        "border" : "2px solid black";
                        "cursor" : "grab";
                        "z-index" : "10000";
                        "display" : "none";
                    }
                    div grid {
                        "position" : "absolute";
                        "left" : "0";
                        "top" : "0";
                        "width" : "2000px";
                        "height" : "2000px";
                        "pointer-events" : "none";
                        "z-index" : "1";
                    }   
                    script "
                        const grid = getel("+js_lit(capture_node(grid))+");
                    ";
                }


                input {
                    "id" : "asset_file_input";
                    "type" : "file";
                    "accept" : "image/png,image/jpeg,image/webp";
                    "display" : "none";
                    "onchange" : "
                        if(this.files.length > 0) {
                            postAsset(this.files[0]);
                            this.value = '';
                        }
                    ";
                }

                div {
                    "id" : "context_panel_flyer";
                    "position" : "absolute";
                    "right" : "30px";
                    "top" : "100px";
                    "z-index" : "15";
                    "transform" : "translateX(280px)";
                    "pointer-events" : "none";

                    div {
                        "id" : "context_panel";
                        "width" : "200px";
                        "height" : "300px";
                        "position" : "relative";
                        "data-open" : "";
                        "animation" : "context_hover 3.6s ease-in-out infinite";
                        "cursor" : "pointer";
                        "pointer-events" : "auto";
                        "touch-action" : "none";

                        "background" : "
                            repeating-linear-gradient(
                                0deg,
                                rgba(255,255,255,0.018) 0px,
                                rgba(255,255,255,0.018) 1px,
                                rgba(0,0,0,0.018) 1px,
                                rgba(0,0,0,0.018) 2px
                            ),
                            linear-gradient(
                                145deg,
                                rgb(122,128,123) 0%,
                                rgb(91,96,92) 18%,
                                rgb(70,74,71) 55%,
                                rgb(53,56,54) 100%
                            )
                        ";

                        "border-top" : "5px solid rgb(151,158,152)";
                        "border-left" : "5px solid rgb(125,132,126)";
                        "border-right" : "5px solid rgb(45,48,46)";
                        "border-bottom" : "5px solid rgb(38,41,39)";

                        "border-radius" : "2px";

                        "box-shadow" : "
                            0 14px 20px rgba(0,0,0,0.38),
                            inset 0 2px 0 rgba(255,255,255,0.12),
                            inset 0 -3px 0 rgba(0,0,0,0.20)
                        ";

                        inlined rivet_theme {
                            "position" : "absolute";
                            "width" : "8px";
                            "height" : "8px";
                            "border-radius" : "50%";
                            "class" : "rivet";
                            "background" : "
                                radial-gradient(
                                    circle at 35% 30%,
                                    rgb(190,195,190),
                                    rgb(92,97,93) 45%,
                                    rgb(43,46,44) 100%
                                )
                            ";
                            "box-shadow" : "1px 2px 2px rgba(0,0,0,0.55)";
                        }
                        div {rivet_theme; "left" : "8px"; "top" : "8px";}
                        div {rivet_theme; "right" : "8px"; "top" : "8px";}
                        div {rivet_theme; "left" : "8px"; "bottom" : "8px";}
                        div {rivet_theme; "right" : "8px"; "bottom" : "8px";}


                       div {
                            "id" : "context_panel_flare";
                            "position" : "absolute";

                            "left" : "-60%";
                            "top" : "-45%";
                            "width" : "220%";
                            "height" : "190%";

                            "z-index" : "100";
                            "pointer-events" : "none";
                            "opacity" : "0";

                            "background" : "
                                radial-gradient(
                                    ellipse at center,
                                    rgba(255,255,255,1) 0%,
                                    rgba(255,255,255,1) 28%,
                                    rgba(255,255,255,0.96) 40%,
                                    rgba(255,255,255,0.65) 52%,
                                    rgba(255,255,255,0.25) 62%,
                                    rgba(255,255,255,0.06) 70%,
                                    rgba(255,255,255,0) 76%
                                )
                            ";
                        }
                        
                        div {
                            "id" : "context_panel_contents";
                            "margin" : "18px";
                            div {
                                "id" : "context_content_options";
                                "display" : "none";
                                "flex-direction" : "column";
                                "align-items" : "center";
                                "gap" : "10px";
                                div {
                                    text "DISMISS" {"font-size" : "1.2rem"; metal_text_theme;}
                                    "onclick" : "contextPanelOut()";
                                }
                                div {
                                    text "EXIT" {"font-size" : "1.2rem"; metal_text_theme;}
                                    "onclick" : "";
                                }
                                div {
                                    text "LOGIN" {"font-size" : "1.2rem"; metal_text_theme;}
                                    "onclick" : "window.location.href = '/login'";
                                }
                                div {
                                    text "FLARE" {"font-size" : "1.2rem"; metal_text_theme;}
                                    "onclick" : "
                                       flarePanel();
                                    ";
                                }
                            }
                            div {
                                "id" : "context_content_assets";
                                "display" : "none";
                                "flex-direction" : "column";
                                "align-items" : "center";
                                "gap" : "10px";
                                div {
                                    text "DISMISS" {"font-size" : "1.2rem"; metal_text_theme;}
                                    "onclick" : "contextPanelOut()";
                                }
                                div {
                                    text "PLACE" {"font-size" : "1.2rem"; metal_text_theme;}
                                    "onclick" : capture(
                                        string mypath ; js_do("return selected_asset;");
                                    ){
                                        int eid = 0;
                                        Ptr thingptr = world["Things"].add(Ptr);
                                        Ptr asset = retrive_ptr(mypath);
                                        world.try_read_forever_then {
                                            geo.try_lock_forever_then {
                                                eid = geo["E_Handles"].length;
                                                geo["E_Handles"].push(thingptr);
                                                geo["E_X"].push(0.0);
                                                geo["E_Y"].push(0.0);
                                                geo["E_Z"].push(3);
                                                geo["E_Rot"].push(0.0);
                                                geo["E_Scale"].push(1.0);
                                                geo["E_Assets"].push(asset);
                                            }
                                        }
                                        string js = "RUN addThing("
                                            +to_string(eid)+","
                                            +js_lit(capture_ptr(thingptr))+","
                                            +js_lit(asset)+","
                                            +"0.0,"
                                            +"0.0,"
                                            +"3,"
                                            +"0.0,"
                                            +"1.0"
                                            +");";
                                        cfds.try_read_forever_then {
                                            cfds.do(ofd => {
                                                websocket_write(ofd,js);
                                            });
                                        }
                                    }
                                }
                                div {
                                    text "DELETE" {"font-size" : "1.2rem"; metal_text_theme;}
                                    "onclick" : "";
                                }
                            }
                            div {
                                "id" : "context_content_thing";
                                "display" : "none";
                                "flex-direction" : "column";
                                "align-items" : "center";
                                "gap" : "10px";
                                div {
                                    text "LOCK" {"font-size" : "1.2rem"; metal_text_theme;}
                                    "onclick" : capture(
                                        string mything ; js_do("return context_selected_thing;")
                                    ){
                                        Object thing;
                                            geo.try_read_forever_then {
                                                thing = e_handles[stoi(mything)];
                                            }
                                        string js = "RUN ";
                                        if(!thing.?locked) {
                                            thing.locked = false;
                                        }
                                        if(thing.locked) {
                                            thing.locked = false;
                                            js+="world.Things["+mything+"].locked = false;";
                                        } else {
                                            thing.locked = true;
                                            js+="world.Things["+mything+"].locked = true; selectedThing=null; updateThingHandles();";
                                        }
                                        cfds.try_read_forever_then {
                                            cfds.do(ofd => {
                                                websocket_write(ofd,js);
                                            });
                                        }    
                                    }
                                }
                                div {
                                    "width" : "100%";
                                    "display" : "flex";
                                    "flex-direction" : "row";
                                    "justify-content" : "center";
                                    "align-items" : "center";
                                    "gap" : "6px";
                                    text "Z: " {"font-size" : "1.2rem"; metal_text_theme_static;}
                                    input {
                                        "width" : "65px";
                                        "padding" : "3px 6px";
                                        "background-color" : "rgb(58,61,59)";
                                        "border" : "none";
                                        "border-radius" : "2px";
                                        "outline" : "none";
                                        "box-shadow" : "
                                            inset 2px 2px 4px rgba(0,0,0,0.65),
                                            inset -1px -1px 1px rgba(255,255,255,0.10)
                                        ";
                                        metal_text_theme;
                                        "onfocus" : "if(context_selected_thing>=0) {this.value = world.Things[context_selected_thing].z}";
                                        "onchange" : capture(
                                            string mything ; js_do("return context_selected_thing;"),
                                            string myval ; "this.value"
                                        ) {
                                            geo.try_read_forever_then {
                                                e_z[stoi(mything)] = stoi(myval);
                                            }
                                            string js = "RUN ";
                                            js+="world.Things["+mything+"].z = "+myval+"; syncThingTransform(world.Things["+mything+"]);";
                                            cfds.try_read_forever_then {
                                                cfds.do(ofd => {
                                                    websocket_write(ofd,js);
                                                });
                                            }    
                                        }
                                    }

                                }

                                div {
                                    text "DELETE" {"font-size" : "1.2rem"; metal_text_theme;}
                                    "onclick" : "";
                                }
                                div {
                                    text "DISMISS" {"font-size" : "1.2rem"; metal_text_theme;}
                                    "onclick" : "contextPanelOut(); context_selected_thing = -1;";
                                }
                            }
                        }
                    }
                }
                script "
                    const context_panel = getel('context_panel');
                    const context_panel_flyer = getel('context_panel_flyer');

                    makeDraggable(context_panel, {
                        ignore: 'button, input, textarea, select, p'
                    });
                    function flarePanel(swap) {
                        const content = getel('context_panel_contents');
                        const flare = getel('context_panel_flare');

                        content.querySelectorAll('[data-flaring]').forEach(el=>flareMetal(el));
                        context_panel.querySelectorAll('.rivet').forEach(el=>flareRivet(el));

                        setTimeout(()=>{
                            flare.animate([
                                {
                                    opacity:0,
                                    filter:'brightness(1)',
                                    offset:0
                                },
                                {
                                    opacity:.45,
                                    filter:'brightness(1.4)',
                                    offset:.22
                                },
                                {
                                    opacity:1,
                                    filter:'brightness(3.5)',
                                    offset:.45
                                },
                                {
                                    opacity:1,
                                    filter:'brightness(3.5)',
                                    offset:.78
                                },
                                {
                                    opacity:0,
                                    filter:'brightness(1)',
                                    offset:1
                                }
                            ], {
                                duration:700,
                                easing:'linear'
                            });
                            if(swap) {
                                setTimeout(swap,350);
                            }
                        },100);
                    }

                    let panelFlight = null;
                    let pendingFlight = null;
                    let panelBraking = false;
                        function panelPos() {
                            const m = new DOMMatrix(getComputedStyle(context_panel_flyer).transform);
                            return [m.m41, m.m42];
                        }
                        function movePanel(targetX, targetY, leaving=false) {
                            pendingFlight = {x:targetX, y:targetY, leaving};

                            if(panelFlight) {
                                if(!panelBraking) brakePanel();
                                return;
                            }

                            startPanelFlight();
                        }

                        function startPanelFlight() {
                            if(!pendingFlight) return;

                            const target = pendingFlight;
                            pendingFlight = null;

                            const [currentX,currentY] = panelPos();

                            panelFlight = flyPanel(
                                currentX,
                                currentY,
                                target.x,
                                target.y,
                                target.leaving
                            );
                        }
                        function brakePanel() {
                            panelBraking = true;

                            const flight = panelFlight;
                            flight.onfinish = null;

                            const start = performance.now();

                            function brake(now) {
                                const t = Math.min((now-start)/250, 1);
                                flight.playbackRate = Math.max(.03, 1-t);

                                if(t < 1) {
                                    requestAnimationFrame(brake);
                                } else {
                                    flight.pause();
                                    flight.commitStyles();
                                    flight.cancel();

                                    panelFlight = null;
                                    panelBraking = false;

                                    startPanelFlight();
                                }
                            }

                            requestAnimationFrame(brake);
                        }
                        function flyPanel(ax, ay, bx, by, leaving=false) {

                            if(!leaving) {
                                const r = context_panel.getBoundingClientRect();
                                const left = r.left - ax;
                                const top  = r.top  - ay;

                                if(left+r.width<=0 || left>=innerWidth ||
                                top+r.height<=0 || top>=innerHeight) {

                                    const x = Math.max(0,Math.min(innerWidth-r.width,left));
                                    const y = Math.max(0,Math.min(innerHeight-r.height,top));

                                    context_panel.style.left =
                                        context_panel.offsetLeft + x-left + 'px';

                                    context_panel.style.top =
                                        context_panel.offsetTop + y-top + 'px';
                                }
                            }
                            
                            const p=n=>`translate(${ax+(bx-ax)*n}px,${ay+(by-ay)*n}px)`;

                            const flight=context_panel_flyer.animate([
                                {transform:p(0)},
                                {transform:p(1)}
                            ], {
                                duration: leaving ? 1700 : 1500,
                                easing: leaving
                                    ? 'cubic-bezier(.55,.02,.85,.45)'
                                    : 'cubic-bezier(.18,.52,.24,1)',
                                fill:'forwards'
                            });

                            flight.onfinish=()=>{
                                context_panel_flyer.style.transform=p(1);
                                flight.cancel();
                                panelFlight=null;
                                startPanelFlight();
                            };

                            return flight;
                        }
                        function contextPanelIn() {
                            context_panel_flyer.style.pointerEvents='auto';
                            movePanel(0,0,false);
                        }
                        function contextPanelOut() {
                            const rect = context_panel.getBoundingClientRect();

                            let dx = rect.left + rect.width/2 - window.innerWidth/2;
                            let dy = rect.top  + rect.height/2 - window.innerHeight/2;

                            const len = Math.hypot(dx,dy) || 1;
                            dx /= len;
                            dy /= len;

                            const tx = dx < 0 ? (rect.right + 30) / -dx : (window.innerWidth - rect.left + 30) / dx;
                            const ty = dy < 0 ? (rect.bottom + 30) / -dy : (window.innerHeight - rect.top + 30) / dy;

                            const dist = Math.min(tx,ty);

                            movePanel(dx * dist,dy * dist,true);

                            context_panel_flyer.style.pointerEvents='none';
                        }
                        function selectContextPage(page_id) {
                            flarePanel(()=>{
                                Array.from(getel('context_panel_contents').children).forEach(c => {
                                    c.style.display='none';
                                });
                                getel(page_id).style.display='flex';
                            });
                        }
                ";
                

                div asset_ui {
                    "margin" : "18px";
                    "width" : "calc(100% - 36px)";
                    "position" : "relative";
                    "z-index" : "10";

                    div toolbar {
                        "width" : "100%";
                        "height" : "50px";
                        "background-color" : wood_color_L1;
                        "display" : "flex";
                        "flex-direction" : "row";
                        "padding" : "8px";
                        "align-items" : "center";
                        "justify-content" : "start";

                        button {
                            wood_button_theme;
                            text "Options";
                            "onclick" : "contextPanelIn(); selectContextPage('context_content_options');";
                        }
                        button {
                            wood_button_theme;
                            text "Walls";
                            "onclick" : "toggleWallDrawing();";
                        }
                        button {
                            wood_button_theme;
                            text "Assets";

                            "onclick" : "
                                toggleAssetPanel();
                            ";
                        }
                    }

                    div assets_panel {
                        "width" : "92%";
                        "height" : "0px";
                        "margin" : "0 auto";

                        "overflow" : "hidden";

                        "background-color" : pebble_color_D1;

                        "display" : "flex";
                        "flex-direction" : "row";
                        "align-items" : "center";
                        "justify-content" : "start";

                        "box-sizing" : "border-box";

                        "transition" : "height 0.28s cubic-bezier(.2,.8,.25,1)";

                        div assets_contents {
                            "width" : "100%";
                            "padding" : "12px";

                            "display" : "flex";
                            "flex-direction" : "column";
                            "flex-wrap" : "wrap";
                            "gap" : "8px";

                            div {
                                "width" : "100%";
                                "height" : "100%";
                                "display" : "flex";
                                "flex-direction" : "row";
                                "gap" : "5px";
                                button {
                                    wood_button_theme;
                                    text "Refresh";
                                    "onclick" : capture(
                                        js_do("toggleAssetPanel()");
                                    ){
                                        assets_contents.reload;
                                        emit_js("setTimeout(() =>{toggleAssetPanel()},300)");
                                    };
                                }

                                button {
                                    wood_button_theme;
                                    text "Upload";
                                    "onclick" : capture(js_do("getel('asset_file_input').click()")) {
                                        global_reload_target = ~&assets_contents;
                                    } 
                                }
                            }

                            div {
                                "width" : "100%";
                                "height" : "100%";
                                "display" : "flex";
                                "flex-direction" : "row";
                                "flex-wrap" : "wrap";
                                "gap" : "8px";
                                Ptr assets = user.Assets;
                                for(int i=0;i<assets.length;i++) {
                                    string assetpath = assets[i];
                                    if(file_exists(assetpath)) {
                                        img {
                                            "class" : "ab_clickable";
                                            "src" : assetpath;
                                            "width" : "100px";
                                            "height" : "100px";
                                            "cursor" : "pointer";
                                            "onclick" : "
                                                const this_asset = "+js_lit(capture_ptr(assets[i]))+"; 
                                                contextPanelIn();
                                                selectContextPage('context_content_assets');
                                                selected_asset = this_asset;
                                            ";
                                        }
                                    } else {
                                        text "FILE NOT FOUND";
                                    }
                                }
                            }
                        }
                    }


                    div asset_bottom_rail {
                        "width" : "98%";
                        "height" : "14px";
                        "margin" : "0 auto";

                        "background-color" : wood_color_L1;

                        "border-top" : "5px solid rgb(149,109,89)";
                        "border-bottom" : "5px solid rgb(52,32,26)";

                        "box-shadow" : "0 5px 6px rgba(0,0,0,0.5)";

                        "position" : "relative";
                        "z-index" : "2";
                    }

                    script "
                        function toggleAssetPanel() {
                            const panel = getel("+js_lit(capture_node(assets_panel))+");

                            if(panel.style.height !== '0px') {
                                panel.style.height =
                                    panel.scrollHeight + 'px';

                                requestAnimationFrame(() => {
                                    panel.style.height = '0px';
                                });

                                return;
                            }

                            panel.style.height = 'auto';
                            const h = panel.scrollHeight;
                            panel.style.height = '0px';

                            requestAnimationFrame(() => {
                                panel.style.height = h + 'px';
                            });
                        }
                    ";
                }


            }
            
            script "
                const viewport = getel("+js_lit(capture_node(viewport))+");
                const world_root = getel('world_root');
                window.boardView = {
                    panX: 0,
                    panY: 0,
                    scale: 1
                };
            ";
            //print("World init: ",world_init);
            script world_init;
            script read_file(project_path+"abvtt.js");
        } else {
            string ws_connect_behaviour = capture(
                string s_guestid ; "[ANY]"
            ){
                guestid = s_guestid;
                sync_with_database;

                cry("INVEST:world:worlds/world.gsu");
                print("Unit ",unit_uid," entered world ",capture_ptr(world)," with cfd ",cfd);
                Ptr cfds = world[0]["CFDs"];        
                cfds.try_lock_forever_then {
                    bool not_in = cfds.none(v => {v==cfd});
                    if(not_in) {
                        cfds.push(cfd);
                    }
                }
                ws_disconnect_function = [](){
                    print("Unit ",unit_uid," left world ",capture_ptr(world)," with cfd ",cfd);
                    world = deadptr;
                    cfds.try_lock_forever_then {
                        for(int i=0;i<cfds.length;i++) {
                            if(cfds[i]==cfd) {
                                cfds.take(i);
                                break;
                            }
                        }
                    }
                };
                ws_post_function = [](){
                    int split = request_path.find("\n");
                    if(split<=0) return;

                    string header = request_path.substr(0,split);
                    string encoded = request_path.substr(split+1);

                    int header_space = header.find(" ");

                    string kind = header.substr(0,header_space);
                    string mime = header.substr(header_space+1);

                    if(kind=="ASSET") {
                        string extension = "";
                        if(mime=="image/png") {extension = ".png";}
                        if(mime=="image/jpeg") {extension = ".jpg";}
                        if(mime=="image/webp") {extension = ".webp";}
                        if(extension.length==0) return;

                        string pathid = to_string(getidx(user))+"_"+unit_timestamp;

                        string filepath = project_path+"files/"+pathid+extension;
                        print("Uploaded an asset to ",filepath);

                        string storeptr = database["User_Assets"].add(char);
                        storeptr = filepath;
                        user.Assets.push(storeptr);

                        write_file(filepath,encoded);

                        print("Uploaded complete");
                    }

                    if(is_live(global_reload_target)) {
                        //For some reason ctx.source isn't propagating in this one specific instance, investigate later.
                        emit_reload(ctx,global_reload_target);
                    }
                };
                page_root.reload;
            };

            script "
                const wsURL = new URL(window.location.href);
                wsURL.protocol =
                wsURL.protocol === 'https:' ? 'wss:' : 'ws:';
                wsURL.hash = '';
                const ws = new WebSocket(wsURL.href);
                window.ws = ws;

                ws.onopen = () => {
                    console.log('WebSocket connected');
                    eval(fill_capture(\""+ws_connect_behaviour+"\",\""+js_lit(user.label)+"\"));
                };
                ws.onmessage = (event) => {
                    read_run_response(event.data);
                };
                ws.onclose = () => {
                    console.log('WebSocket closed');
                };
                ws.onerror = (error) => {
                    console.log('WebSocket error', error);
                };
            ";
            text "Connecting websocket";
        }
    }
}