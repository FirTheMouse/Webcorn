inlined pebble_button_theme {
    golden_font;

    "background-color" : pebble_color;
    "color" : "rgb(238, 238, 238)";
    "border" : "none";
    "border-radius" : "5px";
    "padding" : "6px 10px";
    "cursor" : "pointer";

    "transition" : "background-color 0.08s ease, transform 0.06s ease";

    "onmouseenter" : "
        this.style.backgroundColor='"+pebble_color_L1+"';
    ";

    "onmouseleave" : "
        this.style.backgroundColor='"+pebble_color+"';
        this.style.transform='scale(1)';
    ";

    "onmousedown" : "
        this.style.backgroundColor='"+pebble_color_D1+"';
        this.style.transform='scale(0.97)';
    ";

    "onmouseup" : "
        this.style.backgroundColor='"+pebble_color_L1+"';
        this.style.transform='scale(1)';
    ";
}

inlined wood_button_theme {
    golden_font;

    "background-color" : "rgb(104, 74, 61)";
    "color" : "rgb(238, 238, 238)";

    "class" : "wood_button";

    "border-top" : "7px solid rgb(149, 109, 89)";
    "border-left" : "7px solid rgb(124, 89, 73)";
    "border-right" : "7px solid rgb(52, 32, 26)";
    "border-bottom" : "7px solid rgb(52, 32, 26)";

    "font-size" : "16px";
    "text-align" : "center";
    "padding" : "2px";

    "cursor" : "pointer";
    "user-select" : "none";
    "transform-origin" : "top left";
    "transition" : "transform 0.15s steps(2, end)";
    "filter" : "brightness(0.85)";

    "onmouseenter" : "
        this.style.filter='brightness(1.0)';
    ";

    "onmousedown" : "
        clearTimeout(this._clunkTimer);

        this._clunkStart = performance.now();

        this.style.filter='brightness(1.1)';
        this.style.transform='scale(0.990)';
    ";

    "onmouseup" : "
        releaseClunk(this, 1.0);
    ";

    "onmouseleave" : "
        releaseClunk(this, 0.85);
    ";
}

inlined metal_font {
    "font-family" : "'Walter Turncoat', system-ui, sans-serif";
}   
inlined metal_text_theme_static {
    metal_font;
    "font-size" : "0.9rem";
    "color" : "gray";
    "text-shadow" : "0 1px 0 rgba(255,255,255,0.16), 0 -1px 1px rgba(0,0,0,0.75)";
    "transition" : "color 0.25s ease, text-shadow 0.25s ease";
    "-webkit-user-select" : "none";
}
inlined metal_text_theme {
    "transition" : "color 0.25s ease, text-shadow 0.25s ease";
    "data-flaring" : "0";
    "data-mousein" : "0";
    "onmouseenter" : "
        this.dataset.mousein='1';
        if(this.dataset.flaring==='1') return;

        this.style.color='rgb(220,220,215)';
        this.style.textShadow=
            '0 0 2px rgba(255,255,255,0.65), '+
            '0 0 6px rgba(255,255,255,0.25)';
    ";

    "onmouseleave" : "
        this.dataset.mousein='0';
        if(this.dataset.flaring==='1') return;

        this.style.color='gray';
        this.style.textShadow=
            '0 1px 0 rgba(255,255,255,0.16), '+
            '0 -1px 1px rgba(0,0,0,0.75)';
    ";

    "onmousedown" : "flareMetal(this);";
    metal_text_theme_static;
}
inlined hoverable_theme {
    "background-color" : transparent;
    "transition" : "background-color 0.15s ease";
    "onmouseenter" : "if(this.style.backgroundColor==='transparent')this.style.backgroundColor='rgba(0,0,0,0.04)'";
    "onmouseleave" : "if(this.style.backgroundColor==='rgba(0, 0, 0, 0.04)')this.style.backgroundColor='transparent'";
}
inlined skeleton_pulse {
    "background" : "linear-gradient(90deg, rgb(60,60,60) 25%, rgb(80,80,80) 50%, rgb(60,60,60) 75%)";
    "background-size" : "200% 100%";
    "animation" : "skeleton_pulse 1.5s infinite";
}


void standard_header {
    html '<meta name="viewport" content="width=device-width, initial-scale=1">';
    style "
        @import url('https://fonts.googleapis.com/css2?family=Short+Stack&display=swap');
        @import url('https://fonts.googleapis.com/css2?family=Walter+Turncoat&display=swap');
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        html { font-size: 17px; }
        @media (min-width: 560px) {
            html { font-size: 20px; }
        }
        @keyframes skeleton_pulse { 0% { background-position: 200% 0; } 100% { background-position: -200% 0; } }

        input:focus {
            outline: none;
            box-shadow: none;
        }

        .wood_button:focus-visible {
            outline: none;
            filter: brightness(1.08);
        }

        @keyframes context_hover {
            0% {transform: translateY(0px) rotate(-0.25deg); box-shadow: 0 14px 20px rgba(0,0,0,0.38);}
            23% {transform: translateY(-3px) rotate(0.15deg); box-shadow: 0 17px 23px rgba(0,0,0,0.34);}
            51% {transform: translateY(-5px) rotate(0.3deg); box-shadow: 0 20px 26px rgba(0,0,0,0.30);}
            76% {transform: translateY(-2px) rotate(-0.1deg); box-shadow: 0 16px 22px rgba(0,0,0,0.35);}
            100% {transform: translateY(0px) rotate(-0.25deg); box-shadow: 0 14px 20px rgba(0,0,0,0.38);}
        }
    ";
    script read_file("web/webcorn.js");
    script "
        function releaseClunk(el, brightness) {
            const elapsed =
                performance.now() - (el._clunkStart || 0);

            const wait =
                Math.max(0, 150 - elapsed);

            clearTimeout(el._clunkTimer);

            el._clunkTimer = setTimeout(() => {
                el.style.filter =
                    'brightness(' + brightness + ')';

                el.style.transform = 'scale(1)';
            }, wait);
        }

        function flareMetal(el, time=600) {
            el.dataset.flaring='1';
            el.style.filter='brightness(1.8)';
            el.style.color='white';
            el.style.textShadow=
                '0 0 2px white, '+
                '0 0 5px white, '+
                '0 0 10px rgba(255,255,255,.95), '+
                '0 0 20px rgba(255,255,255,.75), '+
                '0 0 35px rgba(255,255,255,.45)';

            setTimeout(()=>{
                el.dataset.flaring='0';
                el.style.filter='brightness(1)';

                if(el.dataset.mousein==='1') {
                    el.style.color='rgb(220,220,215)';
                    el.style.textShadow=
                        '0 0 2px rgba(255,255,255,.65), '+
                        '0 0 6px rgba(255,255,255,.25)';
                } else {
                    el.style.color='gray';
                    el.style.textShadow=
                        '0 1px 0 rgba(255,255,255,.16), '+
                        '0 -1px 1px rgba(0,0,0,.75)';
                }
            },time);
        }
        function flareRivet(el) {
            el.animate([
                {
                    filter:'brightness(1)',
                    boxShadow:'1px 2px 2px rgba(0,0,0,.55)',
                    offset:0
                },
                {
                    filter:'brightness(2.2) saturate(.5)',
                    boxShadow:
                        '0 0 3px rgba(255,255,255,.45), '+
                        '0 0 8px rgba(255,255,255,.20)',
                    offset:.25
                },
                {
                    filter:'brightness(7) saturate(0)',
                    boxShadow:
                        '0 0 3px white, '+
                        '0 0 8px rgba(255,255,255,1), '+
                        '0 0 18px rgba(255,255,255,.8), '+
                        '0 0 35px rgba(255,255,255,.45)',
                    offset:.5
                },
                {
                    filter:'brightness(4) saturate(.15)',
                    boxShadow:
                        '0 0 3px rgba(255,255,255,.9), '+
                        '0 0 12px rgba(255,255,255,.55), '+
                        '0 0 25px rgba(255,255,255,.22)',
                    offset:.68
                },

                {
                    filter:'brightness(2) saturate(.55)',
                    boxShadow:
                        '0 0 4px rgba(255,255,255,.35), '+
                        '0 0 10px rgba(255,255,255,.12)',
                    offset:.84
                },

                {
                    filter:'brightness(1) saturate(1)',
                    boxShadow:'1px 2px 2px rgba(0,0,0,.55)',
                    offset:1
                }
            ], {
                duration:1200,
                easing:'linear'
            });
        }
    ";
}



