bool reset = true;

if(reset) {
    print("Adventure Board Reseting");
    ColColCol sub = usubunits.add("web/gbn/data.gsu");
    ColCol common = sub.add("Common");
        common.add(Ptr,"sessions").clear_lock;
    ColCol users = sub.add("Users");
        users.clear_lock;
    ColCol user_assets = sub.add("User_Assets");
        user_assets.clear_lock;
    sub.save;

    ColColCol world = usubunits.add("web/gbn/worlds/world.gsu");
        world.clear_lock;
    ColCol world_common = world.add("Common");
        world_common.add(int,"CFDs").clear_lock;
    ColCol geo = world.add("Geo");
        geo.clear_lock();
        geo.add(bool,"Flags");
        geo.add(float,"Grid");
        geo.add(float,"Walls");
        geo.add(Ptr,"E_Handles");
        geo.add(float,"E_X").clear_lock;
        geo.add(float,"E_Y").clear_lock;
        geo.add(int,"E_Z").clear_lock;
        geo.add(float,"E_Rot").clear_lock;
        geo.add(float,"E_Scale").clear_lock;
        geo.add(string,"E_Assets");
    ColCol storage = world.add("Storage");
    ColCol things = world.add("Things");
        things.clear_lock;
    world.save;
} else {
    print("Loading database");
    tstart("database_load");
    ColColCol database = load_subunit("web/gbn/data.gsu");
    database.clear_lock;
        database.get("Users").clear_lock;
        database[0].get("sessions").clear_lock;
        database[0].get("CFDs").clear_lock;
    print("Database loaded in: ",tstop("database_load"));
}