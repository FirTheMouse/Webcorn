
inlined text_theme {
    "font-size" : "0.76rem";
    "font-weight" : "600";
    "color" : "rgb(80,80,80)";
    "font-family" : "system-ui, sans-serif";
}
inlined air_input_theme {
    "border" : "none";
    "border-bottom" : "2px solid rgb(200,200,200)";
    "background-color" : "transparent";
    "padding" : "0px 4px";
    text_theme;
}
inlined standard_button_theme {
    "border" : "none";
    "border-radius" : "8px";
    "padding" : "6px";
    text_theme;
}

inlined hoverable_theme {
    "background-color" : "transparent";
    "transition" : "background-color 0.15s ease";
    "onmouseenter" : "if(this.style.backgroundColor==='transparent')this.style.backgroundColor='rgba(0,0,0,0.04)'";
    "onmouseleave" : "if(this.style.backgroundColor==='rgba(0, 0, 0, 0.04)')this.style.backgroundColor='transparent'";
}
inlined skeleton_pulse {
    "background" : "linear-gradient(90deg, rgb(60,60,60) 25%, rgb(80,80,80) 50%, rgb(60,60,60) 75%)";
    "background-size" : "200% 100%";
    "animation" : "skeleton_pulse 1.5s infinite";
}

inlined popup_background_theme {
    "position" : "fixed";
    "top" : "0";
    "left" : "0";
    "width" : "100%";
    "height" : "100%";
    "background-color" : "rgba(0,0,0,0.4)";
    "z-index" : "1000";
    "display" : "flex";
    "justify-content" : "center";
    "align-items" : "center";
    "onclick" : "event.stopPropagation();";
}

inlined popup_panel_theme {
    "background-color" : "white";
    "border-radius" : "12px";
    "padding" : "24px";
    "display" : "flex";
    "flex-direction" : "column";
    "gap" : "16px";
    "align-items" : "center";
    "box-shadow" : "0 8px 32px rgba(0,0,0,0.2)";
    "onclick" : "event.stopPropagation();";
}

void standard_header {
    html '<meta name="viewport" content="width=device-width, initial-scale=1">';
    style "
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        html { font-size: 17px; }
        @media (min-width: 560px) {
            html { font-size: 20px; }
        }
        @keyframes skeleton_pulse { 0% { background-position: 200% 0; } 100% { background-position: -200% 0; } }
    ";
    script read_file("web/webcorn.js");
}

route "" {
    standard_header;
    text "Hello world" {text_theme;}
    text "How are you?";
}