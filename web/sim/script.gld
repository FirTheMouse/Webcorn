
        Ptr randcell() {
            ColCol grid = database.Grid;
            Ptr& cell = grid[randi(0,grid.length-1)][randi(0,grid[0].length-1)];
            return &cell;
        }
        global int roll_save_for(Object actor) {
            int& energy = actor.Energy;
            int saveroll = randi(0,20);
            int score = saveroll+energy;
            if(actor.UseAdrenaline) {
                energy = energy-1;
                score = score+3;
            } else {
                int injury = 0;
                score = score-injury;
            }
            return score;
        }
        global void place_in(Object tomove, Object place) {
            if(is_live(tomove.Inside)) {
                Ptr with = tomove.Inside.as(Object).With;
                if(with.has(tomove.label)) {
                    with.take(tomove.label);
                } else {
                    print(red(tomove.label," is not in ",tomove.Inside.label,"(",tomove.Inside,") as expected"));
                    print_col(with);
                }
            }
            tomove.Inside = place;
            place.With.put(tomove.label,tomove);
        }
        global void force_react_in(Object actor, Ptr place, string reactkind, int reaction_phase) {
            string placekind = place.as(ColCol).label;
            ColCol grid = database.Grid;
            ColCol actions = database.Actions;
            ColCol states = database.States;
            Object part = place;
            Object movetarget = deadptr;
            part.With.do_back(withptr => {
                Object other = withptr;
                if(cast_to_Ptr(other)!=cast_to_Ptr(actor)) {
                    if(actions.has(reactkind)) {
                        Object actee = other;
                        string acteekind = other.as(ColCol).label;
                        string acteestatekind = actee.State.label;
                        Node ttroot = compile(*actions[reactkind]);
                        execut ttroot;
                    } else {
                        print(red("Missing react kind: "),reactkind);
                    }
                }
            });
            part.Parts.do_back(subpartptr => {
                Object subpart = subpartptr;
                force_react_in(actor,subpart,reactkind,reaction_phase);
            });
        }
        global Object root_part_owner(Object part) {
            if(part.?Owner) {
                if(part.Owner.?AllParts) {
                    return part.Owner;
                } else {
                    return root_part_owner(part.Owner);
                }
            } else {
                print(red("Part ",part.label," has no owner!"));
                return deadptr;
            }
        }
        global int calculate_part_integrity(Object part) {
            if(part.?Capability) {
                int capability = part.Capability;
                int total_capeff = 0;
                part.Conditions.do(condptr => {
                    Object cond = condptr;
                    if(cond.?CapabilityEffect) {
                        int capeff = cond.CapabilityEffect;
                        // if(cond.?Kind) {
                        //     if(part.?Weakness) {
                        //         if(part.Weakness.has(cond.Kind)) {
                        //             capeff = mult_by_factor(capeff,part["Weakness"][cond.Kind]);
                        //         }
                        //     }
                        // }
                        total_capeff = total_capeff+capeff;
                    }
                });
                if(capability<0) {
                    capability = min(0,capability+total_capeff);
                } else {
                    capability = max(0,capability+total_capeff);
                }
                return capability;
            } else {
                return 0;
            }
        }
        global int tally_part_capability(Object part, Object actor) {
            if(part.?Capability) {
                int capability = part.Capability;
                int total_capeff = 0;
                int total_pain = 0;
                part.Conditions.do(condptr => {
                    Object cond = condptr;
                    if(cond.?CapabilityEffect) {
                        int capeff = cond.CapabilityEffect;
                        total_capeff = total_capeff+capeff;
                    }
                    if(cond.?Pain) {
                        if(!actor.UseAdrenaline) {
                            int pain = cond.Pain;
                            total_pain = total_pain+pain;
                        }
                    }
                });
                if(capability<0) {
                    capability = min(0,capability+total_capeff);
                } else {
                    capability = max(0,capability+total_capeff);
                }
                capability = capability-total_pain;
                part.Parts.do_back(subpartptr =>{
                    Object subpart = subpartptr;
                    capability=capability+tally_part_capability(subpart,actor);
                });
                return capability;
            } else {
                print(red(part.label," has no capability"));
                return 0;
            }
        }
        global void proc_parts(Object part, Object actor) {
            if(part.?Proc) {
                Node partroot = compile(part.Proc);
                execut partroot;
            }
            for(int i=part.Parts.length-1;i>=0;i=i-1) {
                proc_parts(part.Parts.get(i),actor);
            }
        }
        global void increase_bloodflow_part_proc(Object part, int by) {
            part.CirculateIn.do(from => {
                repeat(by) {
                    from.CirculateOut.push(part);
                }
            });
        }
        global void standard_part_proc(Object part) {
            if(part.?Conditions) {
                int healing = 0;
                part.Conditions.do(v => {
                    Object condition = v;
                    if(condition.?CapabilityEffect) {
                        int& capeff = condition.CapabilityEffect;
                        if(!condition.?Permanent) {
                            if(capeff>0) {
                                if(condition.?Heals) {
                                    healing=healing+1;
                                }
                                capeff = max(0,capeff-1);
                            }
                        }
                    }
                    if(condition.?Pain) {
                        int& pain = condition.Pain;
                        pain = max(0,pain-1);
                    }
                    if(condition.?Duration) {
                        int& duration = condition.Duration;
                        duration = max(0,duration-1);
                    }
                });
                part.Conditions.do(v => {
                    Object condition = v;
                    if(condition.?CapabilityEffect) {
                        int& capeff = condition.CapabilityEffect;
                        if(!condition.?Permanent) {
                            if(capeff<0) {
                                if(healing>0) {
                                    healing=healing-1;
                                    capeff = min(0,capeff+1);
                                }
                            }
                        }
                    }
                });

                Ptr circto = deadptr;
                if(part.?CirculateOut) {
                    circto = part.CirculateOut;
                }

                part.Conditions.do_back((v,indx) => {
                    Object condition = v;
                    string conditionkind = condition.label;
                    if(condition.?Temporary) {
                        recycle(part.Conditions.take(indx));
                    } else if(condition.?Duration) {
                        int& duration = condition.Duration;
                        if(duration==0) {
                            recycle(part.Conditions.take(indx));
                        }
                    } else if(condition.?CapabilityEffect) {
                        int& capeff = condition.CapabilityEffect;
                        if(capeff==0) {
                            if(condition.?Pain) {
                                int& pain = condition.Pain;
                                if(pain==0) {
                                    recycle(part.Conditions.take(indx));
                                }
                            } else {
                                recycle(part.Conditions.take(indx));
                            }
                        } else if(is_live(circto)) {
                            if(conditionkind=="Bloodflow") {
                                Object target = *circto;
                                target.Conditions.push(part.Conditions.take(indx));
                                setsidx(circto,getsidx(circto)+1);
                                if(getsidx(circto)>=circto.length) {
                                    setsidx(circto,0);
                                }
                            }
                        }
                    }
                });

                if(is_live(circto)) {
                    circto.do_back((v,indx)=>{
                        if((&v).celllabel.length==0) {
                            circto.take(indx);
                        }
                    });
                }
            }
        }
        global Object add_condition(Object part, string name) {
            Object condition = database.Conditions.add(Ptr);
            condition.label(name);
            part.Conditions.push(condition);
            return condition;
        }
        global Object add_injury_condition(Object part, string name, int severity, int pain) {
            Object condition = add_condition(part,name);
            condition.CapabilityEffect = -severity;
            condition.Pain = pain;
            return condition;
        }
        global Object add_resource_condition(Object part, string name, int capability_effect) {
            Object condition = add_condition(part,name);
            condition.CapabilityEffect = capability_effect;
            return condition;
        }

        global void make_sensory_condition(Object root_part, Object part, string name, Ptr& sense, int distance, int duration, string kind, int subkind) {
            int senselen = sense.length;
            if(senselen>distance) {
                Ptr& partcond = part.Conditions;
                if(partcond.has(name)) {
                    partcond.get(name).Duration = duration;
                } else {
                    //print("Propagaing ",name," to ",part.label);
                    Object condition = database.Conditions.add(Ptr);
                    condition.label(name);
                    part.Conditions.put(name,condition);
                    condition.init(
                        Duration: duration,
                        Intensity: senselen-distance, 
                        Subkind: subkind,
                        kind: sense[distance],
                    );
                    if(part.?Regions) {
                        part.Regions.do(regionptr => {
                            Object region = regionptr;
                            make_sensory_condition(root_part,region,name,sense,distance,duration,kind,subkind);
                        });
                    }
                    if(part.?Connects) {
                        part.Connects.do(partptr => {
                            Object otherpart = partptr;
                            make_sensory_condition(root_part,otherpart,name,sense,distance+1,duration,kind,subkind);
                        });
                    }
                    if(part.?Exposed) {
                        make_sensory_condition(root_part,part.Exposed.Inside,name,sense,distance+1,duration,kind,subkind);
                    }
                    if(kind=="Sound") {
                        if(part.?Inside) {
                            if(is_live(part.Inside)) {
                                make_sensory_condition(root_part,part.Inside,name,sense,distance+2,duration,kind,subkind);
                            }
                        }
                        if(part.?Touching) {
                            part.Touching.do(partptr => {
                                Object otherpart = partptr;
                                make_sensory_condition(root_part,otherpart,name,sense,distance+1,duration,kind,subkind);
                            });
                        }
                    }
                }
            }
        }
        global Object on_log_line = deadptr;

        global Object log_thing(int severity, string msg) {
            Object obj = database.Logs.Object(
                Severity: severity, 
                Children: [Object]
            );
            obj.label(msg);
            if(is_live(on_log_line)) {
                on_log_line.Children.push(obj);
            }
            return obj;
        }
        global Object log_scripted_thing(int severity, string msg, string logscript) {
            Object obj = log_thing(severity,msg);
            obj.Script = logscript;
            return obj;
        }

        global Object log_root;

        if(database.Logs.length>0) {
            log_root = database.Logs.get(0);
        } else {
            log_root = log_thing(0,"Log");
        }
        on_log_line = log_root;

        global string color_of_severity(int severity) {
            if(severity==0) { return "rgb(219, 219, 219)"; }
            else if(severity==1) { return "rgb(50, 182, 24)"; }
            else if(severity==2) { return "rgb(200,140,0)"; }
            else if(severity==3) { return "rgb(210,60,60)"; }
            else if(severity==4) { return "rgb(159, 28, 28)"; }
            else { return "rgb(145,90,180)"; }
        }
        global static Ptr Ptr scripts_to_run;

        global void step_sim {
            print("==STEPPING==");
            ColCol grid = database.Grid;
            ColCol actions = database.Actions;
            ColCol states = database.States;
            on_log_line = log_thing(0,"==TURN "+to_string(log_root.Children.length)+"==");
            Object movetarget = deadptr;

            database.Things.cells((thingname,thingptr) => {
                Object actor = thingptr;
                if(actor.?Parts) {
                    actor.Parts.do(part => {proc_parts(part,actor);});
                }
                if(actor.?State) {
                    Ptr current_state = actor.State;
                    if(is_live(current_state)) {
                        string actorkind = actor.as(ColCol).label;
                        Ptr acts = actor.Acts;
                        acts.clear;
                        Node troot = compile(*current_state);
                        execut(troot);
                    }
                }
            });
            database.Animals.cells((animalname,animalptr) => {
                Object actor = animalptr;
                string actorkind = actor.as(ColCol).label;
                Ptr cow_actions = actions;

                actor.Parts.do(part => {proc_parts(part,actor);});

                Ptr& acts = actor.Acts;
                Ptr desired_act = deadptr;
                if(acts.length==0) {
                    desired_act = actor.State;
                } else {
                    int energy = actor.Energy;
                    for(int i=0;i<10;i++) {
                        if(i<energy) {
                            acts.push(actions["move"]);
                        } else {
                            acts.push(actions["rest"]);
                        }
                    }
                    int hunger = actor.Hunger;
                    for(int i=0;i<hunger;i++) {
                        acts.push(actions["shift"]);
                    }
                    desired_act = acts.rand;
                    actor.State = desired_act;
                }
                if(is_live(desired_act)) {
                    Node troot = compile(*desired_act);
                    acts.clear;
                    execut(troot);
                } else {
                    print(red(actor.label," had a dead state"));
                }
            });
            database.People.cells((personname,personptr) => {
                Object actor = personptr;
                    actor.Parts.do(part => {proc_parts(part,actor);});
                string actorkind = actor.as(ColCol).label;
                Ptr current_state = actor.State;
                Ptr acts = actor.Acts;
                acts.clear;
                Node troot = compile(*current_state);
                execut(troot);
            });
        }
    
            global void proc_AcidReact(Object region, int repetitions) {
                Ptr string sounding; sounding.clear();
                if(repetitions==1) {
                    sounding.init(
                        "faint hissing",
                    );
                } else if(repetitions==2) {
                    sounding.init(
                        "hissing",
                        "faint hissing",
                    );
                } else if(repetitions==3) {
                    sounding.init(
                        "agressive hissing",
                        "hissing",
                        "faint hissing",
                    );
                }
                make_sensory_condition(region.Inside,region,to_string(region.label,"AcidReactSound",partid),sounding,0,1,"Sound",0);
            } 
        
            global void process_reactions(Object part) {
                ColCol recipes = database["Recipes"];
                part.Regions.do(regionptr => {
                    Object region = regionptr;
                    print("PROCESSING ",region.label);
                    print("FLUID BEFORE:");  
                    region.Fluid.cells((f,a) => {
                        print("  ",f,": ",a);
                    });
                    print("GAS BEFORE:"); 
                    region.Gas.cells((f,a) => {
                        print("  ",f,": ",a);
                    });
                    print("REACTING");
                    Ptr Ptr awaited_outputs; awaited_outputs.clear;
                    recipes.cells((reactionname,reactionptr) => {
                        Object reaction = reactionptr;
                        bool avaliable = true;
                        int repetitions = 0;
                        repeat(reaction.Rate) {
                            if(reaction.?Requires) {
                                reaction.Requires.cells((category,components) => {
                                    if(!avaliable) {break;}
                                    if(region.has(category)) {
                                        components.cells((kind,amt) => {
                                            if(!region[category].has(kind)) {
                                                avaliable = false;
                                                break;
                                            } 
                                            if(region[category][kind]<amt) {
                                                avaliable = false;
                                                break;
                                            } 
                                        });
                                        if(!avaliable) {break;}
                                    } else {
                                        avaliable = false;
                                        break;
                                    }
                                });
                            }
                            reaction.Input.cells((category,components) => {
                                if(!avaliable) {break;}
                                if(region.has(category)) {
                                    components.cells((kind,amt) => {
                                        if(!region[category].has(kind)) {
                                            avaliable = false;
                                            break;
                                        } 
                                        if(region[category][kind]<amt) {
                                            avaliable = false;
                                            break;
                                        } 
                                    });
                                    if(!avaliable) {break;}
                                } else {
                                    avaliable = false;
                                    break;
                                }
                            });
                            if(avaliable) {
                                print("Performing ",reactionname);
                                repetitions++;
                                reaction.Input.cells((category,components) => {
                                    components.cells((kind,amt) => {
                                        region[category][kind]-=amt;                            
                                    });
                                });
                                reaction.Output.cells((category,components) => {
                                    awaited_outputs.put(category,components);
                                });
                            } else {
                                break;
                            }
                        }
                        if(repetitions>0) {
                            if(reaction.?Proc) {
                                Node reactionroot = compile(reaction.Proc);
                                execut reactionroot;
                            }
                        }
                    });
                    awaited_outputs.cells((category,components) => {
                        components.cells((kind,amt) => {
                            region[category][kind]+=amt;                            
                        });
                    });
                    print("FLUID AFTER:");  
                    region.Fluid.cells((f,a) => {
                        print("  ",f,": ",a);
                    });
                    print("GAS AFTER:"); 
                    region.Gas.cells((f,a) => {
                        print("  ",f,": ",a);
                    });
                });
            }
        
            global float fluid_volume(Object region) {
                float volume = 0.0;
                region.Fluid.cells((kind,amount) => {
                    volume += amount;
                });
                return volume;
            }
            global float gas_amount(Object region) {
                float amount = 0.0;
                region.Gas.cells((kind,quantity) => {
                    amount += quantity;
                });
                return amount;
            }
            global float gas_space(Object region) {
                return max(0.001,region.Volume-fluid_volume(region));
            }
            global float pressure_at(Object region, float liquid, float gas) {
                float gasvolume = max(0.001,region.Volume-liquid);
                float gaspressure = gas/gasvolume;
                float regionstiffness = region.Stiffness;
                float compression = max(0.0,liquid-region.Volume)*regionstiffness;
                return gaspressure+compression;
            }
            global float region_pressure(Object region) {
                return pressure_at(region,fluid_volume(region),gas_amount(region));
            }
            global float connection_flow(Object connection) {
                Object from = connection.From;
                Object to = connection.To;

                float pressure_difference = region_pressure(from)-region_pressure(to);

                float diameter = connection.Size;
                float length = connection.Length;

                float viscosity = 1.0;

                return pressure_difference * diameter*diameter*diameter*diameter / (viscosity*length);
            }
            global void flow_connection(Object connection) {
                Object source = connection.From;
                Object target = connection.To;

                float flow = connection_flow(connection);

                if(flow<0.0) {
                    source = connection.To;
                    target = connection.From;
                    flow = 0.0-flow;
                }

                if(flow<=0.0) {
                    return;
                }

                float sourcefluid = fluid_volume(source);
                float sourcegas = gas_amount(source);
                float targetfluid = fluid_volume(target);
                float targetgas = gas_amount(target);

                // Gas occupies the space not filled by liquid.
                float sourcegasvolume = 0.0;
                if(sourcegas>0.0) {
                    sourcegasvolume = gas_space(source);
                }

                float mixturevolume = sourcefluid+sourcegasvolume;

                if(mixturevolume<=0.0) {
                    return;
                }

                // Proposed fraction of the source mixture to move.
                float maxfraction = min(1.0,flow/mixturevolume);

                // Find the greatest fraction that doesn't reverse
                // the pressure difference.
                float low = 0.0;
                float high = maxfraction;

                repeat(20) {
                    float fraction = (low+high)*0.5;

                    float movedfluid = sourcefluid*fraction;
                    float movedgas = sourcegas*fraction;

                    float newsourcepressure = pressure_at(source,sourcefluid-movedfluid,sourcegas-movedgas);

                    float newtargetpressure = pressure_at(target,targetfluid+movedfluid,targetgas+movedgas);

                    if(newsourcepressure>newtargetpressure) {
                        low = fraction;
                    } else {
                        high = fraction;
                    }
                }

                float fraction = low;

                if(fraction<=0.0) {
                    return;
                }

                source.Fluid.cells((kind,quantity) => {
                    float transferred = quantity*fraction;
                    quantity -= transferred;
                    target["Fluid"][kind] += transferred;
                });

                source.Gas.cells((kind,quantity) => {
                    float transferred = quantity*fraction;
                    quantity -= transferred;
                    target["Gas"][kind] += transferred;
                });
            }
            global void circulate_proc(Object part) {

                part.Regions.do(regionptr => {
                    Object region = regionptr;
                    print(" ",region.label," fluid before");
                    region.Fluid.cells((f,v) => {
                        print("  ",f,": ",v);
                    });
                    print(" ",region.label," gas before");
                    region.Gas.cells((f,v) => {
                        print("  ",f,": ",v);
                    });
                });

                tstart("FLOW TIME");
                part.Regions.do(regionptr => {
                    Object region = regionptr;
                    if(region.?Connects) {
                        region.Connects.do(connectionptr => {
                            Object connection = connectionptr;
                            if(connection.From==region) {
                                SIM_flow_connection(connection);
                            }
                        });
                    }
                });
                tstopp("FLOW TIME");

                part.Regions.do(regionptr => {
                    Object region = regionptr;
                    print(" ",region.label," fluid after");
                    region.Fluid.cells((f,v) => {
                        print("  ",f,": ",v);
                    });
                    print(" ",region.label," gas after");
                    region.Gas.cells((f,v) => {
                        print("  ",f,": ",v);
                    });
                });
            }
        
            global void move_act(Object actor, Object movetarget) {
                ColCol grid = database.Grid;
                ColCol actions = database.Actions;
                ColCol states = database.States;
                string actorkind = actor.as(ColCol).label;
                if(actor.Energy>1) {
                    if(is_live(movetarget)) {
                        string insidecalled = actor.Inside.label;
                        string targetcalled = movetarget.label;
                        log_scripted_thing(0,(actor.label)+" moved from "+insidecalled+" to "+targetcalled,"flip("+js_lit(actor.label)+",600);");
                        place_in(actor,movetarget);
                        actor["Acts"]["Move"] = actions["move"];
                        //actor.Energy = actor.Energy-1;
                    } else {
                        Object moveto = actor.Inside.Connects.rand;
                        if(is_live(moveto)) {
                            string insidecalled = actor.Inside.label;
                            string targetcalled = moveto.label;

                            log_thing(0,(actor.label)+" is leaving "+insidecalled);
                            if(actorkind=="Animals") {
                                actor.Parts.do(part => {force_react_in(actor,part,"react_animal_move",0);});
                                force_react_in(actor,actor.Inside,"react_animal_move",0);
                            }
                            log_scripted_thing(0,(actor.label)+" arrived at "+targetcalled,"flip("+js_lit(actor.label)+",600);");
                            place_in(actor,moveto);
                            actor["Acts"]["Move"] = actions["move"];
                            //actor.Energy = actor.Energy-1;
                            if(actorkind=="Animals") {
                                actor.Parts.do(part => {force_react_in(actor,part,"react_animal_move",1);});
                                force_react_in(actor,actor.Inside,"react_animal_move",1);
                            }
                        } else {
                            print(red(actor.label," attempted to move to an invalid position from ",actor.Inside.label));
                        }
                    }
                } else {
                    log_thing(0,(actor.label)+" is too tired to move");
                }
                actor["Acts"]["Rest"] = actions["rest"];
            }
          
            global void react_animal_move(Object actor, Object actee, int reaction_phase) {
                string acteekind = actee.as(ColCol).label;
                ColCol grid = database.Grid;
                ColCol actions = database.Actions;
                ColCol states = database.States;
                if(acteekind=="Animals") {

                } else {       
                    Object inside = actee.Inside;
                    string insidekind = root_part_owner(inside).as(ColCol).label;          
                    if(insidekind=="Maps") {
                        int margin = roll_save_for(actee)-10;
                        if(reaction_phase==0) {
                            if(margin>=0) {
                                log_scripted_thing(2,(actee.label)+" dodged out of the way of "+(actor.label)+"'s hoof","getel("+js_lit(actee.label)+").style.color = 'green';");
                            } else if(margin>=-5) {
                                log_scripted_thing(3,(actee.label)+" was hit by "+(actor.label)+"'s hoof, knocking them to the ground","getel("+js_lit(actee.label)+").style.color = 'red';");
                                actee["Acts"]["Get up"] = actions["recover"];
                                actee.State = states[acteekind]["impacted"];
                                actee.Injury = actee.Injury+1;
                            } else {
                                log_scripted_thing(4,(actee.label)+" was struck by "+(actor.label)+"'s hoof, causing serious injury","getel("+js_lit(actee.label)+").style.color = 'red';");
                                actee["Acts"]["Struggle"] = actions["recover"];
                                actee.State = states[acteekind]["impacted"];
                                actee.Injury = actee.Injury+3;
                            }
                        } else {
                            if(margin>=0) {
                                log_scripted_thing(2,(actee.label)+" dodged out of the way of "+(actor.label)+"'s hoof as it landed","getel("+js_lit(actee.label)+").style.color = 'green';");
                            } else if(margin>=-2) {
                                log_scripted_thing(3,(actee.label)+" was thrown back by "+(actor.label)+"'s hoof as it landed","getel("+js_lit(actee.label)+").style.color = 'red';");
                                actee["Acts"]["Get up"] = actions["recover"];
                                actee.State = states[acteekind]["impacted"];
                            } else {
                                log_scripted_thing(4,(actee.label)+" was pinned beneath "+(actor.label)+"'s hoof","getel("+js_lit(actee.label)+").style.color = 'red';");
                                actee["Acts"]["Struggle"] = actions["recover"];
                                actee.State = states[acteekind]["impacted"];
                                setsidx(actee.State,1);
                                place_in(actee,actor.Parts.Leg);
                            }
                        }
                    } else {
                        int luckroll = randi(0,8);
                        if(reaction_phase==0) {
                            if(luckroll>getsidx(actee.State)) {
                                log_thing(1,(actee.label)+" was left behind as "+(actor.label)+" moved");
                                place_in(actee,actor.Inside);
                                setsidx(actee.State,0);
                            }
                        } else {
                            luckroll = luckroll-3;
                            if(luckroll>getsidx(actee.State)) {
                                log_thing(1,(actee.label)+" was flung from "+(actor.label)+"'s hoof while it was moving");
                                place_in(actee,actor.Inside);
                                setsidx(actee.State,0);
                                actee.Injury = actee.Injury+1;
                            } else {
                                log_thing(3,(actee.label)+" is crushed further beneath "+(actor.label)+"'s hoof as it lands");
                                setsidx(actee.State,min(getsidx(actee.State)+1,actee.State.length-1));
                                actee["Acts"]["Struggle"] = actions["recover"];
                                actee.Injury = actee.Injury+3;
                            }
                        }
                    }
                }
            }
            