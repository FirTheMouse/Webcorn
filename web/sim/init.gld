                appleflesh.Weakness = things.add(float).init(
                    Acid: 4,
                    Pressure: 1.5,
                );
                cover_part(appleskin,appleflesh);
            Object applecore = add_part(apple,"Core");
                applecore.Capability = 32;
                applecore.Weakness = things.add(float).init(
                    Acid: 0.25,
                    Pressure: 0.5,
                );
                cover_part(appleflesh,applecore);
        }
        make_apple(0);
