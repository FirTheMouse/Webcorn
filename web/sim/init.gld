    ColCol partstore = sub.add("Parts");
        Object part_registry_target = deadptr;
        Object add_structural_part(Object owner, string name) {
            Object part = partstore.Object(
                Conditions: [Object],
                With: [Object],
                Parts: [Object],
                Owner: owner,
            );
            part.label(name);
            owner.Parts.put(name, part);
            if(is_live(part_registry_target)) {
                part_registry_target.AllParts.put(name,part);
                part_registry_target.AllPartsAndRegions.put(name,part);
            }
            return part;
        }
        Object add_region(Object owner, string name) {
            Object part = partstore.Object(
                Conditions: [Object],
                With: [Object],
                Owner: owner,
                Fluid: [float],
                Gas: [float],
                Suspended: [float],
            );
            part.label(name);
            if(!owner.?Regions) {owner.Regions = partstore.add(Object);}
            owner.Regions.put(name, part);
            if(is_live(part_registry_target)) {
                part_registry_target.AllPartsAndRegions.put(name,part);
            }
            return part;
        }
        Object add_part(Object owner, string name) {
            Object part = partstore.Object(
                Injury: 0,
                Capability: 0,
                Conditions: [Object],
                With: [Object],
                Parts: [Object],
                Covers: [Object],
                Owner: owner,
                Inside: deadobj,
                //Proc: `standard_part_proc(part)`
            );
            part.label(name);
            owner.Parts.put(name, part);
            if(is_live(part_registry_target)) {
                part_registry_target.AllParts.put(name,part);
                part_registry_target.AllPartsAndRegions.put(name,part);
            }
            return part;
        }
        void cover_part(Object outer, Object inner) {
            outer.Covers.put(inner.label, inner);
            inner.Inside = outer;
        }
        void connect_part(Object from, Object to, float size) {
            Object connection = partstore.Object(
                From: from,
                To: to,
                Size: size,
                Length: 1.0,
            );
            //This ordering can not be changed without changing SIM_flow_connection
            if(!from.?Connects) {from.Connects = partstore.add(Object);}
            if(!to.?Connects) {to.Connects = partstore.add(Object);}
            from.Connects.push(connection);
            to.Connects.push(connection);
        }
        void circulate_part(Object from, Object to) {
            if(!from.Regions.has("CirculateRegion")) {add_region(from,"CirculateRegion");}
            if(!to.Regions.has("CirculateRegion")) {add_region(to,"CirculateRegion");}
            connect_part(from.Regions.CirculateRegion,to.Regions.CirculateRegion,0.5);
        }
        scriptcode.append(`
            global void circulate_proc(Object part) {

                part.Regions.do(regionptr => {
                    Object region = regionptr;
                    print(" ",region.label," fluid before");
                    region.Fluid.cells((f,v) => {
                        print("  ",f,": ",v);
                    });
                    print(" ",region.label," gas before");
                    region.Gas.cells((f,v) => {
                        print("  ",f,": ",v);
                    });
                });

                part.Regions.do(regionptr => {
                    Object region = regionptr;
                    if(region.?Connects) {
                        region.Connects.do(connectionptr => {
                            Object connection = connectionptr;
                            if(connection.From==region) {
                                SIM_flow_connection(connection);
                            }
                        });
                    }
                });

                part.Regions.do(regionptr => {
                    Object region = regionptr;
                    print(" ",region.label," fluid after");
                    region.Fluid.cells((f,v) => {
                        print("  ",f,": ",v);
                    });
                    print(" ",region.label," gas after");
                    region.Gas.cells((f,v) => {
                        print("  ",f,": ",v);
                    });
                });
            }
        `);
        void expose_part(Object part, Object actor) {
            part.Exposed = actor;
            if(!actor.?ExposedParts) {actor.ExposedParts = actor.as(ColCol).add(Object);}
            actor.ExposedParts.put(part.label,part);
        }
        void touch_part(Object from, Object to) {
            if(!from.?Touching) {from.Touching = partstore.add(Object);}
            if(!to.?Touching) {to.Touching = partstore.add(Object);}
            from.Touching.put(to.label, to);
            to.Touching.put(from.label, from);
        }
        void offset_part_from_owner(Object part, int xoff, int yoff)  {
            int ox = part.Owner.X;
            int oy = part.Owner.Y;
            part.X = ox+xoff;
            part.Y = oy+yoff;
        }
