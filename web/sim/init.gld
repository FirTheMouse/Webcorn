        Object thebox = things.Object(
            X: 10,
            Y: randi(10,75),
            Scale: 10,
            TokenImg: project_path+"files/Green.webp",
            With: [Object],
            Parts: [Object],
            AllParts: [Object],
            AllPartsAndRegions: [Object],
            Inside: deadobj,
        ).register(to_string("thebox"));
        Object boxprocessor = add_part(thebox,"Processor");
            Object chamberOne = add_region(boxprocessor,"ChamberOne");
                chamberOne.Volume = 10.0;
                chamberOne.Stiffness = 1.0;
                chamberOne.Fluid.init(
                    Water: 5.0
                );
                chamberOne.Gas.init(
                    Oxygen: 8.0,
                    CO2: 2.0
                );

            Object chamberTwo = add_region(boxprocessor,"ChamberTwo");
                chamberTwo.Volume = 10.0;
                chamberTwo.Stiffness = 1.0;
                chamberTwo.Gas.init(
                    Oxygen: 0.0,
                    CO2: 0.0
                );

            connect_part(chamberOne,chamberTwo,1.5);
        boxprocessor.Proc = `circulate_proc(part);`;
        //boxprocessor.Proc = `process_reactions(part);`;
        

    ColCol animals = sub.add("Animals");
        int r_num = 0;
        //randi(3,6);
        for(int i=0;i<r_num;i++) {
            Object animal = animals.Object(
                X: 10,
                Y: randi(10,75),
                Scale: 50,
                TokenImg: project_path+"files/Animals.webp",
                AnatomyImg: project_path+"files/Animals_Anatomy.webp",
                Energy: randi(0,5),
                Hunger: randi(0,10),
                With: [Object],
                Acts: [Ptr],
                Parts: [Object],
                AllParts: [Object],
                AllPartsAndRegions: [Object],
                Inside: deadobj,
            ).register("Cow_"+to_string(i));
            animal.State = deadptr;
                part_registry_target = animal;
                Object legpart = add_part(animal,"Leg");
                    Object forehoof = add_part(legpart,"Forehoof");
                    Object forehoof = add_part(legpart,"Hindhoof");
        }
    ColCol people = sub.add("People");
        void create_human_leg(Object pelvis, string side) {
            Object thigh = add_part(pelvis, side+"Thigh");
            Object shin = add_part(thigh, side+"Shin");
            Object foot = add_part(shin, side+"Foot");

            connect_part(pelvis,thigh,1.0);
            connect_part(thigh,shin,1.0);
            connect_part(shin,foot,1.0);

            circulate_part(pelvis,thigh);
            circulate_part(thigh,shin);
            circulate_part(shin,foot);
        }
        void create_human_arm(Object shoulder, string side) {
            Object upper = add_part(shoulder, side+"UpperArm");
            Object lower = add_part(upper, side+"LowerArm");
            Object hand = add_part(lower, side+"Hand");

            connect_part(shoulder,upper,1.0);
            connect_part(upper,lower,1.0);
            connect_part(lower,hand,1.0);

            circulate_part(shoulder,upper);
            circulate_part(upper,lower);
            circulate_part(lower,hand);
        }
        for(int i=0;i<0;i++) {
            Object person = people.Object(
                X: 10,
                Y: randi(10,75),
                Scale: 10,
                TokenImg: project_path+"files/People.webp",
                AnatomyImg: project_path+"files/People_Anatomy.webp",
                Energy: 3,
                Hunger: 0,
                Injury: 0,
                UseAdrenaline: false,
                With: [Object],
                Acts: [Ptr],
                Parts: [Object],
                AllParts: [Object],
                AllPartsAndRegions: [Object],
                Inside: deadobj,
                ShowAnatomy: false,
            ).register("Person_"+to_string(i));
            person.State = deadptr;

            part_registry_target = person;

            Object chest = add_part(person, "Chest");
                chest.Capability = 120;
                Object leftshoulder = add_part(chest, "LeftShoulder");
                    connect_part(chest,leftshoulder,1.0);
                    circulate_part(chest,leftshoulder);
                    create_human_arm(leftshoulder, "Left");
                Object rightshoulder = add_part(chest, "RightShoulder");
                    connect_part(chest,rightshoulder,1.0);
                    circulate_part(chest,rightshoulder);
                    create_human_arm(rightshoulder, "Right");

                Object heart = add_part(chest, "Heart");
                    cover_part(chest, heart);
                    heart.Proc = `human_heart_proc(part,actor);`;
                    if(i==0) {
                        scriptcode.append(`
                            global void human_heart_proc(Object part,Object actor) {
                                int capability = tally_part_capability(part,actor);
                                if(capability>0) {
                                    repeat(capability) {
                                        Object cond = add_resource_condition(part,"Bloodflow",3);
                                        cond.Heals = true;
                                    }
                                }
                                standard_part_proc(part);
                            }
                        `);
                    }
                    circulate_part(heart,chest);
                Object lungs = add_part(chest, "Lungs");
                    cover_part(chest, lungs);
                    lungs.Suppourts = partstore.add(Object).init(heart);
                    lungs.Proc = `
                        int capability = tally_part_capability(part,actor); 
                        if(capability>0) {
                            part.Suppourts.do(subpart => {
                                add_resource_condition(subpart,"Oxygen",capability);
                            });
                        }
                        standard_part_proc(part); 
                    `;

            Object belly = add_part(chest, "Belly");
                expose_part(belly,person);
                connect_part(chest,belly,1.0);
                circulate_part(chest,belly);
                Object liver = add_part(belly, "Liver");
                    circulate_part(belly,liver);
                    cover_part(belly, liver);
                Object kidneys = add_part(belly, "Kidneys");
                    circulate_part(belly,kidneys);
                    cover_part(belly, kidneys);

            Object pelvis = add_part(belly, "Pelvis");
                connect_part(belly,pelvis,1.0);
                circulate_part(belly,pelvis);
                create_human_leg(pelvis, "Left");
                create_human_leg(pelvis, "Right");

            Object neck = add_part(chest, "Neck");
                connect_part(chest,neck,1.0);
            Object head = add_part(neck, "Head");
                connect_part(neck,head,1.0);

            Object brain = add_part(head, "Brain");
                cover_part(head,brain);
            Object face = add_part(head, "Face");
                connect_part(neck,face,1.0);
                connect_part(head,face,1.0);

            Object eyes = add_part(face, "Eyes");
                connect_part(face,eyes,1.0);
            Object nose = add_part(face, "Nose");   
                connect_part(face,nose,1.0);
            Object ears = add_part(face, "Ears");
                connect_part(face,ears,1.0);

            Object mouth = add_part(face, "Mouth");
                connect_part(face,mouth,1.0);
                mouth.Capability = 2;
                mouth.Suppourts = partstore.add(Object).init(lungs);
                mouth.Proc = `
                    int capability = tally_part_capability(part,actor);
                    if(capability>0) {
                        part.Suppourts.do(subpart => {
                            add_resource_condition(subpart,"Airflow",capability);
                        });
                    }
                    standard_part_proc(part);  
                `;
            Object throat = add_part(neck, "Throat");
                connect_part(mouth,throat,1.0);
                cover_part(neck, throat);
            Object stomach = add_part(belly, "Stomach");
                connect_part(throat,stomach,1.0);
                cover_part(belly, stomach);
                touch_part(heart,stomach);
                stomach.Capability = 0;
                stomach.Timers = stomach.as(ColCol).add(int);
                stomach.Proc = `human_stomach_proc(part,actor);`;
                if(i==0) {
                    scriptcode.append(`
                        void digest_content(Object content, Object region) {
                            int contentcap = calculate_part_integrity(content);
                            if(contentcap<=0) {
                                if(content.?Covers) {
                                    content.Covers.do(coveredptr => {
                                        Object covered = coveredptr;
                                        digest_content(covered,region);
                                    });
                                }
                            } else {
                                Object injury = add_injury_condition(content,"Acid",region.AcidLevel,region.AcidLevel);
                                injury.Kind = "Acid";
                                if(calculate_part_integrity(content)<=0) {
                                    Ptr string sounding; sounding.clear();
                                    sounding.init(
                                        "agressive hissing",
                                        "faint agressive hissing",
                                    );
                                    make_sensory_condition(region.Inside,region,to_string(region.label,"AcidSuccess",partid),sounding,0,1,"Sound",0);
                                }
                            }
                        }
                        void squeeze_content(Object content, Object region) {
                            int contentcap = calculate_part_integrity(content);
                            if(contentcap<=0) {
                                if(content.?Covers) {
                                    content.Covers.do(coveredptr => {
                                        Object covered = coveredptr;
                                        squeeze_content(covered,region);
                                    });
                                }
                            } else {
                                int strength = randi(0,12);
                                Object injury = add_injury_condition(content,"Squeeze",strength,strength);
                                injury.Kind = "Preasure";
                                if(calculate_part_integrity(content)<=0) {
                                    Ptr string sounding; sounding.clear();
                                    sounding.init(
                                        "wet crunch",
                                        "faint crunch",
                                    );
                                    make_sensory_condition(region.Inside,region,to_string(region.label,"SqueezeSuccess",partid),sounding,0,1,"Sound",0);
                                } else {
                                    string squeezelabel = to_string(region.label,"SqueezeFail",partid);
                                    int crowd = region.With.length;
                                    Ptr string sounding; sounding.clear();
                                    if(crowd==1) {
                                        sounding.init(
                                            "wet squish",
                                            "faint squish",
                                        );
                                    } else if(crowd==2) {
                                        sounding.init(
                                            "wet squishes",
                                            "faint squishes",
                                        );
                                    } else {
                                        sounding.init(
                                            "may wet squishes",
                                            "a lot of faint squishes",
                                            "faint squishing",
                                        );
                                    }
                                    make_sensory_condition(region.Inside,region,squeezelabel,sounding,0,1,"Sound",0);
                                }
                            }
                        }

                        global void human_stomach_proc(Object part, Object actor) {
                            part.With.do(withptr => {
                                Object content = withptr;
                            });

                            string partid = to_string("-",actor.label,"-",getidx(part));

                            standard_part_proc(part);

                            Object fundus = part.Regions.Fundus;
                                standard_part_proc(fundus);
                            Object corpus = part.Regions.Corpus;
                                standard_part_proc(corpus);
                            Object antrum = part.Regions.Antrum;
                                standard_part_proc(antrum);  

                            int& acidtimer = part["Timers"]["Acid"];
                            if(acidtimer>0) {
                                acidtimer = acidtimer-1;
                            } else {
                                Ptr string sounding; sounding.clear();
                                sounding.init("faint hiss",);
                                if(antrum.AcidLevel>3) {
                                    if(corpus.AcidLevel>3) {
                                        if(fundus.AcidLevel<2) {
                                            fundus.AcidLevel = fundus.AcidLevel+1;
                                            make_sensory_condition(part,fundus,"AcidRelease"+partid,sounding,0,1,"Sound",0);
                                        }
                                    } else {
                                        corpus.AcidLevel = corpus.AcidLevel+1;
                                        make_sensory_condition(part,corpus,"AcidRelease"+partid,sounding,0,1,"Sound",0);
                                    }
                                } else {
                                    antrum.AcidLevel = antrum.AcidLevel+1;
                                    make_sensory_condition(part,antrum,"AcidRelease"+partid,sounding,0,1,"Sound",0);
                                }
                                acidtimer = 2;
                            }      

                            part.Regions.do(regionptr => {
                                Object region = regionptr;
                                string regionname = region.label;
                                if(regionname=="Antrum") {
                                    int& churntimer = part["Timers"][regionname+"Churn"];
                                    if(churntimer>0) {
                                        churntimer = churntimer-1;
                                    } else {
                                        region.With.do(withptr => {
                                            Object content = withptr.as(Object).Parts.get(0);
                                            squeeze_content(content,region);
                                        });
                                        Ptr string sounding; sounding.clear();
                                        sounding.init(
                                            "wet churning nearby",
                                            "faint churning in the distance",
                                        );
                                        make_sensory_condition(part,region,regionname+"Churning"+partid,sounding,0,1,"Sound",0);
                                        churntimer = 3;
                                    } 
                                } else if(regionname=="Corpus") {
                                    int& churntimer = part["Timers"][regionname+"Churn"];
                                    if(churntimer>0) {
                                        churntimer = churntimer-1;
                                    } else {
                                        int strength = randi(0,6);
                                        region.With.do_back(withptr => {
                                            Object content = withptr.as(Object).Parts.get(0);
                                            int resistance = randi(0,6)+1;
                                            if(strength>resistance) {
                                                log_scripted_thing(0,to_string(withptr.label," was squeezed into the antrum"),"flip("+js_lit(withptr.label)+",2000);");
                                                place_in(withptr,antrum);
                                                Ptr string sounding; sounding.clear();
                                                sounding.init(
                                                    "wet sliding",
                                                    "faint sliding",
                                                );
                                                make_sensory_condition(part,region,regionname+"ChurningSuccess"+partid,sounding,0,1,"Sound",0);
                                            }
                                        });
                                        if(true) {
                                            Ptr string sounding; sounding.clear();
                                            sounding.init(
                                                "wet squicks",
                                                "faint squicks",
                                            );
                                            make_sensory_condition(part,region,regionname+"Churning"+partid,sounding,0,1,"Sound",0);
                                        }
                                        churntimer = 2;
                                    } 
                                }
                                region.With.do(withptr => {
                                    Object content = withptr.as(Object).Parts.get(0);
                                    if(region.AcidLevel>0) {
                                        digest_content(content,region);
                                    }
                                });
                            });                  
                        }
                    `);
                }
                Object fundus = add_region(stomach,"Fundus");
                    fundus.AcidLevel = 0;
                    cover_part(stomach,fundus);
                Object corpus = add_region(stomach,"Corpus");
                    corpus.AcidLevel = 0;
                    connect_part(fundus,corpus,1.0);
                    cover_part(stomach,corpus);
                Object antrum = add_region(stomach,"Antrum");
                    antrum.AcidLevel = 0;
                    connect_part(corpus,antrum,1.0);
                    cover_part(stomach,antrum);
                Object lower_throat = add_region(throat,"LowerThroat");
                    connect_part(fundus,lower_throat,1.0);
                    cover_part(neck,lower_throat);
                Object upper_throat = add_region(throat,"UpperThroat");
                    connect_part(lower_throat,upper_throat,1.0);
                    cover_part(neck,upper_throat);
            Object intestines = add_part(belly, "Intestines");
                connect_part(stomach,intestines,1.0);
                cover_part(belly, intestines);

            Object part = deadptr;
            Object actor = person;
            part = actor["AllParts"]["Chest"]; part.X = 51; part.Y = 20;
            part = actor["AllParts"]["Pelvis"]; part.X = 50; part.Y = 47;
            part = actor["AllParts"]["LeftThigh"]; part.X = 45; part.Y = 50;
            part = actor["AllParts"]["LeftShin"]; part.X = 44; part.Y = 75;
            part = actor["AllParts"]["LeftFoot"]; part.X = 44; part.Y = 90;
            part = actor["AllParts"]["RightThigh"]; part.X = 55; part.Y = 50;
            part = actor["AllParts"]["RightShin"]; part.X = 56; part.Y = 75;
            part = actor["AllParts"]["RightFoot"]; part.X = 56; part.Y = 90;
            part = actor["AllParts"]["LeftShoulder"]; part.X = 44; part.Y = 19;
            part = actor["AllParts"]["LeftUpperArm"]; part.X = 41; part.Y = 28;
            part = actor["AllParts"]["LeftLowerArm"]; part.X = 37; part.Y = 39;
            part = actor["AllParts"]["LeftHand"]; part.X = 33; part.Y = 47;
            part = actor["AllParts"]["RightShoulder"]; part.X = 58; part.Y = 20;
            part = actor["AllParts"]["RightUpperArm"]; part.X = 60; part.Y = 27;
            part = actor["AllParts"]["RightLowerArm"]; part.X = 64; part.Y = 37;
            part = actor["AllParts"]["RightHand"]; part.X = 67; part.Y = 46;
            part = actor["AllParts"]["Heart"]; part.X = 51; part.Y = 27;
            part = actor["AllParts"]["Lungs"]; part.X = 51; part.Y = 23;
            part = actor["AllParts"]["Belly"]; part.X = 50; part.Y = 40;
            part = actor["AllParts"]["Liver"]; part.X = 47; part.Y = 32;
            part = actor["AllParts"]["Kidneys"]; part.X = 51; part.Y = 44;
            part = actor["AllParts"]["Neck"]; part.X = 51; part.Y = 17;
            part = actor["AllParts"]["Head"]; part.X = 50; part.Y = 11;
            part = actor["AllParts"]["Brain"]; part.X = 49; part.Y = 9;
            part = actor["AllParts"]["Face"]; part.X = 52; part.Y = 12;
            part = actor["AllParts"]["Eyes"]; part.X = 53; part.Y = 11;
            part = actor["AllParts"]["Nose"]; part.X = 55; part.Y = 12;
            part = actor["AllParts"]["Mouth"]; part.X = 54; part.Y = 14;
            part = actor["AllParts"]["Throat"]; part.X = 53; part.Y = 16;
            part = actor["AllParts"]["Stomach"]; part.X = 52; part.Y = 34;
                    offset_part_from_owner(fundus,2,0-1);
                    offset_part_from_owner(corpus,0,1);
                    offset_part_from_owner(antrum,0-2,2);
                    offset_part_from_owner(lower_throat,0,2);
                    offset_part_from_owner(upper_throat,0,0-1);
            part = actor["AllParts"]["Intestines"]; part.X = 54; part.Y = 40;
        }
    part_registry_target = deadptr;
    ColCol grid = sub.add("Grid");
    ColCol gridstore = sub.add("GridStore");
        int grid_x = 3;
        int grid_y = 3;
        for(int c=0;c<grid_y;c++) {
            Ptr gridcol = grid.add(Object);
            for(int r=0;r<grid_x;r++) {
                Object gridcell  = gridstore.Object(
                    Parts: [Object],
                    With: [Object],
                    Conditions: [Object],
                    Proc: `standard_part_proc(part);`,
                );
                gridcell.label(to_string(r)+"-"+to_string(c));
                gridcol.push(gridcell);
                gridcell.Gridpos = gridcol|S=r;
            }
        }
    ColCol maps = sub.add("Maps");
        Object pasture = maps.Object(
            AnatomyImg: project_path+"files/Pasture.jpg",
            With: [Object],
            Parts: [Object],
            AllParts: [Object],
            AllPartsAndRegions: [Object],
        ).register("MainPasture");

        int pasture_scale = 3;

        part_registry_target = pasture;

        for(int c=0;c<pasture_scale;c++) {
            for(int r=0;r<pasture_scale;r++) {
                Object cell = add_structural_part(pasture,to_string(r)+"-"+to_string(c));

                //3
                // cell.X = (16+r*33);
                // cell.Y = (16+c*33);
                //10
                // cell.X = (5+r*10);
                // cell.Y = (5+c*10);
                cell.X = (16+r*33);
                cell.Y = (16+c*33);
                if(r>0) {
                    Object left = pasture["AllParts"][to_string(r-1)+"-"+to_string(c)];
                    connect_part(cell,left,1.0);
                    if(c>0) {
                        Object leftabove = pasture["AllParts"][to_string(r-1)+"-"+to_string(c-1)];
                        connect_part(cell,leftabove,1.0);
                    }
                }
                if(c>0) {
                    Object above = pasture["AllParts"][to_string(r)+"-"+to_string(c-1)];
                    connect_part(cell,above,1.0);
                    if(r<(pasture_scale-1)) {
                        Object aboveleft = pasture["AllParts"][to_string(r+1)+"-"+to_string(c-1)];
                        connect_part(cell,aboveleft,1.0);
                    }
                }
            }
        }

        animals.cells((k,v) => {
            Object cell = pasture["AllParts"][to_string(randi(0,pasture_scale-1))+"-"+to_string(randi(0,pasture_scale-1))];
            cell.With.put(k,v);
            v.as(Object).Inside = cell;
        });
        people.cells((k,v) => {
            Object cell = pasture["AllParts"][to_string(randi(0,pasture_scale-1))+"-"+to_string(randi(0,pasture_scale-1))];
            cell.With.put(k,v);
            v.as(Object).Inside = cell;
        });
        if(true) {
            Object cell = pasture["AllParts"][to_string(randi(0,pasture_scale-1))+"-"+to_string(randi(0,pasture_scale-1))];
            cell.With.put("thebox",thebox);
            thebox.Inside = cell;
        }


    ColCol states = sub.add("States");

    ColCol actions = sub.add("Actions");
       actions.add(string,"recover").init(
            `
                string statelabel = actor.State.label;
                int& energy = actor.Energy;
                int& injury = actor.Injury;
                int step = getsidx(actor.State);
                bool stuck = is_live(actor.Inside);
                string carrier = "";
                if(stuck) {
                    Object inside = actor.Inside;
                    carrier = inside.label;
                }


                int score = roll_save_for(actor);
                int stepfactor = step*3;
                score = score-stepfactor;
                int margin = score - 10;

                if(margin>=0) {
                    if(step==0) {
                        log_thing(1,(actor.label)+" is getting  up");
                        actor.State = states[actor.as(ColCol).label]["recovering"];
                        acts["Rest"] = actions["rest"];
                        acts["Move"] = actions["move"];
                    } else {
                        if(margin>=8) {
                            log_thing(1,(actor.label)+" greatly improved their situation in "+statelabel);
                            setsidx(actor.State,max(step-2,0));
                        } else {
                            log_thing(1,(actor.label)+" improved their situation in "+statelabel);
                            setsidx(actor.State,max(step-1,0));
                        }
                    }
                } else if(margin>=-5) {
                    log_thing(2,(actor.label)+" struggled without gaining any ground");
                } else {
                    injury = injury+1;
                    log_thing(3,(actor.label)+" slipped and made it worse");
                }
                energy = energy-1;
            `
        );
        actions.add(string,"nothing").init(
            `
                int rand_num = randi(0,2);
                if(rand_num==0) {
                    log_thing(0,(actor.label)+" did nothing");
                } else if(rand_num==1) {
                    log_thing(0,(actor.label)+" stared at the sky");
                } else if(rand_num==2) {
                    log_thing(0,(actor.label)+" daydreamed");
                }
                actor.State = states[actor.as(ColCol).label]["nothing"];
            `
        );
        actions.add(string,"rest").init(
            `
                if(actorkind=="People") {
                    random(
                        log_thing(0,(actor.label)+" sat down");
                        log_thing(0,(actor.label)+" laid down");
                        log_thing(0,(actor.label)+" crouched");
                    );
                } else if(actorkind=="Animals") {
                    random(
                        log_thing(0,(actor.label)+" folded their legs");
                        log_thing(0,(actor.label)+" thumped down");
                        log_thing(0,(actor.label)+" lowered onto their belly");
                    );
                } else {
                    log_thing(0,(actor.label)+" rested");
                }
                actor.State = states[actorkind]["resting"];
            `
        );
        actions.add(string,"shift").init(
            `
                actor.X = min(max(actor.X+(randi(0,20)-10),0),45);
                actor.Y = min(max(actor.Y+(randi(0,20)-10),0),75);
                log_scripted_thing(0,(actor.label)+" shifted","flip("+js_lit(actor.label)+",300);");
                acts.push(actions["shift"]);
            `
        );
        
        actions.add(string,"move").init("move_act(actor,movetarget);");
        scriptcode.append(`
            global void move_act(Object actor, Object movetarget) {
                ColCol grid = database.Grid;
                ColCol actions = database.Actions;
                ColCol states = database.States;
                string actorkind = actor.as(ColCol).label;
                if(actor.Energy>1) {
                    if(is_live(movetarget)) {
                        string insidecalled = actor.Inside.label;
                        string targetcalled = movetarget.label;
                        log_scripted_thing(0,(actor.label)+" moved from "+insidecalled+" to "+targetcalled,"flip("+js_lit(actor.label)+",600);");
                        place_in(actor,movetarget);
                        actor["Acts"]["Move"] = actions["move"];
                        //actor.Energy = actor.Energy-1;
                    } else {
                        Object moveto = actor.Inside.Connects.rand;
                        if(is_live(moveto)) {
                            string insidecalled = actor.Inside.label;
                            string targetcalled = moveto.label;

                            log_thing(0,(actor.label)+" is leaving "+insidecalled);
                            if(actorkind=="Animals") {
                                actor.Parts.do(part => {force_react_in(actor,part,"react_animal_move",0);});
                                force_react_in(actor,actor.Inside,"react_animal_move",0);
                            }
                            log_scripted_thing(0,(actor.label)+" arrived at "+targetcalled,"flip("+js_lit(actor.label)+",600);");
                            place_in(actor,moveto);
                            actor["Acts"]["Move"] = actions["move"];
                            //actor.Energy = actor.Energy-1;
                            if(actorkind=="Animals") {
                                actor.Parts.do(part => {force_react_in(actor,part,"react_animal_move",1);});
                                force_react_in(actor,actor.Inside,"react_animal_move",1);
                            }
                        } else {
                            print(red(actor.label," attempted to move to an invalid position from ",actor.Inside.label));
                        }
                    }
                } else {
                    log_thing(0,(actor.label)+" is too tired to move");
                }
                actor["Acts"]["Rest"] = actions["rest"];
            }
        `);

    ColCol StateStore = sub.add("StateStore");
    Ptr cowstates = states.add("Animals",Ptr);
        cowstates.put("nothing",
            StateStore.add(string,"nothing").init(
            `
                log_thing(0,(actor.label)+" did nothing");
                acts.push(actions["nothing"]);
            `
            )
        );
        cowstates.put("resting",StateStore.add(string,"resting").init(
            'log_thing(0,(actor.label)+" rested"); actor.Energy = actor.Energy+2; if(randi(0,2)==2){log_thing(0,"Then "+(actor.label)+" got up"); repeat(2){acts.push(actions["move"]);}}',
        ));

        animals.cells((k,v) => {
            v.as(Object).State = cowstates["nothing"];
        });

    Ptr personstates = states.add("People",Ptr);
        personstates.put("nothing",
            StateStore.add(string,"nothing").init(
            `
                log_thing(0,(actor.label)+" did nothing");
                acts["Move"] = actions["move"];
                acts["Rest"] = actions["rest"];
                acts["Nothing"] = actions["nothing"];
            `
            )
        );
        personstates.put("recovering",
            StateStore.add(string,"recovering").init(
            `
                log_thing(0,(actor.label)+" is recovering");
                acts["Move"] = actions["move"];
                acts["Rest"] = actions["rest"];
                acts["Nothing"] = actions["nothing"];
            `
            )
        );
        personstates.put("resting",
            StateStore.add(string,"resting").init(
            `
                log_thing(0,(actor.label)+" is resting");
                if(actor.Energy<10) {
                    actor.Energy = actor.Energy+1;
                }
                acts["Move"] = actions["move"];
                acts["Rest"] = actions["rest"];
                acts["Nothing"] = actions["nothing"];
            `
            )
        );
        

        actions.add(string,"react_animal_move").init("react_animal_move(actor,actee,reaction_phase);");
        scriptcode.append(
            `  
            global void react_animal_move(Object actor, Object actee, int reaction_phase) {
                string acteekind = actee.as(ColCol).label;
                ColCol grid = database.Grid;
                ColCol actions = database.Actions;
                ColCol states = database.States;
                if(acteekind=="Animals") {

                } else {       
                    Object inside = actee.Inside;
                    string insidekind = root_part_owner(inside).as(ColCol).label;          
                    if(insidekind=="Maps") {
                        int margin = roll_save_for(actee)-10;
                        if(reaction_phase==0) {
                            if(margin>=0) {
                                log_scripted_thing(2,(actee.label)+" dodged out of the way of "+(actor.label)+"'s hoof","getel("+js_lit(actee.label)+").style.color = 'green';");
                            } else if(margin>=-5) {
                                log_scripted_thing(3,(actee.label)+" was hit by "+(actor.label)+"'s hoof, knocking them to the ground","getel("+js_lit(actee.label)+").style.color = 'red';");
                                actee["Acts"]["Get up"] = actions["recover"];
                                actee.State = states[acteekind]["impacted"];
                                actee.Injury = actee.Injury+1;
                            } else {
                                log_scripted_thing(4,(actee.label)+" was struck by "+(actor.label)+"'s hoof, causing serious injury","getel("+js_lit(actee.label)+").style.color = 'red';");
                                actee["Acts"]["Struggle"] = actions["recover"];
                                actee.State = states[acteekind]["impacted"];
                                actee.Injury = actee.Injury+3;
                            }
                        } else {
                            if(margin>=0) {
                                log_scripted_thing(2,(actee.label)+" dodged out of the way of "+(actor.label)+"'s hoof as it landed","getel("+js_lit(actee.label)+").style.color = 'green';");
                            } else if(margin>=-2) {
                                log_scripted_thing(3,(actee.label)+" was thrown back by "+(actor.label)+"'s hoof as it landed","getel("+js_lit(actee.label)+").style.color = 'red';");
                                actee["Acts"]["Get up"] = actions["recover"];
                                actee.State = states[acteekind]["impacted"];
                            } else {
                                log_scripted_thing(4,(actee.label)+" was pinned beneath "+(actor.label)+"'s hoof","getel("+js_lit(actee.label)+").style.color = 'red';");
                                actee["Acts"]["Struggle"] = actions["recover"];
                                actee.State = states[acteekind]["impacted"];
                                setsidx(actee.State,1);
                                place_in(actee,actor.Parts.Leg);
                            }
                        }
                    } else {
                        int luckroll = randi(0,8);
                        if(reaction_phase==0) {
                            if(luckroll>getsidx(actee.State)) {
                                log_thing(1,(actee.label)+" was left behind as "+(actor.label)+" moved");
                                place_in(actee,actor.Inside);
                                setsidx(actee.State,0);
                            }
                        } else {
                            luckroll = luckroll-3;
                            if(luckroll>getsidx(actee.State)) {
                                log_thing(1,(actee.label)+" was flung from "+(actor.label)+"'s hoof while it was moving");
                                place_in(actee,actor.Inside);
                                setsidx(actee.State,0);
                                actee.Injury = actee.Injury+1;
                            } else {
                                log_thing(3,(actee.label)+" is crushed further beneath "+(actor.label)+"'s hoof as it lands");
                                setsidx(actee.State,min(getsidx(actee.State)+1,actee.State.length-1));
                                actee["Acts"]["Struggle"] = actions["recover"];
                                actee.Injury = actee.Injury+3;
                            }
                        }
                    }
                }
            }
            `
        );

        personstates.put("impacted",
            StateStore.add(string,"impacted").init(
            `
                log_thing(0,(actor.label)+" is on the ground");
                acts["Get up"] = actions["recover"];
                acts["Relax"] = actions["rest"];
            `,
            `
                Object inside = actor.Inside;
                log_thing(0,(actor.label)+" is stuck to "+(inside.label));
                acts["Struggle"] = actions["recover"];
            `,
            `
                Object inside = actor.Inside;
                log_thing(0,(actor.label)+" is ground beneath "+(inside.label));
                actor.Injury = actor.Injury+1;
                acts["Struggle"] = actions["recover"];
            `
            )
        );

        people.cells((k,v) => {
            v.as(Object).State = personstates["nothing"];
        });





    ColCol logs = sub.add("Logs");


    sub.clear_all_locks;
    sub.save;

    write_file(project_path+"script.gld",scriptcode);
} else {
    print("Loading database");
    tstart("database_load");
    ColColCol database = load_subunit(project_path+"data.gsu");
    database.clear_all_locks;
    print("Database loaded in: ",tstop("database_load"));
}

ColColCol cache = usubunits.add(project_path+"cache.gsu");
    cache.add("Catchers");
    cache.add("Storage");
    ColCol classes = cache.add("Classes");
        classes.add(Ptr,"Lookup");
cache.clear_all_locks;
cache.save;

