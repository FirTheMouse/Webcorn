##
    "node" {
        on ".\"left\"" Node {
            subprocess(ctx);
            ctx.node.value.set(ctx.node.children().get(0).value.getNode.children.get(0));
        }
        on ".\"right\"" Node {
            subprocess(ctx);
            ctx.node.value.set(ctx.node.children().get(0).value.getNode.children.get(1));
        }
        on ".\"scope_owner\"" Node {
            subprocess(ctx);
            ctx.node.value.set(ctx.node.children().get(0).value.getNode.scopes.get(0).owner);
        }
        on ".\"climb\"" Node {
            subprocess(ctx);
            ctx.node.value.set(ctx.node.children().get(0).value.getNode.in_scope.owner);
        }
    }
##

##
    newstage posting;
    newstage fraging;

    register text;
    "text" {
        in naming {
            ctx.node.children.push(ctx.result.take(ctx.index+1));
        }
        in htmlemiting {
            execut(ctx.node.children.get(0));
            ctx.source.append("<p");
            emit_inline_html;
            ctx.source.append(">");
            ctx.source.append(ctx.node.children.get(0).value.getStr);
            ctx.source.append("</p>");
            emit_contents;
        }
    }

    register input;
    "input" {
        in htmlemiting {
            ctx.source.append("<input");
            emit_inline_html;
            ctx.source.append("/>");
        }
    }

    register button;
    "button" {
        in htmlemiting {
            ctx.source.append("<button");
            emit_inline_html;
            ctx.source.append(">");
            emit_contents;
            ctx.source.append("</button>");
        }
    }

    register script;
    "script" {
        in naming {
            ctx.node.children.push(ctx.result.take(ctx.index+1));
        }
        in resolving {
            resolv(ctx.node.children.get(0));
        }
        in htmlemiting {
            ctx.source.append("<script");
            emit_inline_html;
            ctx.source.append(">");
            execut(ctx.node.children.get(0));
            ctx.source.append(ctx.node.children.get(0).value.getStr);
            ctx.source.append("</script>");
        }
    }

    register style;
    "style" {
        in naming {
            ctx.node.children.push(ctx.result.take(ctx.index+1));
        }
        in htmlemiting {
            ctx.source.append("<style");
            emit_inline_html;
            ctx.source.append(">");
            ctx.source.append(ctx.node.children.get(0).name);
            ctx.source.append("</style>");
        }
    }

   global string node_str_id(Node n) {
        string to_return = n.name+"_"+to_string(n.asID);
        return to_return;
    }

    "component" {
        in htmlemiting {
            ctx.source.append("<div");
            if(ctx.node.name=="div") {

            } else {
                ctx.source.append(" id=\"");
                ctx.source.append(node_str_id(ctx.node));
                ctx.source.append("\"");
            }
            emit_inline_html;
            ctx.source.append(">");
            emit_contents;
            ctx.source.append("</div>");
        }
    }
   
    register emit_block;
    "emit_block" {
        in executing {
            ctx.source.append("<html><body>");
            emit_contents;
            ctx.source.append("</body></html>");
        }
    }

    register html;
    "html" {
        in naming {
            ctx.node.children.push(ctx.result.take(ctx.index+1));
        }
        in resolving {
            resolv(ctx.node.children.get(0));
        }
        in htmlemiting {
            execut(ctx.node.children.get(0));
            ctx.source.append(ctx.node.children.get(0).value.getStr);
        }
    }

    register img; 
    "img" {
        in htmlemiting {
            ctx.source.append("<img ");
            emit_inline_html;
            ctx.source.append(">");
        }
    }

    register svg; 
    "svg" {
        in htmlemiting {
            ctx.source.append("<svg ");
            ctx.source.append("xmlns=\"http://www.w3.org/2000/svg\" ");
            ctx.source.append("xmlns:xlink=\"http://www.w3.org/1999/xlink\" ");
            set_in_svg(true);
            emit_inline_html;
            ctx.source.append(">");
            emit_contents;
            ctx.source.append("</svg>");
            set_in_svg(false);
        }
    }

    register path;
    "path" {
        in htmlemiting {
            ctx.source.append("<path ");
            emit_inline_html;
            ctx.source.append("/>");
        }
    }

    register g;
    "g" {
        in htmlemiting {
            ctx.source.append("<g ");
            emit_inline_html;
            ctx.source.append(">");
            emit_contents;
            ctx.source.append("</g>");
        }
    }

    register video;
    "video" {
        in htmlemiting {
            ctx.source.append("<video ");
            emit_inline_html;
            ctx.source.append(">");
            emit_contents;
            ctx.source.append("</video>");
        }
    }

    register table;
    "table" {
        in htmlemiting {
            ctx.source.append("<table");
            emit_inline_html;
            ctx.source.append(">");
            emit_contents;
            ctx.source.append("</table>");
        }
    }

    register row;
    "row" {
        in htmlemiting {
            ctx.source.append("<tr");
            emit_inline_html;
            ctx.source.append(">");
            emit_contents;
            ctx.source.append("</tr>");
        }
    }

    register column;
    "column" {
        in htmlemiting {
            ctx.source.append("<td");
            emit_inline_html;
            ctx.source.append(">");
            emit_contents;
            ctx.source.append("</td>");
        }
    }

    register select;
    "select" {
        in htmlemiting {
            ctx.source.append("<select");
            emit_inline_html;
            ctx.source.append(">");
            emit_contents;
            ctx.source.append("</select>");
        }
    }

    register option;
    "option" {
        in naming {
            ctx.node.children.push(ctx.result.take(ctx.index+1));
        }
        in htmlemiting {
            execut(ctx.node.children.get(0));
            ctx.source.append("<option");
            emit_inline_html;
            ctx.source.append(">");
            ctx.source.append(ctx.node.children.get(0).value.getStr);
            ctx.source.append("</option>");
            emit_contents;
        }
    }


    global int emit_js(string js) {
        if(ctx.source.length!=0) {if(ctx.source=="go") {} else { ctx.source.append("@"); }}
        ctx.source+=("RUN "+js);
    }
    global string emit_reload(Context c, Node n) {
        if(c.source.length!=0) {
            if(c.source=="go") {} else { c.source.append("@"); }
        }
        c.source+=("FRAG " + node_str_id(n) + " ");
        string oldsrc = c.source;
        ctx.source = "";
        htmlemit n;
        c.source = (oldsrc+ctx.source);
        return ctx.source;
    }
    "component" {
        on ".\"reload\"" {
            emit_reload(ctx.sub,ctx.node.left.scope_owner);
        }
    }
    global string emit_full_page_reload(Context c){
        c.source = "RELOAD";
        return ctx.source;
    }

    global int set_cell(Ptr cellptr, string valstr) {
        duck val = from_string(valstr);
        print("SC Val: ",val," ",SV#val);
        if(is_live(*cellptr)) {
            *(*cellptr) = val;
        } else {
            *cellptr = get_ticket(find_sheet(getpool(cellptr),#storesheet),0);
            *(*cellptr) = val;
        }
    }

    global Ptr create_form_question(int spool, int col, int row, string type) {
        Ptr metaptr = makePtr3(find_sheet(spool,#metadatasheet,1),col,row);
        set_cell(metaptr,type);
        Ptr formptr = makePtr3(find_sheet(spool,#formsheet),col,row);
        *formptr = get_ticket(find_sheet(spool,#storesheet),0);
        *formptr.clear;
        return formptr;
    }

    global int add_dropdown_option(int spool, Ptr fp, string label, string value) {
        duck val = from_string(value);
        int vofa = V#val;
        if(vofa==(#string)) {
            fp.push(get_ticket(find_sheet(spool,#storesheet),32));
        } else {
            fp.push(val);
        }
        int idx = fp.length-1;
        fp.get(idx)=val;
        setsidx(fp,idx);
        fp.celllabel(label);
    }

