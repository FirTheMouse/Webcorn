##
    "node" {
        on ".\"left\"" Node {
            subprocess(ctx);
            ctx.node.value.set(ctx.node.children().get(0).value.getNode.children.get(0));
        }
        on ".\"right\"" Node {
            subprocess(ctx);
            ctx.node.value.set(ctx.node.children().get(0).value.getNode.children.get(1));
        }
        on ".\"scope_owner\"" Node {
            subprocess(ctx);
            ctx.node.value.set(ctx.node.children().get(0).value.getNode.scopes.get(0).owner);
        }
        on ".\"climb\"" Node {
            subprocess(ctx);
            ctx.node.value.set(ctx.node.children().get(0).value.getNode.in_scope.owner);
        }
    }
