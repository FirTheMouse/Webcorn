global Session session;
int guest_counter = 0;
bool allow_guests = false;
bool debug_mode = true;
global string redirected_from = "";
print("Compiling");
    tstart("twig_compile");
Node twig = compile(read_file("web/thistle/thistle.twg"));
//Node twig = compile(read_file("web/test.twg"));
//Node twig = compile(read_file("web/goldensystems/website.twg"));
print("Compiled in: ",tstop("twig_compile"));
Node page = twig.children.get(0);

//print(unit_info);

int cfd = 0;
while(0<1) {
    if(unit_index!=0) {
        cfd = unit_index;
        tstart("request_timer");
        print("Unit ",unit_uid," recived request ",cfd);
        string req = unit_label;
        //print("Req:\n",req);

        string first_line = req.substr(0, req.find("\r\n"));
        string method = first_line.substr(0, first_line.find(" "));
        string slashpath = first_line.slice(" ", 1, 2);
        string unslashpath = slashpath.substr(1,slashpath.length-1); //Strip the slash
        print("Method: ",method);
        print("Path: ",slashpath);

        string response_body = "";
        string response = "";
        bool should_emit_page = true;

        if(unslashpath.find(".")>0) {
            if(unslashpath.find("web/")==0) {
                string mime = "application/octet-stream";
                if(unslashpath.find(".png") > 0) {mime = "image/png";}
                if(unslashpath.find(".jpg") > 0) {mime = "image/jpeg";}
                if(unslashpath.find(".js") > 0)  {mime = "application/javascript";}
                if(unslashpath.find(".css") > 0) {mime = "text/css";}
                string info = read_file(unslashpath);
                string response = "HTTP/1.1 200 OK\r\n"
                                +"Content-Type: " + mime + "\r\n"
                                +"Content-Length: " + to_string(info.length) + "\r\n"
                                +"\r\n";
                response+=info;
                write(cfd, response);
                close(cfd);
                print("Unit ",unit_uid," completed file request ",cfd);
                unit_setindex(0);
                continue;
            }
        } else {
            if(slashpath=="/favicon.ico") {} else {
                if((session.username.length==0)) {
                    if(allow_guests) {
                        string new_guest_id = "guest_"+to_string(unit_uid)+"-"+to_string(guest_counter++);
                        cry("SESSION:"+new_guest_id);
                        string session_token = unit_label;
                        string do_str = "document.cookie = 'session="+session_token+"; path=/';";
                        ctx.source = "";
                        emit_block {
                            script js_do(do_str);
                        }
                        response_body.append(ctx.source);
                    } else {
                        if(debug_mode) { //Auto log in as Fir for debug
                            cry("SESSION:Fir");
                            string session_token = unit_label;
                            string do_str = "document.cookie = 'session="+session_token+"; path=/';";
                            ctx.source = "";
                            emit_block {
                                script js_do(do_str);
                            }
                            response_body.append(ctx.source);
                            //save_sheet(generate_redberry_sheet,"web/thistle/users/Fir/sheets/blank");
                        } else {
                            if(slashpath=="/login") {

                            } else {
                                redirected_from = slashpath;
                                ctx.source = "";
                                emit_block {
                                    script js_do("window.location.href = '/login';");
                                }
                                response_body.append(ctx.source);
                                should_emit_page = false;
                            }
                        }
                    }
                }
            }

            if(should_emit_page) {
                if(unslashpath.length==0) {
                    unslashpath = "root_path"; //For routing
                } else if(unslashpath=="favicon.ico") {
                    unslashpath = "root_path"; //For routing
                }

                if(method=="RESET") {
                    print("Recompiled webrunner");
                    //twig = compile(read_file("web/test.twg"));
                    twig = compile(read_file("web/goldensystems/website.twg"));
                    page = twig.children.get(0);
                    method="GET";
                }   

                for(int i=0;i<twig.children.length;i++) {
                    Node child = twig.children.get(i);
                    if(labels(child.type)==unslashpath) {
                        page = child; //Because I haven't added break yet
                    }
                }

                if(method=="GET") {
                    ctx.source = "";
                    htmlemit page;
                    response_body.append(ctx.source);
                }

                if(method=="POST") {
                    int body_start = req.find("\r\n\r\n");
                    if(body_start>=0) {
                        string src = req.slice(body_start+4,req.length);
                        ctx.source = src;
                        post page;
                        response.append(ctx.source);
                    }
                }

                if(method=="FRAG") {
                    int body_start = req.find("\r\n\r\n");
                    if(body_start>=0) {
                        string src = req.slice(body_start+4,req.length);
                        ctx.source = src;
                        frag page;
                        response_body.append(ctx.source);
                    }
                }

                if(method=="RUN_RAW") {
                    int body_start = req.find("\r\n\r\n");
                    if(body_start>=0) {
                        string src = req.slice(body_start+4,req.length);
                        print("Running raw:\n",src);

                        Node root = compile(src);
                        execut root;

                        src = ctx.source;
                        string target = src.slice(0,src.find(" "));
                        string instr = src.slice(" ",1,2);
                        string content = src.slice(src.find(" ",0,2)+1,src.length);
                        if(target.length!=0) {
                            print("TARGET: ",target); 
                            print("INSTR: ",instr); 
                            print("CONTENT LEN: ",content.length);
                            response_body = content;
                        }
                    }
                }

                if(method=="RUN") {
                    int body_start = req.find("\r\n\r\n");
                    if(body_start>=0) {
                        string src = req.slice(body_start+4,req.length);
                        if(src.length==0) {
                            print("Recived a blank run request");
                        } else {
                            print("Running:\n",src);

                            Ptr string args = split_str(src,"@");
                            ctx.source = "go";
                            Ptr pointer = string_to_Ptr(args.get(0));
                            Node root = cast_to_Node(pointer);

                            if(args.length>1) {
                                for(int a=1;a<args.length;a++) {
                                    if(args.get(a)=="[VAR]") {
                                        root.children.get(a-1).value.set(args.get(a+1));
                                    }
                                }
                            }

                            tstart("executing_run_root");
                            execut root;
                            print("Time: ",tstop("executing_run_root"));

                            src = ctx.source;
                            if(src=="RELOAD") {
                                ctx.source = "";
                                htmlemit page;
                                response_body = ctx.source;
                            } else if(src.length>0) {
                                response_body = src;
                            }
                        }
                    }
                }
            }
        }

        if(response.length==0) {
            response.append("HTTP/1.1 200 OK\r\n");
            response.append("Content-Type: text/html\r\n");
            response.append("Content-Length: ");
            response.append(to_string(response_body.length));
            response.append("\r\n\r\n");
            response.append(response_body);
        } else {
            print("PREFILLED RESPONSE:\n",response);
        }
        print("Responding to ",cfd," with: ",response.length," chars");
        write(cfd,response); 
        close(cfd);

        print("Unit ",unit_uid," completed request ",cfd," in ",tstop("request_timer"));
        unit_setindex(0);
    } else {
        thread_sleep;
    }
}