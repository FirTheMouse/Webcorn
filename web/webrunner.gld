    "component" {
        in htmlemiting {
            if(ctx.node.name=="div") {
                subemit("div",false,"","");
            } else {
                subemit("div",false,"id=\""+capture_node(ctx.node)+"\"","");
            }
        }
    }
    "prefix_component" {
        in htmlemiting {
            //log("Prefix component");
            if(ctx.node.type==(#FUNC_CALL)) {
                paranoid_qual_kill(ctx); //Revoke it. Dealing with inner quals and their routing is a minefield!
            } else if(ctx.node.type==(#FUNC_DECL)&&!(ctx.node.has_qual(#template))) {
                if(ctx.node.children.length==0) { //Implcit case, for when a div is paramatrized and named but not qualifed as a template, don't emit it!
                    paranoid_qual_kill(ctx);
                    htmlemit(ctx.node,#component);
                }
            }
        }
        in executing {
            //log("Prefix component");
            if(ctx.node.type==(#FUNC_CALL)) {
                paranoid_qual_kill(ctx); //Revoke it. Dealing with inner quals and their routing is a minefield!
            } else if(ctx.node.type==(#FUNC_DECL)&&!(ctx.node.has_qual(#template))) {
                if(ctx.node.children.length==0) { //Implcit case, for when a div is paramatrized and named but not qualifed as a template, don't emit it!
                    paranoid_qual_kill(ctx);
                    htmlemit(ctx.node,#component);
                }
            }
        }
    }

    register text;
    "text" {
        in naming {
            ctx.node.children.push(ctx.result.take(ctx.index+1));
        }
        in htmlemiting {
            execut(ctx.node.children.get(0));
            subemit("p",false,"",ctx.node.children.get(0).value.getStr);
        }
    }

    register input;
    "input" {
        in htmlemiting {
            subemit("input",true,"","");
        }
    }

    register button;
    "button" {
        in htmlemiting {
           subemit("button",false,"","");
        }
    }

    register script;
    "script" {
        in naming {
            ctx.node.children.push(ctx.result.take(ctx.index+1));
        }
        in htmlemiting {
            execut(ctx.node.children.get(0));
            subemit("script",false,"",ctx.node.children.get(0).value.getStr);
        }
    }

