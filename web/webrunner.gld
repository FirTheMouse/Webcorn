    "component" {
        in htmlemiting {
            if(ctx.node.name=="div") {
                subemit("div",false,"","");
            } else {
                subemit("div",false,"id=\""+capture_node(ctx.node)+"\" data-ptr=\""+capture_ptr(ctx.node)+"\"","");
            }
        }
    }
    "prefix_component" {
        in htmlemiting {
            //log("Prefix component");
            if(ctx.node.type==(#FUNC_CALL)) {
                paranoid_qual_kill(ctx); //Revoke it. Dealing with inner quals and their routing is a minefield!
            } else if(ctx.node.type==(#FUNC_DECL)&&!(ctx.node.has_qual(#template))) {
                if(ctx.node.children.length==0) { //Implcit case, for when a div is paramatrized and named but not qualifed as a template, don't emit it!
                    paranoid_qual_kill(ctx);
                    htmlemit(ctx.node,#component);
                }
            }
        }
        in executing {
            //log("Prefix component");
            if(ctx.node.type==(#FUNC_CALL)) {
                paranoid_qual_kill(ctx); //Revoke it. Dealing with inner quals and their routing is a minefield!
            } else if(ctx.node.type==(#FUNC_DECL)&&!(ctx.node.has_qual(#template))) {
                if(ctx.node.children.length==0) { //Implcit case, for when a div is paramatrized and named but not qualifed as a template, don't emit it!
                    paranoid_qual_kill(ctx);
                    htmlemit(ctx.node,#component);
                }
            }
        }
    }

    register text;
    "text" {
        in naming {
            ctx.node.children.push(ctx.result.take(ctx.index+1));
        }
        in htmlemiting {
            execut(ctx.node.children.get(0));
            subemit("p",false,"",ctx.node.children.get(0).value.getStr);
        }
    }

    register input;
    "input" {
        in htmlemiting {
            subemit("input",true,"","");
        }
    }

    register iframe;
    "iframe" {
        in htmlemiting {
            subemit("iframe",false,"","");
        }
    }

    register button;
    "button" {
        in htmlemiting {
           subemit("button",false,"","");
        }
    }

    register script;
    "script" {
        in naming {
            ctx.node.children.push(ctx.result.take(ctx.index+1));
        }
        in htmlemiting {
            execut(ctx.node.children.get(0));
            subemit("script",false,"",ctx.node.children.get(0).value.getStr);
        }
    }

    register style;
    "style" {
        in naming {
            ctx.node.children.push(ctx.result.take(ctx.index+1));
        }
        in htmlemiting {
            execut(ctx.node.children.get(0));
            subemit("style",false,"",ctx.node.children.get(0).value.getStr);
        }
    }

   global string node_str_id(Node n) {
        string to_return = n.name+"_"+to_string(n.asID);
        return to_return;
    }
   
    register emit_block;
    "emit_block" {
        in executing {
            subemit("body",false,"","");
        }
    }
    global string recover_emitted() {
        string sbody = ctx.source;
        sbody = sbody.slice(6,sbody.length-7);
        return sbody;
    }   

    register emit_return;
    "emit_return" {
        in executing {
            if(ctx.source.length!=0) {if(ctx.source!="go"){ctx.source.append("@");}}
            ctx.source.append("RETURN ");
            string oldsrc = ctx.source;
            ctx.source = "";
            subemit("body",false,"","");
            ctx.source = (oldsrc+recover_emitted);
        }
    }


    register html;
    "html" {
        in naming {
            ctx.node.children.push(ctx.result.take(ctx.index+1));
        }
        in htmlemiting {
            execut(ctx.node.children.get(0));
            emit_part(ctx.node.children.get(0).value.getStr);
        }
    }

    register img; 
    "img" {
        in htmlemiting {
            subemit("img",true,"","");
        }
    }

    register svg; 
    "svg" {
        in htmlemiting {
            set_in_svg(true);
            subemit("svg",false,"xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\" ","");
            set_in_svg(false);
        }
    }

    register path;
    "path" {
        in htmlemiting {
            subemit("path",true,"","");
        }
    }

    register g;
    "g" {
        in htmlemiting {
            subemit("g",false,"","");
        }
    }

    register video;
    "video" {
        in htmlemiting {
            subemit("video",false,"","");
        }
    }

    register table;
    "table" {
        in htmlemiting {
           subemit("table",false,"","");
        }
    }

    register row;
    "row" {
        in htmlemiting {
            subemit("tr",false,"","");
        }
    }

    register column;
    "column" {
        in htmlemiting {
            subemit("td",false,"","");
        }
    }

    register select;
    "select" {
        in htmlemiting {
            subemit("select",false,"","");
        }
    }

    register option;
    "option" {
        in naming {
            ctx.node.children.push(ctx.result.take(ctx.index+1));
        }
        in htmlemiting {
            execut(ctx.node.children.get(0));
            subemit("option",false,"",ctx.node.children.get(0).value.getStr);
        }
    }

    global int emit_js(string js) {
        if(ctx.source.length!=0) {if(ctx.source=="go") {} else { ctx.source.append("@"); }}
        ctx.source+=("RUN "+js);
    }
    global string emit_reload(Context c, Node n) {
        if(c.source.length!=0) {
            if(c.source=="go") {} else { c.source.append("@"); }
        }
        c.source+=("FRAG " + node_str_id(n) + " ");
        string oldsrc = c.source;
        ctx.source = "";
        htmlemit n;
        c.source = (oldsrc+ctx.source);
        //print("NEW SOURCE: ",c.source);
        return ctx.source;
    }
    "component" {
        on ".\"reload\"" {
            emit_reload(ctx.sub,ctx.node.left.scope_owner);
        }
    }
    global string emit_full_page_reload(Context c){
        c.source = "RELOAD";
        return ctx.source;
    }
    global void return_emitted() {
        ctx.source = "@RETURN "+recover_emitted;
    }

    "inlined" {
        on ".\"emit\"" string {
            local_subemit("",true,"","");
            string s = ctx.node.value.getStr;
            ctx.node.value.getStr = s.slice(9,s.length-3);
        }
    }
    "component" { //Expand on later if it proves useful
        on ".\"emit\"" string {
            local_subemit("",true,"","");
            string s = ctx.node.value.getStr;
            ctx.node.value.getStr = s.slice(2,s.length-2);
        }
    }

##

string inital_request = unit_label;

global Session session;
global ColColCol database;

int units = 0;
string arg_units = unit_get_arg("--units=");
if(arg_units.length!=0) {units = stoi(arg_units);}

global bool has_state = (units==0);



if(!has_state) {
    cry("INVEST:database:data.gsu");
}

global int guest_counter = 0;
bool allow_guests = !unit_has_arg("--private");
bool debug_mode = unit_has_arg("--debug");
global string redirected_from = "";
global bool auto_log; auto_log = debug_mode;

global int log_verbosity = 0;
string arg_verbosity = unit_get_arg("--verbosity=");
if(arg_verbosity.length!=0) {log_verbosity = stoi(arg_verbosity);}

global string current_request = "";
global string response = "";

global string project_path;
string arg_path = unit_get_arg("--project=");
if(arg_path.length!=0) {project_path = arg_path;}

Ptr bool file_whitelist;
string twigpath = "";
string arg_twigcode = unit_get_arg("--twigcode=");
if(arg_twigcode.length!=0) {
    twigpath = arg_twigcode;
} else if(project_path.length>0) {
    string potential = project_path+"website.twg";
    if(file_exists(potential)) {
        twigpath = potential;
    }
}
string arg_whitelist = unit_get_arg("--files=");
if(arg_whitelist.length!=0) {
    Ptr string files = split_str(arg_whitelist,",");
    for(int i=0;i<files.length;i++) {
        file_whitelist.put(files.get(i),true);
    }
} else if(project_path.length>0) {
    string potential = project_path+"files";
    if(file_exists(potential)) {
        file_whitelist.put(potential,true);
    }
}

if(log_verbosity>2) {print("Compiling"); tstart("twig_compile");}
Node twig = compile(read_file(twigpath));
if(log_verbosity>2) {print("Compiled in: ",tstop("twig_compile"));}

Node page = twig.children.get(0);


// if(unit_has_arg("--compact")) {
//     strip_compiled_unit;
// }

// print("Dumping full unit");
//     tstart("dumping");
// dump_unit(true);
//     print("Dumped in: ",tstop("dumping"));

//print(unit_info);

int fd = unit_index;
int cfd = 0;
while(0<1) {
    if(has_state) {
        cfd = unit_index;
    } else {
        cfd = accept(fd);
    }
    if(cfd>0) {
        if(log_verbosity>0) {tstart("request_timer");}
        if(log_verbosity>0) {print("Unit ",unit_uid," recived request ",cfd);}
        string req = "";
        if(has_state) {
            req = unit_label;
            if(inital_request.length>0) {
                req = inital_request;
                inital_request = "";
            }
        } else {
            req = read(cfd);
        }
        current_request = req;
        response = "";

        string current_session_token = get_cookie(req,"session");

        //print("Req:\n",req);

        string first_line = req.substr(0, req.find("\r\n"));
        string method = first_line.substr(0, first_line.find(" "));

        // if(has_state&&method=="SERVE") {
        //     to_serve = first_line.slice(first_line.find(" ")+1, first_line.length);
        // } else if(unslashpath.find(".")>0) {
        //     string strip_to_directory = "";
        //     for(int i=unslashpath.length-1;i>0;i=i-1)  {
        //         if(unslashpath.slice(i-1,i)=="/") {strip_to_directory = unslashpath.slice(0,i-1); i=0;}
        //     }
        //     if(strip_to_directory.length>0 && file_whitelist.has(strip_to_directory)) {
        //         to_serve = unslashpath;
        //     }
        // }
        // print("TSERV: ",to_serve);
        // if(to_serve.length>0){
        //     string mime = "application/octet-stream";
        //     if(to_serve.find(".png") > 0)  {mime = "image/png";}
        //     if(to_serve.find(".jpg") > 0)  {mime = "image/jpeg";}
        //     if(to_serve.find(".webp") > 0) {mime = "image/webp";}
        //     if(to_serve.find(".js") > 0)   {mime = "application/javascript";}
        //     if(to_serve.find(".css") > 0)  {mime = "text/css";}

        //     string info = read_file(to_serve);
        //     response = "HTTP/1.1 200 OK\r\n"
        //                     + "Content-Type: " + mime + "\r\n"
        //                     + "Content-Length: " + to_string(info.length) + "\r\n"
        //                     + "\r\n";
        //     response += info;
        //     write(cfd, response);
        //     close(cfd);
        //     if(log_verbosity>1) {tstop("request_timer");}
        //     print("Unit ", unit_uid, " completed file request ", cfd, " in ", tstop("request_timer"));
        //     unit_setindex(0);
        //     cfd = 0;
        //     continue;
        // }

        if(method=="SERVE") {
            string to_serve = first_line.slice(first_line.find(" ")+1, first_line.length);

            string mime = "application/octet-stream";
            if(to_serve.find(".png") > 0)  {mime = "image/png";}
            if(to_serve.find(".jpg") > 0)  {mime = "image/jpeg";}
            if(to_serve.find(".webp") > 0) {mime = "image/webp";}
            if(to_serve.find(".js") > 0)   {mime = "application/javascript";}
            if(to_serve.find(".css") > 0)  {mime = "text/css";}

            print("Serving file ",to_serve);
            string info = read_file(to_serve);
            response = "HTTP/1.1 200 OK\r\n"
                            + "Content-Type: " + mime + "\r\n"
                            + "Content-Length: " + to_string(info.length) + "\r\n"
                            + "\r\n";
            response += info;
            write(cfd, response);
            close(cfd);
            if(log_verbosity>1) {tstop("request_timer");}
            print("Unit ", unit_uid, " completed file request ", cfd, " in ", tstop("request_timer"));
            unit_setindex(0);
            cfd = 0;
            continue;
        }

        string slashpath = first_line.slice(" ", 1, 2);
        string unslashpath = slashpath.substr(1,slashpath.length-1); //Strip the slash
        if(log_verbosity>1) {print("Method: ",method);}
        if(log_verbosity>1) {print("Path: ",slashpath);}

        if(unslashpath.find(".")>0) {
            string strip_to_directory = "";
            for(int i=unslashpath.length-1;i>0;i=i-1)  {
                if(unslashpath.slice(i-1,i)=="/") {strip_to_directory = unslashpath.slice(0,i-1); i=0;}
            }
            if(strip_to_directory.length>0 && file_whitelist.has(strip_to_directory)) {
                string to_serve = unslashpath;

                string mime = "application/octet-stream";
                if(to_serve.find(".png") > 0)  {mime = "image/png";}
                if(to_serve.find(".jpg") > 0)  {mime = "image/jpeg";}
                if(to_serve.find(".webp") > 0) {mime = "image/webp";}
                if(to_serve.find(".js") > 0)   {mime = "application/javascript";}
                if(to_serve.find(".css") > 0)  {mime = "text/css";}

                string info = read_file(to_serve);
                response = "HTTP/1.1 200 OK\r\n"
                                + "Content-Type: " + mime + "\r\n"
                                + "Content-Length: " + to_string(info.length) + "\r\n"
                                + "\r\n";
                response += info;
                write(cfd, response);
                close(cfd);
                if(log_verbosity>1) {tstop("request_timer");}
                //print("Unit ", unit_uid, " completed file request ", cfd, " in ", tstop("request_timer"));
                unit_setindex(0);
                cfd = 0;
                continue;
            }
        }

        string response_body = "";
        bool should_emit_page = true;

        if(has_state&&(session.username.length==0)) {
            if(allow_guests) {
                string new_guest_id = "guest_"+to_string(unit_uid)+"-"+to_string(guest_counter++);
                cry("SESSION:"+new_guest_id);
                string session_token = unit_label;

                response.append("HTTP/1.1 200 OK\r\n");
                response.append("Content-Type: text/html\r\n");
                string cooked = "Set-Cookie: session="+session_token+"; Path=/\r\n";
                response.append(cooked);
                
                string do_str = "document.cookie = 'session="+session_token+"; path=/';";
                ctx.source = "";
                emit_block {
                    script js_do(do_str);
                }
                response_body.append(ctx.source);
            } else {
                if(auto_log&&current_session_token!="loggedout") { //Auto log in as Fir for debug
                    print("Auto logging");
                    if(unit_uid==2) {
                        cry("SESSION:Fir");
                    } else {
                        cry("SESSION:Ash");
                    }
                    string session_token = unit_label;
                        string userinfo = read_file(session.userpath+"/userinfo");
                        session.role = userinfo.slice(0,userinfo.find("\n"));
                        session.org = userinfo.slice("\n",1,2);
                    string do_str = "document.cookie = 'session="+session_token+"; path=/';";
                    ctx.source = "";
                    emit_block {
                        script js_do(do_str);
                    }
                    response_body.append(ctx.source);
                    //save_sheet(generate_redberry_sheet,"web/thistle/users/Fir/sheets/Blank");
                } else {
                    if(slashpath!="/login") {
                        redirected_from = slashpath;
                        ctx.source = "";
                        emit_block {
                            script js_do("window.location.href = '/login';");
                        }
                        response_body.append(ctx.source);
                        should_emit_page = false;
                    }
                }
            }
        }

        if(should_emit_page) {
            if(unslashpath.length==0) {
                unslashpath = "root_path"; //For routing
            } else if(unslashpath=="favicon.ico") {
                unslashpath = "root_path"; //For routing
            }

            if(method=="RESET") {
                print("Recompiled webrunner");
                twig = compile(read_file(twigpath));
                page = twig.children.get(0);
                method="GET";
            }   

            for(int i=0;i<twig.children.length;i++) {
                Node child = twig.children.get(i);
                if(labels(child.type)==unslashpath) {
                    page = child; //Because I haven't added break yet
                }
            }

            if(method=="GET") {
                ctx.source = "";   
                //uscw;             
                htmlemit page;
                //urcw;
                response_body.append(ctx.source);
            }

            if(method=="POST") {
                int body_start = req.find("\r\n\r\n");
                if(body_start>=0) {
                    string src = req.slice(body_start+4,req.length);
                    ctx.source = src;
                    post page;
                    response.append(ctx.source);
                }
            }

            if(method=="FRAG") {
                int body_start = req.find("\r\n\r\n");
                if(body_start>=0) {
                    string src = req.slice(body_start+4,req.length);
                    ctx.source = src;
                    frag page;
                    response_body.append(ctx.source);
                }
            }

            if(method=="JSRELOAD") {
                int body_start = req.find("\r\n\r\n");
                if(body_start>=0) {
                    string reload_target = req.slice(body_start+4,req.length);
                    Ptr nodeptr = retrive_ptr(reload_target);
                    if(is_live(nodeptr)) {
                        emit_reload(ctx,cast_to(#node,nodeptr));
                    }
                    response_body.append(ctx.source);
                }
            }

            if(method=="RUN") {
                int body_start = req.find("\r\n\r\n");
                if(body_start>=0) {
                    string src = req.slice(body_start+4,req.length);
                    if(src.length==0) {
                        print("Recived a blank run request");
                    } else {
                        if(log_verbosity>1) {print("Running:\n",src);}

                        Ptr string args = split_str(src,"@");
                        ctx.source = "go";
                        if(args.length>0) {
                            string ptrstring = args.get(0);      
                            Ptr pointer = string_to_Ptr(ptrstring);  
                            if(unslashpath=="login") {
                                bool is_valid_run = false;
                                Node pnode = cast_to_Node(pointer);
                                while(is_live(pnode)) {
                                    if(pnode.type==#login) {is_valid_run = true; break;}
                                    pnode = pnode.climb;
                                }
                                if(!is_valid_run) {
                                    response = "HTTP/1.1 404 Not Found\r\nContent-Length: 0\r\n\r\n";
                                    write(cfd, response);
                                    close(cfd);
                                    print("Unit ",unit_uid," attempted to run an unauthorized function from the login page: ",ptrstring," took ",tstop("request_timer"));
                                    unit_setindex(0);
                                    cfd = 0;
                                    continue;
                                }
                            }
                          
                            if(is_live(pointer)) {
                                Node root = cast_to_Node(pointer);
                                if(args.length>1) {
                                    for(int a=1;(a+1)<args.length;a++) {
                                        if(args.get(a)=="[VAR]") {
                                            string escapedarg = escape_html(args.get(a+1));
                                            root.children.get(a-1).value.getStr = escapedarg;
                                        }
                                    }
                                }

                                ctx.source = "go";
                                if(log_verbosity>1) {tstart("executing_run_root");}
                                execut root;
                                if(log_verbosity>1) {print("Time: ",tstop("executing_run_root"));}

                                src = ctx.source;
                                if(src=="RELOAD") {
                                    ctx.source = "";
                                    htmlemit page;
                                    response_body = ctx.source;
                                } else if(src.length>0) {
                                    response_body = src;
                                }
                            }
                        }
                    }
                }
            }
        }
        if(response.length==0) {
            response.append("HTTP/1.1 200 OK\r\n");
            response.append("Content-Type: text/html\r\n");
        }
        response.append("Connection: close\r\n");
        response.append("Content-Length: ");
        response.append(to_string(response_body.length));
        response.append("\r\n\r\n");
        response.append(response_body);
        if(log_verbosity>1) {print("Responding to ",cfd," with: ",response.length," chars");}
        write(cfd,response); 
        close(cfd);

        if(log_verbosity>0) {print("Unit ",unit_uid," completed request ",cfd," in ",tstop("request_timer"));}
        unit_setindex(0);
        cfd = 0;
    } else {
        Header header;
        if(check_messages(header)) {
            tstart("msg_timer");
            print("Unit ",unit_uid," recived a message");
            string method = header.getString("Method");
            print("Method: ",method);
            if(method=="RUN") {
                string message = header.getString("Message");
                discard_message(header);
                print("Message: ",message);
                Node msgroot = compile(message);
                execut msgroot;
                print("Done");
            }
            print("Unit ",unit_uid," completed message in ",tstop("msg_timer"));
        } else {
            thread_sleep;
        }
    }
}