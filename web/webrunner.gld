    global int emit_js(string js) {
        if(ctx.source.length!=0) {if(ctx.source=="go") {} else { ctx.source.append("@"); }}
        ctx.source+=("RUN "+js);
    }
    global string emit_reload(Context c, Node n) {
        if(c.source.length!=0) {
            if(c.source=="go") {} else { c.source.append("@"); }
        }
        c.source+=("FRAG " + node_str_id(n) + " ");
        string oldsrc = c.source;
        ctx.source = "";
        htmlemit n;
        c.source = (oldsrc+ctx.source);
        //print("NEW SOURCE: ",c.source);
        return ctx.source;
    }
    "component" {
        on ".\"reload\"" {
            emit_reload(ctx.sub,ctx.node.left.scope_owner);
        }
    }
    global string emit_full_page_reload(Context c){
        c.source = "RELOAD";
        return ctx.source;
    }

    global int set_cell(Ptr cellptr, string valstr) {
        ColColCol sheet = cellptr;
        duck val = from_string(valstr);
        //print("SC Val: ",val," ",SV#val);
        if(is_live(*cellptr)) {
            *(*cellptr) = val;
        } else {
            *cellptr = sheet.getByTag(#storesheet).add;
            *(*cellptr) = val;
        }
        save_subunit(sheet);
    }

    global Ptr create_form_question_subunit(Ptr cell, string type) {
        ColColCol sheet = cell;
        Ptr metaptr = sheet.getByTag(#metadatasheet);
        set_cell(metaptr,type);
        Ptr formptr = sheet.getByTag(#formsheet);
        *formptr = sheet.getByTag(#storesheet).add;
        *formptr.clear;
        return formptr;
    }

    global Ptr create_form_question(int spool, int col, int row, string type) {
        Ptr metaptr = makePtr3(find_sheet(spool,#metadatasheet,1),col,row);
        set_cell(metaptr,type);
        Ptr formptr = makePtr3(find_sheet(spool,#formsheet),col,row);
        *formptr = get_ticket(find_sheet(spool,#storesheet),0);
        *formptr.clear;
        return formptr;
    }

    global int add_dropdown_option(int spool, Ptr fp, string label, string value) {
        duck val = from_string(value);
        int vofa = V#val;
        if(vofa==(#string)) {
            fp.push(get_ticket(find_sheet(spool,#storesheet),32));
        } else {
            fp.push(val);
        }
        int idx = fp.length-1;
        fp.get(idx)=val;
        setsidx(fp,idx);
        fp.celllabel(label);
    }

    global int generate_ledger() {
        ColCol pool = utypes.add;
        pool.tag(#datasheet);

        pool.add("Employee Name").retype(string);
        pool.add("Report Date").retype(string);
        pool.add("Place of Supply").retype(string);
        pool.add("Transaction Date").retype(string);
        pool.add("Expense Description").retype(string);
        pool.add("G&A / Store Expense").retype(string);
        pool.add("Department / Store #").retype(string);
        pool.add("Vendor").retype(string);
        pool.add("Total Amount").retype(float);

        ColCol store = utypes.add;
        store.tag(#storesheet);

        return utypes.indexof(pool);
    }

