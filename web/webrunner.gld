            subemit("style",false,"",ctx.node.children.get(0).value.getStr);
        }
    }

   global string node_str_id(Node n) {
        string to_return = n.name+"_"+to_string(n.asID);
        return to_return;
    }
   
    register emit_block;
    "emit_block" {
        in executing {
            ctx.source.append("<html>");
            subemit("body",false,"","");
            ctx.source.append("</html>");
        }
    }

    register html;
    "html" {
        in naming {
            ctx.node.children.push(ctx.result.take(ctx.index+1));
        }
        in htmlemiting {
            execut(ctx.node.children.get(0));
            ctx.source.append(ctx.node.children.get(0).value.getStr);
        }
    }

    register img; 
    "img" {
        in htmlemiting {
            subemit("img",true,"","");
        }
    }

    register svg; 
    "svg" {
        in htmlemiting {
            set_in_svg(true);
            subemit("svg",false,"xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\" ","");
            set_in_svg(false);
        }
    }

