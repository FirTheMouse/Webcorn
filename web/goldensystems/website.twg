GDSL {
    standard_header;
    top_bar("/GDSL");
    div {
        "display" : "flex";
        "flex-direction" : "column";
        "justify-content" : "center";
        "align-items" : "center";
        "min-height" : "150vh";
        "width" : "100%";
        "background-color" : pebble_color_D2;
        div {
            "margin" : "16px";
            "padding" : "12px";
            "border-radius" : "8px";
            "background-color" : pebble_color;
            "display" : "flex";
            "flex-direction" : "column";
            "max-width" : "800px";
            "width" : "100%";
            "height" : "100%";

            section_header("What is GDSL?");
            text "GDSL is the name for my stack, it used to mean Golden Domain Specific Language, back when this was just a basic compiler for button behaviour in my game engine (Golden)." {post_text_theme;}
            text "Now GDSL is quite a bit larger, and still growing, but the name still sticks!" {post_text_theme;}
            text "This isn't really documentation, it's more of an explanation of the elements and systems at play for the curious." {post_text_theme;}
            text "If you want to know more or collaborate, please reach out to me!" {"onclick" : "goTo('/contact')"; "text-decoration" : "underline"; "cursor" : "pointer"; post_text_theme;}
            text "Click on the headers to go to the page for it." {post_text_theme;}

            section_header_link("Acorn","/GDSL_acorn");
            section_header_link("Core","/GDSL_core");
            section_header_link("Compiler","/GDSL_compiler");
            section_header_link("Language","/GDSL_language");
            section_header_link("Webcorn","/GDSL_webcorn");
            section_header_link("TwigSnap","/GDSL_twigsnap");
        }
        
    }
}

