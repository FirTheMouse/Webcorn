##
    global string golden_color = " #dea426";
    global string golden_color_L1 = "rgb(235, 175, 47)";
    global string golden_color_D1 = "rgb(201, 150, 39)";

    global string pebble_color = "rgb(67, 67, 67)";
    global string pebble_color_L2 = "rgb(110, 110, 110)";
    global string pebble_color_L1 = "rgb(83, 83, 83)";
    global string pebble_color_D1 = "rgb(52, 51, 51)";
    global string pebble_color_D2 = "rgb(30, 30, 30)";

    global string pine_color = "rgb(31, 60, 27)";
    global string pine_color_L1 = "rgb(39, 76, 34)";
##


inlined card_theme {
    "border-radius" : "8px";
    "background-color" : "rgb(67, 67, 67)";
}
inlined main_font {
    "font-family" : "system-ui, sans-serif";
}
inlined text_one_theme {
    "font-size" : "15px";
    "font-weight" : "800";
    "color" : " rgb(251, 251, 251)";
    main_font;
}
inlined text_two_theme {
    "font-size" : "12px";
    "font-weight" : "400";
    "color" : " rgb(207, 207, 207)";
    main_font;
}
inlined text_three_theme {
    "font-size" : "10px";
    "font-weight" : "400";
    "color" : " rgb(210, 210, 210)";
    main_font;
}

inlined hoverable_theme {
    "background-color" : transparent;
    "transition" : "background-color 0.15s ease";
    "onmouseenter" : "if(this.style.backgroundColor==='transparent')this.style.backgroundColor='rgba(0,0,0,0.04)'";
    "onmouseleave" : "if(this.style.backgroundColor==='rgba(0, 0, 0, 0.04)')this.style.backgroundColor='transparent'";
}
inlined skeleton_pulse {
    "background" : "linear-gradient(90deg, rgb(60,60,60) 25%, rgb(80,80,80) 50%, rgb(60,60,60) 75%)";
    "background-size" : "200% 100%";
    "animation" : "skeleton_pulse 1.5s infinite";
}


inlined post_text_theme {
    "white-space" : "pre-wrap";
    "color" : " rgb(238, 238, 238)";
    "margin" : "4 8 4 8px";
    "font-size" : "0.9rem";
    "font-weight" : "400";
    "line-height" : "1.5";
    main_font;
}

stateless template div section_header(string title) {
    div {
        "border" : "none";
        "background-color" : pine_color_L1;
        "border-radius" : "12px";
        "margin" : "8px";
        "width" : "100%";
        text title {
            "text-align" : "center"; 
            "margin" : "5px"; 
            "font-weight" : "900"; 
            "font-size" : "1.2rem"; 
            "color" : golden_color; 
            main_font;
        }
    }
}


stateless template div section_header_behaviour(string title, string behavior) {
    div {
        "border" : "none";
        "background-color" : pine_color_L1;
        "border-radius" : "12px";
        "margin" : "8px";
        "width" : "100%";
        "onclick" : behavior;
        "cursor" : "pointer";
        text title {
            "text-align" : "center"; 
            "margin" : "5px"; 
            "font-weight" : "900"; 
            "font-size" : "1.2rem"; 
            "color" : golden_color; 
            main_font;
        }
    }
}


stateless template div section_header_link(string title, string link_to) {
    div {
        "border" : "none";
        "background-color" : pine_color_L1;
        "border-radius" : "12px";
        "margin" : "8px";
        "width" : "100%";
        "cursor" : "pointer";
        "display" : "flex";
        "justify-content" : "center";
        link title {
            "href" : link_to;
            "margin" : "5px"; 
            "font-weight" : "900"; 
            "font-size" : "1.2rem"; 
            "color" : golden_color; 
            main_font;
        }
    }
}


stateless template div collapse_section(string label, string section, string behaviour_expand, string behaviour_hide) {
    button {
        "border" : "none";
        "background-color" : pine_color_L1;
        "border-radius" : "12px";
        "margin" : "8px";
        "cursor" : "pointer";
        text label {"margin" : "5px"; "font-weight" : "700"; "font-size" : "0.9rem"; "color" : golden_color; main_font;}
        string label_section = label.substr(0,label.length-2);
        "onclick" : "
            const el = getel("+js_lit(section)+");
            if(el.style.height === '0px') {
                el.style.height = el.scrollHeight + 'px';
                this.children[0].innerText = '"+label_section+" v';
                "+behaviour_expand+";
            } else {
                el.style.height = '0px';
                this.children[0].innerText = '"+label_section+" ^';
                "+behaviour_hide+";
            }
        ";
    }
}


div top_bar(string on_route) {
    div main_bar {
        "display" : "flex";
        "flex-direction" : "row";
        "align-items" : "center";
        "justify-content" : "space-between";
        "padding" : "16px 32px";
        "width" : "100%";
        "background-color" : pine_color;

        div {
            "display" : "flex";
            "flex-direction" : "row";
            "align-items" : "start";  
            "gap" : "12px"; 

            "cursor" : "pointer";
            "onclick" : "window.location.href='/'";     

            img {
                "width" : "80px";
                "height" : "80px";
                "object-fit" : "contain";
                "flex-shrink" : "0";
                "src" : "web/goldensystems/files/icon.png";
            }

            div {
                "display" : "flex";
                "flex-direction" : "column";
                text "Golden" {
                    "id" : "title_text";
                    "margin-bottom" : "0px";
                    "font-size" : "2.2rem";
                    "font-weight" : "700";
                    "color" : golden_color;
                    main_font;
                }
                text "Systems & Software" {
                    "font-size" : "1rem";
                    "color" : golden_color_D1;
                    "font-weight" : "500";
                    main_font;
                }
            }
        }

        div navlinks {
            "display" : "flex";
            "flex-direction" : "row";
            "gap" : "24px";
            "align-items" : "center";
            "overflow-y" : "hidden";
            "transition" : "height 0.6s ease";

            stateless template div nav_link(string label, string route) {
                link label {
                    "font-size" : "1rem";
                    "font-weight" : (on_route==route?"700":"500");
                    "color" : (on_route==route?golden_color_L1:golden_color_D1);
                    "cursor" : "pointer";
                    "text-decoration" : (on_route==route?"underline":"none");
                    "href" : route;
                    main_font;
                }
            }

            nav_link("blog","/blog");
            nav_link("GDSL","/GDSL");
            nav_link("about","/about");
            nav_link("contact","/contact");
        }

        button {
            "display" : "none";
            "border" : "none";
            "background-color" : pebble_color;
            "border-radius" : "12px";
            "width" : "20%";
            text "v" {"margin" : "5px"; "color" : golden_color_L1; main_font;}
            "onclick" : "
                const nav = this.parentElement.children[1];
                if(nav.style.height === '0px') {
                    nav.style.height = nav.scrollHeight + 'px';
                    this.children[0].innerText = '^';
                } else {
                    nav.style.height = '0px';
                    this.children[0].innerText = 'v';
                }
            ";
        }
    }
    script "
        function update_nav() {
            const bar = getel("+js_lit(capture_node(main_bar))+");
            if(window.innerWidth <= 980) {
                bar.style.flexDirection = 'column';
                bar.children[1].style.flexDirection = 'column';
                bar.children[1].style.height = '0px';
                bar.children[2].style.display = 'block';
            } else {
                bar.style.flexDirection = 'row';
                bar.children[1].style.flexDirection = 'row';
                bar.children[1].style.height = 'auto';
                bar.children[2].style.display = 'none';
            }
        }
        window.addEventListener('resize', update_nav);
        update_nav();
    ";
}



void standard_header {
    html '<meta name="viewport" content="width=device-width, initial-scale=1">';
    html "<link rel='icon' type='image/png' href='/web/goldensystems/files/favicon.png'>";
    style "
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        html { font-size: 17px; }
        @media (min-width: 560px) {
            html { font-size: 20px; }
        }
        @keyframes skeleton_pulse { 0% { background-position: 200% 0; } 100% { background-position: -200% 0; } }
    ";
    script read_file("web/webcorn.js");
}

