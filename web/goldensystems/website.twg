##

about {
    standard_header;
    top_bar("/about");
    div {
        "display" : "flex";
        "flex-direction" : "column";
        "justify-content" : "center";
        "align-items" : "center";
        "min-height" : "150vh";
        "background-color" : pebble_color_D2;
        div {
            "margin" : "16px";
            "padding" : "12px";
            "border-radius" : "8px";
            "background-color" : pebble_color;
            "display" : "flex";
            "flex-direction" : "column";
            "max-width" : "800px";
            "width" : "100%";
            "height" : "100%";

            section_header("About me");
            div {
                "display" : "flex";
                "width" : "100%";
                "justify-content" : "center";
                img {
                    "src" : project_path+"files/computer_mouse2.png";
                    "height" : "250px";
                    "width" : "300px";
                    "border-radius" : "8px";
                }
            }
            text "My name is Jackson, though I'm known online as FirTheMouse. I'm currently living in Lansing MI though I intend to move to Toronto once I have the means." {post_text_theme;}
            text "I'm a systems theorist, programmer, writer, amateur 3d modeler, and avid TTRPG player." {post_text_theme;}
            text "If you want to join a discord server where we're hosting games (DnD and Pathfinder) almost every night contact me on discord." {"onclick" : "goTo('/contact')"; "text-decoration" : "underline"; "cursor" : "pointer"; post_text_theme;}

            section_header("About us");
            text "Right now, Golden Systems isn't even a registered company, it's just me starting to get my name out there." {post_text_theme;}
            text "So there isn't much to say on that aspect, if you're looking at this website as a potential client you probably already know me, if not:" {post_text_theme;}
            text "  - I provide services to anyone who wants something made without dealing with a consulting company or AI slop." {post_text_theme;}
            text "  - I build all my own tools, and I work on passion projects. If you have a vision you haven't been able to realize, I can help. If you just want a quick buck then no." {post_text_theme;}
            text "  - I can also offer advice or help with your own projects, if you're having trouble with maintainability and extensibility." {post_text_theme;}
            text "  - I'm willing to do stuff for free if it's a worthwhile project." {post_text_theme;}

            section_header("About the work");
            text "I'm working on a tech stack called GDSL, currently it stretches from memory model to web programming, with a compiler, web server architecture, database, and probably some other things in between." {post_text_theme;}
            text "I have an experimental ISA/bytecode and machine architecture, and my next extension of the stack is likely to be into operating systems." {post_text_theme;}
            link "source" {"href" : "https://github.com/FirTheMouse/Webcorn.git"; "cursor" : "pointer"; post_text_theme;}
            link "Oh, and I made a game engine before this" {"href" : "https://github.com/FirTheMouse/Golden.git"; "cursor" : "pointer"; post_text_theme;}

            section_header("Collaborators not contributors");
            text "If my work interests you at all, reach out to me directly so we can talk. While the code is open source I don't want to have to maintain legibility for everyone or backward compatibility deeper than the surface." {post_text_theme;}
            text "I'm very open to working with others, just not as anonymous contributors." {post_text_theme;}
        }
        
    }
}


