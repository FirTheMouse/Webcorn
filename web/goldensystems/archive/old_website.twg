codelog {
    style "
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
    ";
    script read_file("web/webcorn.js");
    div {
        "display" : "flex";
        "width" : "100%";
        "min-height" : "400vh";
        "align-items" : "top";
        "justify-content" : "center";
        "flex-direction" : "column";
        background_theme;
        main_banner;

        div {
            "flex" : "1";
            "gap" : "1%";
            Ptr string logs = split_str(read_file("web/goldensystems/files/codelog.txt"),"\n");
            for(int i=0;i<logs.length;i++) {
                text logs.get(i) {
                    golden_color_theme;
                    "margin" : "20px";
                    text_one_theme;
                }
            }
        }

        bottom_banner;
    }
}