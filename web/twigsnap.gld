global int emit_js(string js) {
    string& src = ctx_source;
    if(src!=0) {if(src=="go") {} else { src.append("@"); }}
    src+=("RUN "+js);
}
global string emit_reload(Context c, Node n) {
    string& src = ctx_source;
    if(src.length!=0) {
        if(src=="go") {} else { src.append("@"); }
    }
    src+=("FRAG " + node_str_id(n) + " ");
    string oldsrc = src;
    src = "";
    htmlemit n;
    src = (oldsrc+src);
    return src;
}
"component" {
    on ".\"reload\"" {
        emit_reload(ctx.sub,ctx.node.left.scope_owner);
    }
}
global string emit_full_page_reload(Context c){
    c.source = "RELOAD";
    return ctx.source;
}
global void return_emitted() {
    ctx.source = "@RETURN "+recover_emitted;
}

"inlined" {
    on ".\"emit\"" string {
        local_subemit("",true,"","");
        string s = ctx.node.value.getStr;
        ctx.node.value.getStr = s.slice(9,s.length-3);
    }
}
"component" { //Expand on later if it proves useful
    on ".\"emit\"" string {
        local_subemit("",true,"","");
        string s = ctx.node.value.getStr;
        ctx.node.value.getStr = s.slice(2,s.length-2);
    }
}