"component" {
    in htmlemiting {
        if(ctx.node.name=="div") {
            subemit("div",false,"","");
        } else if(ctx.node.name=="textarea") {
            subemit("textarea",false,"","");
        } else {
            if(ctx.node.name.starts("textarea__")) {
                subemit("textarea",false,"id=\""+capture_node(ctx.node)+"\" data-ptr=\""+capture_ptr(ctx.node)+"\"","");
            } else {
                subemit("div",false,"id=\""+capture_node(ctx.node)+"\" data-ptr=\""+capture_ptr(ctx.node)+"\"","");
            }
        }
    }
}
"prefix_component" {
    in htmlemiting {
        //log("Prefix component");
        if(ctx.node.type==(#FUNC_CALL)) {
            paranoid_qual_kill(ctx); //Revoke it. Dealing with inner quals and their routing is a minefield!
        } else if(ctx.node.type==(#FUNC_DECL)&&!(ctx.node.has_qual(#template))) {
            if(ctx.node.children.length==0) { //Implcit case, for when a div is paramatrized and named but not qualifed as a template, don't emit it!
                paranoid_qual_kill(ctx);
                htmlemit(ctx.node,#component);
            }
        }
    }
    in executing {
        //log("Prefix component");
        if(ctx.node.type==(#FUNC_CALL)) {
            paranoid_qual_kill(ctx); //Revoke it. Dealing with inner quals and their routing is a minefield!
        } else if(ctx.node.type==(#FUNC_DECL)&&!(ctx.node.has_qual(#template))) {
            if(ctx.node.children.length==0) { //Implcit case, for when a div is paramatrized and named but not qualifed as a template, don't emit it!
                paranoid_qual_kill(ctx);
                htmlemit(ctx.node,#component);
            }
        }
    }
}


global string request_path = "";
global string request_arg = "";
global Object params = deadptr;
global Node page = deadnode;
newstage routing;
register route;

global Node route_search(Node n) {
    Node to_return = deadnode;
    int first_slash = request_path.find("/");
    if(first_slash>=0) {
        request_path = request_path.substr(first_slash+1);
        int next_slash = request_path.find("/");
        string looking_for = request_path;
        if(next_slash>=0) {
            looking_for = request_path.slice(0,next_slash);
        }
        n.children.do(child => {
            if(labels(child.type)=="route") {
                if(child.name==looking_for) {
                    to_return = child;
                    break;
                }
            }
        });
    } 
    return to_return;
}

"route" {
    in naming {
        ctx.node.name = ctx.result.get(ctx.index+1).name;
        ctx.node.children.push(ctx.result.take(ctx.index+1));
    }
    in htmlemiting {
        if(page==(ctx.node)) {
            subemit("body",false,"","");
        } 
    }
    in routing {
        if(request_path.length>0) {
            Node to_execute = route_search(ctx.node.scopes.get(0));
            if(is_live(to_execute)) {
                rout(to_execute);
            } else {
                if(request_path==ctx.node.name) {
                    page = ctx.node;
                } else {
                    page = deadnode;
                }
            }
        }
    }
}

register text;
"text" {
