
##
    register root_path;
    "root_path" {
        in htmlemiting {
            subemit("div",false,"","");
        }
    }
##

root_path {
    script read_file("web/webcorn.js");
    static string thing_color = "gray";
    div thing_holder {
        "background-color" : thing_color;
        "width" : "80px";
        text "Hello";
        "onclick" : capture(

        ) {
            if(thing_color=="gray") {
                thing_color = "red";
            } else {
                thing_color = "gray";
            }
            thing_holder.reload();
            emit_js("
                setTimeout(() => {
                    getel('"+capture_node(thing_holder)+"').style.backgroundColor = 'blue';
                }, 200);
            ");
        }
    }
}
