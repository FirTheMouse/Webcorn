
##
    register root_path;
    "root_path" {
        in htmlemiting {
            subemit("div",false,"","");
        }
    }
##


root_path {
    script read_file("web/webcorn.js");
    div thing_holder {
        "background-color" : "gray";
        "width" : "80px";
        for(int i=0;i<100;i++) {
            div {
                "background-color" : (i==0?"blue":"red");
                "width" : "40px";
                "height" : "40px";
                "class" : "thing";
                "onclick" : "
                    event.stopPropagation();
                    const root = this.parentElement;
                    Array.from(root.children).forEach(child => {
                        child.style.backgroundColor = 'red';
                    });
                    this.style.backgroundColor = 'blue';
                ";
            }
        }
        "onclick" : "
            Array.from(this.children).forEach(child => {
                child.style.backgroundColor = 'red';
            });
        ";
    }
    DEBUG_ROOT_X_VERBOSE;
}