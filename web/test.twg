##
    register root_path;
    "root_path" {
        in htmlemiting {
            emit_contents;
        }
    }
##


include web/partsbin.twg;

root_path {
    script read_file("web/webcorn.js");
    div {
        "display" : "flex";
        "flex-direction" : "row";
        button {
            text "RESET";
            "onclick" : "resetWebrunner();";
        }
            button {
            text "DUMP";
            "onclick" : capture{dump_unit(true);};
        }
    }

    static bool is_open;
    string popupid;
    div display_pane {
        popupid = node_str_id(call_owner(display_pane));
        "display" : (is_open?"flex":"none");
        popup_panel(
            capture(
                js_do("event.stopPropagation();"+js_close(popupid))
            ) {
                is_open = false;
            },[&]{
                div {
                    button {
                        text "PUSH";
                        "onclick" : capture{print("Pushed");}
                    }
                    button {
                        text "CLOSE";
                        "onclick" : capture(
                            js_do("event.stopPropagation();"+js_close(popupid))   
                        ){
                            is_open = false;
                        }
                    }
                }   
        });
    }
    button {
        text "OPEN";
        "onclick" : capture(
            js_do("event.stopPropagation();"+js_open(popupid))   
        ){
            is_open = true;
        }
    }
}
